        // ---------- REALISTIC TRAIN LOADER PROGRESS TICKER ----------
        function startTrainBookingLoader() {
            let progress = 10;
            const bar = document.getElementById("trainProgressBar");
            const statusText = document.getElementById("trainLoaderStatusText");
            const subText = document.getElementById("trainStepSubtext");
            const elapsedBadge = document.getElementById("trainElapsedSec");

            const stages = [
                { threshold: 18, title: "Authenticating OTP & Securing Payment...", sub: '<i class="fas fa-lock"></i> Bank transaction authorization in progress...' },
                { threshold: 42, title: "Connecting to Indian Railways PRS Engine...", sub: '<i class="fas fa-train"></i> Locking berths and verifying quota availability...' },
                { threshold: 68, title: "Allocating Coach & Berth Numbers...", sub: '<i class="fas fa-ticket-alt"></i> Assigning confirmed berths from train chart...' },
                { threshold: 88, title: "Generating Official IRCTC E-Ticket & PNR...", sub: '<i class="fas fa-file-invoice"></i> Finalizing reservation certificate & PDF...' },
                { threshold: 96, title: "Reservation Confirmed! Redirecting to Ticket...", sub: '<i class="fas fa-check-circle text-success"></i> Preparing ticket summary and preview...' }
            ];

            let stageIdx = 0;
            const startTime = Date.now();

            setInterval(function () {
                const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
                if (elapsedBadge) {
                    elapsedBadge.innerText = elapsed + "s";
                }

                if (progress < 95) {
                    progress += (progress < 50 ? 3.2 : (progress < 80 ? 1.8 : 0.8));
                    if (bar) bar.style.width = Math.min(progress, 96) + "%";
                }

                if (stageIdx < stages.length && progress >= stages[stageIdx].threshold) {
                    if (statusText) {
                        $(statusText).fadeOut(120, function () {
                            $(this).html(stages[stageIdx].title).fadeIn(120);
                        });
                    }
                    if (subText) {
                        subText.innerHTML = stages[stageIdx].sub;
                    }
                    stageIdx++;
                }
            }, 180);
        }

