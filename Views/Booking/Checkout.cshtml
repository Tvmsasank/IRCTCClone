    function buildPassengerReview() {
        let html = '';
        let summaryPassengerHtml = '';

        $(".passenger-row-item").each(function(index){
            let name = $(this).find("input[name='passengerNames']").val() || "";
            let age = $(this).find("input[name='passengerAges']").val() || "";
            let gender = $(this).find("select[name='passengerGenders']").val() || "";
            let country = $(this).find("select[name='passengerCountries']").val() || 'India';
            let berth = $(this).find("select[name='passengerBerths']").val() || "";

            let genderText = '';
            if (gender === "M") genderText = "Male";
            else if (gender === "F") genderText = "Female";
            else if (gender === "O") genderText = "Other";
            else genderText = "Not Specified";

            let berthText = berth || 'No Preference';
            if (berthText === "LB") berthText = "Lower";
            else if (berthText === "MB") berthText = "Middle";
            else if (berthText === "UB") berthText = "Upper";
            else if (berthText === "SL") berthText = "Side Lower";
            else if (berthText === "SU") berthText = "Side Upper";
            else if (berthText === "WS") berthText = "Window Side";
            else if (berthText === "AS") berthText = "Aisle";

            let safeName = name.trim() ? name.trim().toUpperCase() : `PASSENGER ${index + 1}`;
            let safeAge = age ? `${age} yrs` : `-- yrs`;

            let cateringPill = '';
            let cateringSummaryText = '';
            if (isVandeTrain) {
                let isOptedOut = $("#noBeveragesCheckbox").is(":checked");
                let mealVal = $(this).find("select[name='passengerCatering']").val() || "Veg";
                let mealChoice = isOptedOut ? "No Food/Beverages" : mealVal;
                cateringPill = `<span class="meta-pill meal-pill" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;"><i class="fa-solid fa-utensils"></i> ${mealChoice}</span>`;
                cateringSummaryText = ` • <span class="sp-meal" style="color: #047857; font-weight: 600;"><i class="fa-solid fa-utensils"></i> ${mealChoice}</span>`;
            }

            // Step 2 Confirmed Passenger Row (Number & Name side-by-side)
            html += `
            <div class="review-passenger-row">
                <div class="review-passenger-left">
                    <span class="review-passenger-num">${index + 1}</span>
                    <strong class="review-passenger-name">${safeName}</strong>
                </div>
                <div class="review-passenger-meta">
                    <span class="meta-pill"><i class="fa-regular fa-user"></i> ${safeAge}</span>
                    <span class="meta-pill">${genderText}</span>
                    <span class="meta-pill">${country}</span>
                    <span class="meta-pill berth-pill"><i class="fa-solid fa-couch"></i> ${berthText}</span>
                    ${cateringPill}
                </div>
            </div>
            `;

            // Step 3 Journey Summary Passenger Row
            summaryPassengerHtml += `
            <div class="summary-passenger-item">
                <div class="sp-left">
                    <span class="sp-num">${index + 1}</span>
                    <strong class="sp-name">${safeName}</strong>
                </div>
                <div class="sp-meta">
                    <span>${safeAge}</span> • <span>${genderText}</span> • <span class="sp-berth">${berthText}</span>${cateringSummaryText}
                </div>
            </div>
            `;
        });

        if (html !== '') {
            $("#reviewPassengerContainer").html(html);
            $("#reviewPassengerContainer .review-passenger-row:last").css("border-bottom", "none");
            $("#journeySummaryPassengerContainer").html(summaryPassengerHtml);
        } else {
            $("#reviewPassengerContainer").html('<div style="padding: 10px 0; color: #64748b;">No passengers added.</div>');
            $("#journeySummaryPassengerContainer").html('<div style="padding: 10px 0; color: #64748b;">No passengers added.</div>');
        }

        let summaryBoarding = $("#selectedBoardingStation").text() + " (" + $("#selectedBoardingDeparture").text() + ")";
        $("#journeySummaryBoardingText").html('<div class="boarding-badge-line"><i class="fa-solid fa-location-dot"></i> <span>Boarding Point</span></div><div class="boarding-station-name">' + summaryBoarding + '</div>');
    }

    function calculateDuration(startTime, endTime) {
        const start = startTime.split(":");
        const end = endTime.split(":");

        let startMinutes = parseInt(start[0]) * 60 + parseInt(start[1]);
        let endMinutes = parseInt(end[0]) * 60 + parseInt(end[1]);

        if (endMinutes < startMinutes) {
            endMinutes += 24 * 60;
        }

        let diff = endMinutes - startMinutes;
        let hrs = Math.floor(diff / 60);
        let mins = diff % 60;

        return `${String(hrs).padStart(2,'0')}:${String(mins).padStart(2,'0')}`;
    }

    function updateSeatStatusColor(status) {
        if (!status) return;

        let statusUpper = status.toUpperCase();
        let bg = "";
        let color = "#ffffff";
        let icon = '<i class="fa-solid fa-circle-check"></i> ';

        // AVAILABLE
        if (statusUpper.includes("AVAILABLE") || statusUpper.includes("AVBL")) {
            bg = "linear-gradient(135deg, #16a34a 0%, #15803d 100%)";
            icon = '<i class="fa-solid fa-circle-check"></i> ';
        }
        // RAC
        else if (statusUpper.includes("RAC")) {
            bg = "linear-gradient(135deg, #ea580c 0%, #c2410c 100%)";
            icon = '<i class="fa-solid fa-arrows-split-up-and-left"></i> ';
        }
        // WL
        else if (statusUpper.includes("WL") || statusUpper.includes("WAIT")) {
            bg = "linear-gradient(135deg, #dc2626 0%, #b91c1c 100%)";
            icon = '<i class="fa-solid fa-clock"></i> ';
        }
        // CNF
        else if (statusUpper.includes("CNF") || statusUpper.includes("CONFIRMED")) {
            bg = "linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%)";
            icon = '<i class="fa-solid fa-circle-check"></i> ';
        }
        else {
            bg = "#64748b";
            icon = '<i class="fa-solid fa-ticket"></i> ';
        }

        let badge = $("#liveSeatStatus");
        let badgeTop = $("#liveSeatStatusTop");
        let badgeStep1 = $("#liveSeatStatusStep1");

        badge.html(icon + statusUpper).css({
            background: bg,
            color: color,
            display: 'inline-flex'
        });
        badgeTop.html(icon + statusUpper).css({
            background: bg,
            color: color,
            display: 'inline-flex'
        });
        badgeStep1.html(icon + statusUpper).css({
            background: bg,
            color: color,
            display: 'inline-flex'
        });

        let isRacOrWl = statusUpper.includes("RAC") || statusUpper.includes("WL") || statusUpper.includes("WAIT");
        if (isRacOrWl) {
            $("#bookOnlyIfConfirmWrap").hide();
            $("#reservationChoiceRow").hide();
        } else {
            $("#bookOnlyIfConfirmWrap").show();
            $("#reservationChoiceRow").show();
        }
    }

    });

    function refreshCaptcha() {

        const img =
            document.getElementById("captchaImg");

        img.style.opacity = "0.4";

        img.src =
            "/captcha?ts=" + new Date().getTime();

        img.onload = () => {

            img.style.opacity = "1";

        };
    }

