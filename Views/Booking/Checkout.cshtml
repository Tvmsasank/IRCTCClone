@model IRCTCClone.Models.Booking
@using IRCTCClone.E_D

@{
    ViewData["Title"] = "Booking Details";
}

@{
    var classCode = ViewBag.Class?.Code ?? "";
}

@{
    int currentStep = ViewBag.CurrentStep ?? 1;
}

@{
    var train = ViewBag.Train as IRCTCClone.Models.Train;
    var cls = ViewBag.Class as IRCTCClone.Models.TrainClass;
    var journey = ViewBag.JourneyDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var parsedJourneyDate = DateTime.TryParse(journey, out var pjd) ? pjd : DateTime.Today;
    var frmst = ViewBag.FromStation;
    var tost = ViewBag.ToStation;
    var FromStation1 = ViewBag.FromStation1;
    var ToStation1 = ViewBag.ToStation1;
    var Departure = ViewBag.Departure;
    var Arrival = ViewBag.Arrival;
    var Duration = ViewBag.Duration;
    var Quota = ViewBag.Quota;
    var departureDay = ViewBag.DepartureDay is int depDay ? depDay : 1;
    var arrivalDay = ViewBag.ArrivalDay is int arrDay ? arrDay : 1;
    var departureDate = parsedJourneyDate.AddDays(departureDay - 1);
    var arrivalDate = parsedJourneyDate.AddDays(arrivalDay - 1);
    string trainNameNorm = (train?.Name ?? "").Replace(" ", "").Replace("-", "").ToUpperInvariant();
    bool isVandeBharat = trainNameNorm.Contains("VANDEBHARAT") || trainNameNorm.Contains("VANDE");

    // Retrieve user email and mobile number dynamically
    var userEmail = ViewBag.UserEmail as string;
    if (string.IsNullOrEmpty(userEmail))
    {
        userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
                    ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value 
                    ?? "";
    }

    string maskedEmail = "";
    if (!string.IsNullOrEmpty(userEmail) && userEmail.Contains((char)64))
    {
        var parts = userEmail.Split((char)64);
        var name = parts[0];
        var domain = parts[1];
        if (name.Length <= 2)
        {
            maskedEmail = name + "***@" + domain;
        }
        else
        {
            maskedEmail = name.Substring(0, 2) + new string('*', Math.Min(6, name.Length - 2)) + (name.Length > 4 ? name.Substring(name.Length - 2) : "") + "@" + domain;
        }
    }
    else
    {
        maskedEmail = userEmail;
    }

    var username = ViewBag.UserDbUsername as string ?? User.Identity?.Name ?? (!string.IsNullOrEmpty(userEmail) && userEmail.Contains("@") ? userEmail.Split('@')[0] : userEmail);
    string mobileNumber = ViewBag.UserMobile as string ?? "";
    string maskedMobile = "";
    if (!string.IsNullOrEmpty(mobileNumber) && mobileNumber.Length >= 6)
    {
        maskedMobile = "******" + mobileNumber.Substring(mobileNumber.Length - 4);
    }
    else if (!string.IsNullOrEmpty(mobileNumber) && mobileNumber.Length > 2)
    {
        maskedMobile = "***" + mobileNumber.Substring(mobileNumber.Length - 2);
    }
    else
    {
        maskedMobile = mobileNumber;
    }
}

<div class="checkout-wrapper">

    <!-- TOP EXECUTIVE STEPPER -->
    <div class="booking-steps">
        <!-- STEP 1 -->
        <div class="step-item @(currentStep >= 1 ? "active" : "")" id="stepIndicator1">
            <div class="step-circle">
                @if (currentStep > 1)
                {
                    <i class="fa-solid fa-check"></i>
                }
                else
                {
                    <span>1</span>
                }
            </div>
            <div class="step-label-group">
                <span class="step-label">Passenger Details</span>
                <span class="step-sublabel">Add Travelers</span>
            </div>
        </div>

        <div class="step-line @(currentStep >= 2 ? "completed" : "")" id="stepLine1"></div>

        <!-- STEP 2 -->
        <div class="step-item @(currentStep >= 2 ? "active" : "")" id="stepIndicator2">
            <div class="step-circle">
                @if (currentStep > 3)
                {
                    <i class="fa-solid fa-check"></i>
                }
                else
                {
                    <span>2</span>
                }
            </div>
            <div class="step-label-group">
                <span class="step-label">Review Journey</span>
                <span class="step-sublabel">Verify Details</span>
            </div>
        </div>

        <div class="step-line @(currentStep >= 3 ? "completed" : "")" id="stepLine2"></div>

        <!-- STEP 3 -->
        <div class="step-item @(currentStep >= 3 ? "active" : "")" id="stepIndicator3">
            <div class="step-circle">
                <span>3</span>
            </div>
            <div class="step-label-group">
                <span class="step-label">Payment</span>
                <span class="step-sublabel">Secure Gateway</span>
            </div>
        </div>
    </div>

    <!-- MAIN BOOKING LAYOUT -->
    <div class="booking-layout">

        <!-- LEFT PRIMARY WORKSPACE -->
        <div class="booking-left">

            <form method="post"
                  action="/Booking/Confirm"
                  class="checkout-form">

                <input type="hidden" name="edata" value="@ViewBag.EncryptedData" />
                <input type="hidden" name="trainId" value="@train.Id" />
                <input type="hidden" name="classId" value="@cls.Id" />
                <input type="hidden" name="journeyDate" value="@journey" />
                <input type="hidden" name="trainName" value="@train.Name" />
                <input type="hidden" name="trainNumber" value="@train.Number" />
                <input type="hidden" name="Class" value="@cls.Code" />
                <input type="hidden" name="quota" value="@ViewBag.Quota" />
                <input type="hidden" name="FromStationId" value="@ViewBag.FromStationId" />
                <input type="hidden" name="ToStationId" value="@ViewBag.ToStationId" />
                <input type="hidden" name="SeatStatuscount" value="@ViewBag.SeatStatusCount" />
                <input type="hidden" name="BookingStatus" value="@ViewBag.BookingStatus" />
                <input type="hidden" name="boardingStation" id="boardingStationInput" value="@FromStation1" />
                <input type="hidden" id="boardingDepartureInput" name="boardingDeparture" value="@Departure" />
                <input type="hidden" id="boardingDayInput" name="boardingDay" value="@departureDay" />

                <!-- ==============================================
                     STEP 1: PASSENGER DETAILS WORKSPACE
                     ============================================== -->
                <div id="step1Container">

                    <!-- SMART ADVISORY BANNER -->
                    <div class="modern-advisory-banner">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>Senior citizen concession is currently discontinued. Differently-abled passengers may verify post-entry details during ticket validation.</span>
                    </div>

                    <!-- EXECUTIVE TRAIN TRANSIT HERO CARD -->
                    <div class="executive-train-card">
                        <div class="train-card-topbar">
                            <div class="train-hero-brand">
                                <span class="train-type-pill"><i class="fa-solid fa-train"></i> SUPERFAST</span>
                                <h3 class="train-hero-title">@train.Name (@train.Number)</h3>
                            </div>
                            <div class="train-topbar-actions">
                                <span class="hero-class-badge">@cls.Code • @ViewBag.Quota</span>
                                <button type="button"
                                        class="btn-executive-schedule checkout-route-link"
                                        data-train-id="@train.Id"
                                        data-train-name="@train.Name"
                                        data-train-number="@train.Number"
                                        data-from="@FromStation1"
                                        data-to="@ToStation1"
                                        title="View Train Schedule Timetable">
                                    <i class="fa-regular fa-clock"></i>
                                    <span>Train Schedule</span>
                                </button>
                                    @*<span class="live-seat-status" id="liveSeatStatusStep1">@ViewBag.SeatStatus</span>*@
                            </div>
                        </div>

                        <!-- TIMELINE ROUTE VISUALIZATION -->
                        <div class="route-timeline-strip">
                            <div class="timeline-station timeline-origin">
                                <span class="timeline-time">@Departure</span>
                                <span class="timeline-name">@FromStation1</span>
                                <span class="timeline-date">@departureDate.ToString("ddd, dd MMM yyyy")</span>
                            </div>

                            <div class="timeline-transit-center">
                                <span class="transit-duration-pill">@Duration</span>
                                <div class="transit-track-line">
                                    <span class="track-dot origin-dot"></span>
                                    <span class="track-line-body"></span>
                                    <i class="fa-solid fa-chevron-right track-arrow"></i>
                                    <span class="track-dot dest-dot"></span>
                                </div>
                                @*<span class="transit-route-type">Direct Non-Stop Service</span>*@
                            </div>

                            <div class="timeline-station timeline-dest">
                                <span class="timeline-time">@Arrival</span>
                                <span class="timeline-name">@ToStation1</span>
                                <span class="timeline-date">@arrivalDate.ToString("ddd, dd MMM yyyy")</span>
                            </div>
                        </div>

                        <!-- BOARDING STATION SELECTOR -->
                        <div class="boarding-selector-card">
                            <div class="boarding-label-row">
                                <span class="boarding-tag"><i class="fa-solid fa-location-dot"></i> BOARDING POINT</span>
                                <span class="boarding-subtag">Select your train boarding station</span>
                            </div>

                            <button type="button" class="boarding-selector-dropdown-btn" id="toggleBoardingStations">
                                <div class="boarding-current-info">
                                    <strong id="selectedBoardingStation">@FromStation1</strong>
                                    <span class="boarding-divider">|</span>
                                    <span id="selectedBoardingDeparture">Departure: @Departure</span>
                                    <span class="boarding-divider">|</span>
                                    <span id="selectedBoardingDay">Day: @departureDay</span>
                                    <span class="boarding-divider">|</span>
                                    <span>Date: @departureDate.ToString("dd MMM yyyy")</span>
                                </div>
                                <i class="fa-solid fa-chevron-down boarding-chevron"></i>
                            </button>

                            <!-- DROPDOWN STOPS LIST -->
                            <div class="boarding-station-list" id="boardingStationList" style="display:none;">
                                <div class="boarding-list-header">Eligible Boarding Points for this Journey</div>
                                @foreach (var stop in ViewBag.RouteStops)
                                {
                                    <div class="boarding-station-item"
                                         data-station="@stop.StationName"
                                         data-departure="@stop.DepartureTime"
                                         data-day="@stop.DayNumber"
                                         data-arrival="@stop.ArrivalTime"
                                         data-stopno="@stop.StopNumber">
                                        <div class="boarding-item-details">
                                            <div class="boarding-item-name">@stop.StopNumber. @stop.StationName</div>
                                            <div class="boarding-item-time">
                                                Arrival: @stop.ArrivalTime • Dep: @stop.DepartureTime • Day @stop.DayNumber • @stop.Distance km
                                            </div>
                                        </div>
                                        <div class="boarding-select-radio"></div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Read-only boarding summary for Step 2 -->
                        <div class="irctc-boarding-summary-row" id="irctcBoardingSummaryRow" style="display: none;">
                            <div id="dynamicReviewBoardingTop" class="review-boarding-text">
                                1 Adult | @cls.Code | @ViewBag.Quota | Boarding at @FromStation1 | Boarding Date: @departureDate.ToString("dd MMM yyyy") @Departure
                            </div>
                            <div class="review-boarding-subtext">
                                Verified reservation details as per Indian Railways PRS
                            </div>
                        </div>
                    </div>

                    <!-- PASSENGERS SECTION CARD -->
                    <div class="modern-card passenger-container-card">
                        <div class="card-section-header">
                            <div>
                                <h2 class="card-section-title"><i class="fa-solid fa-users"></i> Passenger Details</h2>
                                <p class="card-section-subtitle">Please enter traveler details matching their Government-issued Photo ID card</p>
                            </div>
                            <span class="badge-max-limit">Max 6 Passengers</span>
                        </div>

                        @if (isVandeBharat)
                        {
                            <div class="vande-catering-promo-banner" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border: 1px solid #6ee7b7; border-radius: 8px; padding: 10px 16px; margin: 12px 0 16px; display: flex; align-items: center; gap: 10px; color: #065f46; font-size: 13px; font-weight: 600; animation: vandePulse 2s infinite;">
                                <i class="fa-solid fa-utensils text-success fs-5"></i>
                                <span>Enhance Your Travel with Taste! Opt for Onboard Catering for a Delicious Dining Experience!</span>
                            </div>
                        }

                        <!-- PASSENGERS LIST WRAPPER -->
                        <div id="passengers" class="passengers-list">
                            <div class="passenger-row-item">
                                <div class="passenger-item-header">
                                    <span class="passenger-num-pill"><i class="fa-solid fa-user"></i> Passenger #1</span>
                                    <button type="button" class="remove-passenger-btn" title="Remove Passenger">✕ Remove</button>
                                </div>
                                <div class="passenger-fields-grid @(isVandeBharat ? "vande-passenger-grid" : "")">
                                    <div class="field-name">
                                        <input name="passengerNames" type="text" placeholder="Full name as per Govt. ID" class="passenger-field p-name" required />
                                    </div>
                                    <div class="field-age">
                                        <input name="passengerAges" type="number" placeholder="Age" min="1" max="120" class="passenger-field p-age" required />
                                    </div>
                                    <div class="field-gender">
                                        <select name="passengerGenders" class="passenger-field p-gender" required>
                                            <option value="">Gender</option>
                                            <option value="M">Male</option>
                                            <option value="F">Female</option>
                                            <option value="O">Transgender</option>
                                        </select>
                                    </div>
                                    <div class="field-country">
                                        <select name="passengerCountries" class="passenger-field p-country">
                                            <option value="India">India</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="field-berth">
                                        <select name="passengerBerths" class="passenger-field p-berth">
                                            @{
                                                var classCode = ViewBag.Class?.Code ?? "";
                                                if (isVandeBharat)
                                                {
                                                    <option value="">No Preference</option>
                                                    <option value="WS">Window Side</option>
                                                }
                                                else if (classCode.Contains("(2S)") || classCode.Contains("(CC)") || classCode.Contains("(EC)"))
                                                {
                                                    <option value="">No Preference</option>
                                                    <option value="WS">Window Side</option>
                                                    <option value="AS">Aisle</option>
                                                }
                                                else
                                                {
                                                    <option value="">No Preference</option>
                                                    <option value="LB">Lower Berth</option>
                                                    <option value="MB">Middle Berth</option>
                                                    <option value="UB">Upper Berth</option>
                                                    <option value="SL">Side Lower</option>
                                                    <option value="SU">Side Upper</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    @if (isVandeBharat)
                                    {
                                        <div class="field-catering">
                                            <select name="passengerCatering" class="passenger-field p-catering">
                                                <option value="">Catering Service Option*</option>
                                                <option value="Veg">Veg</option>
                                                <option value="Non Veg">Non Veg</option>
                                                <option value="Jain Meal">Jain Meal</option>
                                                <option value="Veg (Diabetic)">Veg (Diabetic)</option>
                                                <option value="Non Veg (Diabetic)">Non Veg (Diabetic)</option>
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- ADD PASSENGER BUTTONS -->
                        <div class="add-passengers-toolbar">
                            <button type="button" id="addPassenger" class="btn-action-pill btn-primary-add">
                                <i class="fa-solid fa-plus"></i> Add Passenger / Infant With Berth
                            </button>
                            <button type="button" class="btn-action-pill btn-secondary-add" onclick="showToast('Add Infant Without Berth option selected', 'info')">
                                <i class="fa-solid fa-plus"></i> Add Infant (Without Berth)
                            </button>
                        </div>

                        @if (isVandeBharat)
                        {
                            <div class="vande-beverage-optout-wrapper" style="margin: 14px 0 6px; padding: 12px 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; display: flex; align-items: center;">
                                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; font-weight: 600; color: #1e293b; margin: 0;">
                                    <input type="checkbox" id="noBeveragesCheckbox" name="optOutMeals" value="true" style="width: 18px; height: 18px; cursor: pointer; accent-color: #1f3c88;" />
                                    <span>I don't want food/beverages</span>
                                </label>
                            </div>
                        }

                        <div class="infant-notice-box">
                            <span>* Children under 5 years of age travel free without a separate berth. (No reservation ticket is required for infants without a berth.)</span>
                        </div>
                    </div>

                    <!-- CONTACT & TICKET DELIVERY CARD -->
                    <div class="modern-card contact-delivery-card">
                        <div class="card-section-header" style="margin-bottom: 6px;">
                            <div>
                                <h2 class="card-section-title"><i class="fa-solid fa-envelope-open-text"></i> Contact & Ticket Delivery</h2>
                                <p class="card-section-subtitle contact-delivery-subtitle" style="font-size: 13px; color: #475569; margin-top: 4px; line-height: 1.4;">
                                    Ticket details will be sent to email- <strong style="color: #0f2954; font-weight: 700;">@maskedEmail</strong> and registered mobile number- <strong style="color: #0f2954; font-weight: 700;">@(string.IsNullOrEmpty(maskedMobile) ? "Not registered" : "+91 " + maskedMobile)</strong>
                                </p>
                            </div>
                        </div>

                        <div class="contact-delivery-box" style="margin-top: 8px;">
                            <div class="modern-mobile-input-group" style="max-width: 300px;">
                                <span class="country-tag">🇮🇳 +91</span>
                                <input type="tel"
                                       id="contactMobileInput"
                                       class="mobile-field modern-tel-input"
                                       value=""
                                       maxlength="10"
                                       placeholder="Enter 10-digit mobile number"
                                       autocomplete="tel" />
                            </div>
                            <span class="mobile-helper-text" style="display: block; margin-top: 4px; font-size: 11px; color: #64748b;">Enter mobile number to receive SMS & WhatsApp alerts.</span>
                        </div>

                        <!-- OPTIONAL GST ACCORDION -->
                        <div class="gst-expansion-row" style="margin-top: 10px;">
                            <button type="button" class="gst-toggle-btn" onclick="toggleGstInput()">
                                <i class="fa-solid fa-building"></i> Add GST Details for Corporate Invoice (Optional)
                            </button>
                            <div id="gstInputBox" style="display: none; margin-top: 8px;">
                                <input type="text" class="passenger-field gst-field" placeholder="GST Identification Number (GSTIN)" maxlength="15" />
                            </div>
                        </div>
                    </div>

                    <!-- OTHER PREFERENCES CARD (MATCHING IRCTC EXACT SPECIFICATION) -->
                    <div class="modern-card other-preferences-card" id="otherPreferencesCard">
                        <div class="card-section-header" style="border-bottom: 1px solid #e2e8f0; padding-bottom: 10px; margin-bottom: 16px;">
                            <div>
                                <h2 class="card-section-title" style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0;">
                                    <i class="fa-solid fa-sliders me-2 text-primary"></i> Other Preferences
                                </h2>
                            </div>
                        </div>

                        <div class="other-preferences-content">
                            <!-- Preference Checkboxes Row -->
                            <div class="pref-checkboxes-grid" style="display: flex; flex-wrap: wrap; gap: 24px; margin-bottom: 18px;">
                                <label id="autoUpgradationWrap" style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; color: #334155; margin: 0;">
                                    <input type="checkbox" id="autoUpgradationCheck" name="autoUpgradation" value="true" style="width: 17px; height: 17px; accent-color: #1f3c88;" />
                                    <span>Consider for Auto Upgradation (In higher class you may or may not get lower berth)</span>
                                </label>

                                <label id="bookOnlyIfConfirmWrap" style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; color: #334155; margin: 0;">
                                    <input type="checkbox" id="bookOnlyConfirmCheck" name="bookOnlyIfConfirm" value="true" style="width: 17px; height: 17px; accent-color: #1f3c88;" />
                                    <span>Book only if confirm berths are allotted.</span>
                                </label>
                            </div>

                            <!-- Reservation Choice & Preferred Coach Row -->
                            <div class="pref-inputs-row" id="reservationChoiceRow" style="display: flex; flex-direction: column; gap: 14px; max-width: 450px; margin-bottom: 20px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <select id="reservationChoiceSelect" name="reservationChoice" class="passenger-field" style="flex: 1; padding: 8px 12px; font-size: 13.5px; border-radius: 6px; border: 1px solid #cbd5e1; background: #ffffff;">
                                        <option value="">Reservation Choice</option>
                                        <option value="1LB">Book, only if at least 1 lower berth is allotted</option>
                                    </select>
                                    <i class="fa-solid fa-circle-info text-success" title="Rules for reservation allotment condition" style="cursor: pointer; font-size: 15px;"></i>
                                </div>

                                <div>
                                    <input type="text" id="preferredCoachInput" name="preferredCoach" placeholder="Preferred Coach No." maxlength="5" class="passenger-field" style="width: 100%; padding: 8px 12px; font-size: 13.5px; border-radius: 6px; border: 1px solid #cbd5e1; text-transform: uppercase;" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 1 NAVIGATION BUTTONS -->
                    <div class="step-navigation-actions">
                        <button type="button" id="backToResultsBtn" class="btn-step-nav btn-step-back">
                            <i class="fa-solid fa-arrow-left"></i> Back to Search
                        </button>
                        <button type="button" id="nextToReviewBtn" class="btn-step-nav btn-step-next">
                            Proceed to Review Journey <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>

                </div>

                <!-- ==============================================
                     STEP 2: REVIEW JOURNEY WORKSPACE
                     ============================================== -->
                <div class="modern-card review-journey-card"
                     id="reviewSection"
                     style="display:none;">

                    <div class="card-section-header">
                        <div>
                            <h2 class="card-section-title"><i class="fa-solid fa-clipboard-check"></i> Review Journey & Travelers</h2>
                            <p class="card-section-subtitle">Please double check traveler names, ages, and seat preferences before proceeding to payment</p>
                        </div>
                        <div class="header-action-group" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                            <button type="button"
                                    class="btn-executive-schedule checkout-route-link"
                                    data-train-id="@train?.Id"
                                    data-train-name="@train?.Name"
                                    data-train-number="@train?.Number"
                                    data-from="@FromStation1"
                                    data-to="@ToStation1"
                                    title="View Train Schedule Timetable">
                                <i class="fa-regular fa-clock"></i>
                                <span>Train Schedule</span>
                            </button>
                            <span class="live-seat-status" id="liveSeatStatusTop">@ViewBag.SeatStatus</span>
                        </div>
                    </div>

                    <!-- REVIEW JOURNEY & BOARDING SUMMARY STRIP -->
                    <div class="review-journey-summary-strip" style="background:#eff6ff; border:1px solid #bfdbfe; border-left:4px solid #1d4ed8; border-radius:8px; padding:12px 16px; margin-bottom:16px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
                        <div>
                            <div style="font-weight:700; color:#1e3a8a; font-size:15px;">
                                <i class="fa-solid fa-train me-1"></i> @train?.Name (@train?.Number)
                            </div>
                            <div style="font-size:13px; color:#475569; margin-top:3px;">
                                <span>Class: <strong>@cls?.Code</strong></span>
                                <span class="dot-sep" style="margin:0 6px;">•</span>
                                <span>Quota: <strong>@ViewBag.Quota</strong></span>
                                <span class="dot-sep" style="margin:0 6px;">•</span>
                                <span>Route: <strong>@FromStation1</strong> &rarr; <strong>@ToStation1</strong></span>
                            </div>
                        </div>
                        <div style="background:#ffffff; border:1px solid #93c5fd; border-radius:6px; padding:6px 14px; font-size:13px;">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i>
                            Boarding Station: <strong id="reviewSelectedBoarding" style="color:#1d4ed8;">@FromStation1</strong>
                            <span id="reviewSelectedDeparture" style="color:#64748b; font-size:12px; margin-left:4px;">(@Departure hrs.)</span>
                        </div>
                    </div>

