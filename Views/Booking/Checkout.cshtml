<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    if (typeof window.showToast !== 'function') {
        window.showToast = function (message, type = "error") {
            let container = document.getElementById("toastContainer");
            if (!container) {
                container = document.createElement("div");
                container.id = "toastContainer";
                document.body.appendChild(container);
            }
            const toast = document.createElement("div");
            toast.className = "toast " + type;
            let title = type === "success" ? "Success!" : (type === "warning" ? "Warning!" : "Error!");
            toast.innerHTML = `
                <span class="close-btn">&times;</span>
                <strong>${title}</strong>
                <div>${message}</div>
            `;
            container.appendChild(toast);
            const closeBtn = toast.querySelector(".close-btn");
            if (closeBtn) {
                closeBtn.onclick = () => toast.remove();
            }
            setTimeout(() => {
                if (toast && toast.parentNode) {
                    toast.remove();
                }
            }, 5000);
        };
    }

    $(function () {

        function toggleFareSummary(showDetailed) {
            updateTotal();
        }

        let isVandeTrain = @(isVandeBharat ? "true" : "false");

        function updateReservationChoices() {
            let pCount = $(".passenger-row-item").length;
            let sel = $("#reservationChoiceSelect");
            let currentVal = sel.val();

            sel.empty();
            sel.append('<option value="">Reservation Choice</option>');

            if (pCount <= 1) {
                sel.append('<option value="1LB">Book, only if at least 1 lower berth is allotted</option>');
                if (currentVal === "1LB") {
                    sel.val("1LB");
                } else {
                    sel.val("");
                }
            } else {
                sel.append('<option value="sameCoach">Book, only if all berths are allotted in same coach</option>');
                sel.append('<option value="1LB">Book, only if at least 1 lower berth is allotted.</option>');
                sel.append('<option value="2LB">Book, only if 2 lower berths are allotted</option>');
                if (["sameCoach", "1LB", "2LB"].includes(currentVal)) {
                    sel.val(currentVal);
                } else {
                    sel.val("");
                }
            }
        }

        updateReservationChoices();

        let initialStatus =
            $("#liveSeatStatusTop").text().trim() || '@(ViewBag.SeatStatus ?? "")';

        if (initialStatus) {
            updateSeatStatusColor(initialStatus);
        }

        toggleFareSummary(false);

        // BACK TO TRAIN RESULTS
        $("#backToResultsBtn").click(function () {

            if (document.referrer) {
                window.location.href = document.referrer;
            }
            else {
                window.location.href = "/";
            }
        });

        // --- Update Total Fare ---
        function updateTotal() {

            let baseFare =
                parseFloat('@cls.TotalFare');

            let passengerCount =
                $("#passengers .passenger-row-item").length;

            $("#passengerCount").text(passengerCount);

            let classCode = '@cls.Code'.toUpperCase();

            let paymentMode =
                $("input[name='paymentMode']:checked").val();

            // AC OR NON AC
            let isAcClass =
                classCode.includes("1A") ||
                classCode.includes("2A") ||
                classCode.includes("3A") ||
                classCode.includes("EC") ||
                classCode.includes("CC") ||
                classCode.includes("AC");

            // BASE CONVENIENCE & GST
            let baseConvenienceFee = isAcClass ? 20 : 10;
            let gst = baseConvenienceFee * 0.18;
            let convenienceFee = baseConvenienceFee + gst;

            // INSURANCE (Driven by Step 3 checkbox)
            let insuranceSelected = $("#travelInsurance").is(":checked");
            let insurance = insuranceSelected ? (0.45 * passengerCount) : 0;

            // TATKAL CHARGES (ONLY shown if quota is other than General, e.g. TATKAL)
            let quota = '@ViewBag.Quota'.toUpperCase().trim();
            let isTatkal = (quota.includes("TATKAL") || quota === "TQ" || quota === "PT") && quota !== "GENERAL" && quota !== "GN";
            let tatkalCharge = 0;
            if (isTatkal) {
                tatkalCharge = (isAcClass ? 300 : 150) * passengerCount;
                $("#tatkalChargeRow").show();
                $("#tatkalChargeVal").text(tatkalCharge.toFixed(2));
            } else {
                $("#tatkalChargeRow").hide();
                $("#tatkalChargeVal").text("0.00");
            }

            // CATERING CHARGES (VANDE BHARAT) - ONLY shown if Vande Bharat AND passenger actually selected a catering meal
            let cateringCharge = 0;
            let mealSelectedCount = 0;
            if (isVandeTrain) {
                let optedOut = $("#noBeveragesCheckbox").is(":checked");
                if (!optedOut) {
                    $("select[name='passengerCatering']").each(function () {
                        if ($(this).val()) {
                            mealSelectedCount++;
                        }
                    });
                }
                if (mealSelectedCount > 0) {
                    cateringCharge = 150 * mealSelectedCount;
                    $("#cateringChargeRow").show();
                    $("#cateringChargeVal").text(cateringCharge.toFixed(2));
                } else {
                    $("#cateringChargeRow").hide();
                    $("#cateringChargeVal").text("0.00");
                }
            } else {
                $("#cateringChargeRow").hide();
                $("#cateringChargeVal").text("0.00");
            }

            let ticketFare = baseFare * passengerCount;
            let total = ticketFare + tatkalCharge + cateringCharge + convenienceFee + insurance;

            $("#baseFare").text(ticketFare.toFixed(2));
            $("#convenienceFee").text(convenienceFee.toFixed(2));
            $("#gstFee").text(gst.toFixed(2));
            $("#insuranceFee").text(insurance.toFixed(2));
            $("#totalFare").text(total.toFixed(2));
            $("#reviewFare").text(total.toFixed(2));
            $("#reviewPassengerCount").text(passengerCount);

            // Calculate boarding date based on day number
            let dateParts = '@journey'.split('-');
            let baseDate = new Date(dateParts[0], dateParts[1] - 1, dateParts[2]);
            let boardingDay = parseInt($("#boardingDayInput").val() || '1');
            baseDate.setDate(baseDate.getDate() + (boardingDay - 1));
            let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            let formattedBoardingDate = String(baseDate.getDate()).padStart(2, '0') + " " + months[baseDate.getMonth()] + " " + baseDate.getFullYear();

            let departureTime = $("#boardingDepartureInput").val() || '@Departure';
            if (departureTime.includes("Departure : ")) {
                departureTime = departureTime.replace("Departure : ", "").trim();
            }
            if (departureTime.length > 5) {
                departureTime = departureTime.substring(0, 5);
            }

            // Update boarding details in review dynamically
