    $("#nextToReviewBtn").click(function () {
        let hasError = false;
        let passengerRows = $(".passenger-row-item");

        if (passengerRows.length === 0) {
            showToast("Please add at least one passenger.", "warning");
            return;
        }

        passengerRows.each(function (index) {
            let nameInput = $(this).find("input[name='passengerNames']");
            let ageInput = $(this).find("input[name='passengerAges']");
            let genderSelect = $(this).find("select[name='passengerGenders']");

            let nameVal = (nameInput.val() || "").trim();
            let ageVal = (ageInput.val() || "").trim();
            let genderVal = (genderSelect.val() || "").trim();

            if (!nameVal) {
                showToast("Please enter passenger name", "error");
                nameInput.focus();
                hasError = true;
                return false;
            }

            if (!ageVal || isNaN(ageVal) || parseInt(ageVal, 10) < 1 || parseInt(ageVal, 10) > 125) {
                showToast("Please enter a valid age between 1 and 125", "error");
                ageInput.focus();
                hasError = true;
                return false;
            }

            if (!genderVal) {
                showToast("Please select passenger gender", "error");
                genderSelect.focus();
                hasError = true;
                return false;
            }
        });

        if (hasError) {
            return;
        }

        // Validate Reservation Choice Lower Berth rules
        let resChoice = $("#reservationChoiceSelect").val();
        if (resChoice === "1LB") {
            let lbCount = 0;
            passengerRows.each(function () {
                if ($(this).find("select[name='passengerBerths']").val() === "LB") {
                    lbCount++;
                }
            });
            if (lbCount === 0) {
                showToast("Please select at least one LOWER type in the Berth Preference, as you have selected 1 Lower Berth choice.", "error");
                return;
            }
        } else if (resChoice === "2LB") {
            let lbCount = 0;
            passengerRows.each(function () {
                if ($(this).find("select[name='passengerBerths']").val() === "LB") {
                    lbCount++;
                }
            });
            if (lbCount < 2) {
                showToast("Please select two LOWER type in the Berth Preference, as you have selected 2 Lower Berths choice.", "error");
                return;
            }
        }

        if (isVandeTrain && !$("#noBeveragesCheckbox").is(":checked")) {
            let missingMeal = false;
            let missingElement = null;
            passengerRows.each(function () {
                let mealVal = $(this).find("select[name='passengerCatering']").val();
                if (!mealVal) {
                    missingMeal = true;
                    if (!missingElement) {
                        missingElement = $(this).find("select[name='passengerCatering']");
                    }
                }
            });
            if (missingMeal) {
                showToast("Please select a Catering Service option or opt out of food/beverages", "error");
                if (missingElement) {
                    missingElement.focus();
                }
                return;
            }
