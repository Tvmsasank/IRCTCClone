            showToast("Please enter a valid 10-digit mobile number", "error");
            $("#contactMobileInput").focus();
            return;
        }

        let maskedMob = rawMobile.length >= 6 ? ("******" + rawMobile.substring(rawMobile.length - 4)) : rawMobile;
        $("#reviewMobile").text(maskedMob);
        $("#summaryMobile").text(maskedMob);

