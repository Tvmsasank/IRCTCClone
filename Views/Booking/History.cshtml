        function submitOptMeal() {
            const bookingId = document.getElementById('optMealBookingId').value;
            const selectedMeal = document.querySelector('input[name="optMealRadio"]:checked')?.value || 'Veg';

            fetch('/Booking/UpdateMealPreference', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `bookingId=${encodeURIComponent(bookingId)}&meal=${encodeURIComponent(selectedMeal)}`
            })
            .then(res => res.json())
            .then(data => {
                closeOptMealModal();
                if (data.success) {
                    Swal.fire('Meal Updated', data.message, 'success');
                    const dynamicContainer = document.getElementById(`acc-content-dynamic-${bookingId}`);
                    if (dynamicContainer) {
                        dynamicContainer.removeAttribute('data-loaded');
                        toggleBookingAccordion(bookingId);
                        toggleBookingAccordion(bookingId);
                    }
                } else {
                    Swal.fire('Error', data.message || 'Failed to update meal', 'error');
                }
            })
            .catch(() => {
                closeOptMealModal();
                Swal.fire('Error', 'Failed to update meal preference.', 'error');
            });
        }

        // UPCOMING, PAST, ALL TICKETS COUNT
        function updateCounts() {
            const now = new Date();
            const cards = document.querySelectorAll('.accordion-ticket-card');

            let upcoming = 0, past = 0;

            cards.forEach(card => {

                const journeyEnd = new Date(card.getAttribute('data-journey-end'));
                const ticketStatus = card.getAttribute('data-ticket-status');

                if (ticketStatus === "CANCELLED") {
                    past++;
                    return;
                }

                if (now <= journeyEnd)
                    upcoming++;
                else
                    past++;
            });

            const upEl = document.getElementById('upcomingCount');
            const pastEl = document.getElementById('pastCount');
            const allEl = document.getElementById('allCount');

            if (upEl) upEl.innerText = upcoming;
            if (pastEl) pastEl.innerText = past;
            if (allEl) allEl.innerText = cards.length;
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateCounts();
            const activeTab = document.querySelector('.tab-btn-modern.active');
            if (activeTab) filterBookings('upcoming', activeTab);
        });

