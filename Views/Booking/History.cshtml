@model IEnumerable<IRCTCClone.Models.Booking>

@{
    ViewData["Title"] = "Booked Ticket History";
}

<div class="booked-history-page-wrapper">
    <div class="history-container">
        
        <!-- Header Row with Title and Filter Tabs -->
        <div class="history-main-header">
            <h2 class="history-page-title">Booked Ticket History</h2>
            
            <div class="booking-tabs-modern">
                <button class="tab-btn-modern" onclick="filterBookings('all', this)">
                    All Trips <span class="badge-count" id="allCount"></span>
                </button>
                <button class="tab-btn-modern active" onclick="filterBookings('upcoming', this)">
                    Upcoming <span class="badge-count" id="upcomingCount"></span>
                </button>
                <button class="tab-btn-modern" onclick="filterBookings('past', this)">
                    Past <span class="badge-count" id="pastCount"></span>
                </button>
            </div>
        </div>

        <!-- Yellow Safety Notice Box -->
        <div class="irctc-safety-notice-box">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>Indian Railway, IRCTC or its employees never ask for any personal banking information, including details like Debit/Credit Card number, OTP, ATM PIN, the CVV number, PAN number or Date of birth.</span>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert-success-banner">
                @TempData["Message"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="empty-state-card">
                <i class="fa-solid fa-ticket-simple"></i>
                <p>No booked tickets found.</p>
                <a href="/" class="btn-book-train-now">Book a Train Ticket</a>
            </div>
        }
        else
        {
            <div id="emptyState" class="empty-state-card" style="display:none;">
                <i class="fa-regular fa-folder-open"></i>
                <p>No bookings found in this category.</p>
            </div>

            <div class="booking-accordion-list">
                @foreach (var b in Model)
                {
                    var departureDate = b.JourneyDate;
                    var arrivalDate = b.Arrival < b.Departure
                        ? b.JourneyDate.AddDays(1)
                        : b.JourneyDate;

                    var journeyEnd = $"{arrivalDate:yyyy-MM-dd}T{b.Arrival:hh\\:mm\\:ss}";

                    string statusClass = b.TicketStatus switch
                    {
                        "CANCELLED" => "status-badge-cancelled",
                        "PARTIAL" => "status-badge-partial",
                        "BOOKED" or "CNF" or "CONFIRMED" => "status-badge-booked",
                        "RAC" => "status-badge-rac",
                        "WL" => "status-badge-wl",
                        _ => "status-badge-booked"
                    };

                    string displayStatus = b.TicketStatus switch
                    {
                        "CANCELLED" => "Cancelled",
                        "PARTIAL" => "Partially Cancelled",
                        "BOOKED" or "CNF" => "Status: Booked",
                        "RAC" => "Status: RAC",
                        "WL" => "Status: WL",
                        _ => "Status: " + (b.TicketStatus ?? "Booked")
                    };

                    <div class="accordion-ticket-card"
                         id="booking-card-@b.BookingId"
                         data-journey-end="@journeyEnd"
                         data-ticket-status="@((b.TicketStatus ?? "BOOKED").ToUpper())">

                        <!-- Accordion Header: Always Visible / Click to toggle -->
                        <div class="accordion-header-row" onclick="toggleBookingAccordion('@b.BookingId')">
                            <div class="acc-header-left">
                                <div class="acc-train-title">
                                    <i class="fa-solid fa-train text-blue"></i>
                                    <strong>@b.TrainName (@b.TrainNumber)</strong>
                                </div>
                                <div class="acc-summary-line">
                                    <span>Class: <strong>@b.ClassCode</strong></span>
                                    <span class="dot-sep">•</span>
                                    <span>Quota: <strong>General</strong></span>
                                    <span class="dot-sep">•</span>
                                    <span>Date: <strong>@departureDate.ToString("dd MMM yyyy")</strong></span>
                                    <span class="dot-sep">•</span>
                                    <span>From: <strong>@b.FromStation</strong></span>
                                    <span class="dot-sep">•</span>
                                    <span>To: <strong>@b.ToStation</strong></span>
                                </div>
                            </div>

                            <div class="acc-header-right">
                                <span class="pnr-label">PNR: <strong>@b.PNR</strong></span>
                                <span class="status-badge @statusClass">@displayStatus</span>
                                <i class="fa-solid fa-chevron-down chevron-toggle-icon" id="chevron-@b.BookingId"></i>
                            </div>
                        </div>

                        <!-- Accordion Body: Fully Dynamic from Database on Click -->
                        <div class="accordion-body-content" id="acc-body-@b.BookingId" style="display: none;">
                            <div id="acc-content-dynamic-@b.BookingId" class="acc-dynamic-container">
                                <div class="inline-spinner" style="padding: 24px; text-align: center; color: #64748b;">
                                    <i class="fa-solid fa-spinner fa-spin"></i> Loading journey details from database...
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

<!--  -->
<div id="fullCancelModal" class="modal-overlay">

    <div class="modal-content">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h3 style="margin:0; font-size:20px; font-weight:700; color:#1f3c88;">Cancel Ticket</h3>
            <span onclick="closeFullModal()" style="cursor:pointer; font-size:22px; font-weight:bold; color:#777; line-height:1;">✖</span>
        </div>

        <hr style="margin: 8px 0 16px;">

        <div id="cancelBookingDetails"></div>

        <div style="overflow-x:auto; width:100%; -webkit-overflow-scrolling: touch;">
            <table id="passengerTable" style="width:100%; margin-top:10px;"></table>
        </div>

        <div style="margin-top: 18px; text-align: right;">
            <button id="cancelBtn" onclick="confirmPassengerCancel()" style="display:none; cursor: pointer;">
                Cancel E-Ticket
            </button>
        </div>

    </div>

</div>

<!--  -->
<div id="irctcConfirmModal" class="irctc-modal-overlay">

    <div class="irctc-modal-box">

        <!-- Header -->
        <div class="irctc-header">
            Confirmation
        </div>

        <!-- Body -->
        <div class="irctc-body">
            Do You Want to Process the Cancellation Request ?
        </div>

        <!-- Footer -->
        <div class="irctc-footer">
            <button class="yes-btn" onclick="finalCancel()">✔ Yes</button>
            <button class="no-btn" onclick="closeIrctcModal()">✖ No</button>
        </div>

    </div>

</div>

<!--  -->
<div id="errorModal" class="modal-overlay">
    <div class="modal-content" style="width:400px; max-width:90%; text-align:center;">
        <p id="errorText" style="font-size:15px; margin-bottom:15px; font-weight:600;"></p>
        <button class="yes-btn" onclick="closeErrorModal()">OK</button>
    </div>
</div>

<!--  -->
<div id="cancelModal">
    <div class="modal-box">
        <p>Are you sure you want to cancel this ticket?</p>

        <button onclick="confirmCancelYes()">Yes</button>
        <button onclick="closeCancelModal()">No</button>
    </div>
</div>

<!--  -->
<div id="detailsModal" class="modal-overlay">

    <div class="modal-content">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h3 style="margin:0; font-size:20px; font-weight:700; color:#1f3c88;">Booking Details</h3>
            <span onclick="closeDetailsModal()" style="cursor:pointer; font-size:22px; font-weight:bold; color:#777; line-height:1;">✖</span>
        </div>

        <hr style="margin: 8px 0 16px;">

        <div id="detailsModalBody"></div>

    </div>

</div>

<!--  -->
<div id="refundOverlay" class="refund-overlay">
    <div class="refund-modal">
        <h3>Cancellation Summary</h3>

        <div class="refund-row">
            <span>PNR:</span>
            <span id="pnr"></span>
        </div>

        <div class="refund-row">
            <span>Fare:</span>
            <span>₹<span id="fare"></span></span>
        </div>

        <div class="refund-row">
            <span>Deduction:</span>
            <span>₹<span id="deduction"></span></span>
        </div>

        <div class="refund-row refund-amount">
            <span>Refund:</span>
            <span>₹<span id="refund"></span></span>
        </div>

        <p id="refundMessage"></p>

        <button class="refund-close" onclick="closeRefund()">Close</button>
    </div>
</div>





@section Scripts{
    <script>

        // TOGGLE ACCORDION (100% DYNAMIC FROM DATABASE)
        function toggleBookingAccordion(bookingId) {
            const body = document.getElementById(`acc-body-${bookingId}`);
            const chevron = document.getElementById(`chevron-${bookingId}`);
            const dynamicContainer = document.getElementById(`acc-content-dynamic-${bookingId}`);

            if (!body) return;

            const isExpanded = body.style.display === 'block';

            if (isExpanded) {
                body.style.display = 'none';
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            } else {
                body.style.display = 'block';
                if (chevron) chevron.style.transform = 'rotate(180deg)';

                // Fetch dynamic booking & passenger data if not yet loaded
                if (dynamicContainer && !dynamicContainer.getAttribute('data-loaded')) {
                    fetch(`/Booking/GetBookingForCancel?id=${bookingId}`)
                        .then(res => res.json())
                        .then(data => {
                            dynamicContainer.setAttribute('data-loaded', 'true');
                            if (!data || !data.booking) {
                                dynamicContainer.innerHTML = `<div style="padding:16px; color:#ef4444;">Failed to load booking details from database.</div>`;
                                return;
                            }

                            const b = data.booking;
                            const passengers = data.passengers || [];

                            // 1. Dynamic Charting Status (Prepared within 8 hours of train departure as per IRCTC rules)
                            let isPrepared = b.isChartPrepared;
                            if (isPrepared === undefined && b.rawJourneyDate && b.departure) {
                                try {
                                    const depDateTime = new Date(`${b.rawJourneyDate}T${b.departure}`);
                                    const diffHours = (depDateTime - new Date()) / 3600000;
                                    isPrepared = diffHours <= 8;
                                } catch (e) { }
                            }

                            let chartingHtml = isPrepared
                                ? `<span class="badge-chart badge-chart-prepared" style="background:#dcfce7; color:#15803d; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700;"><i class="fa-solid fa-circle-check me-1"></i> Chart Prepared</span>`
                                : `<span class="badge-chart badge-chart-not-prepared" style="background:#fef3c7; color:#92400e; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700;"><i class="fa-solid fa-clock me-1"></i> Chart Not Prepared</span>`;

                            // 2. Dynamic Insurance & Fares from Database
                            const insuranceAmount = parseFloat(b.insurance || 0);
                            const hasInsurance = insuranceAmount > 0;
                            const baseFare = parseFloat(b.baseFare || 0);
                            const convenienceFee = parseFloat(b.convenienceFees || 0);
                            const totalFare = parseFloat(b.fare || (baseFare + convenienceFee + insuranceAmount)).toFixed(2);

                            // 3. Dynamic Passenger Rows
                            let passengerRowsHtml = '';
                            if (passengers.length === 0) {
                                passengerRowsHtml = `<tr><td colspan="7" style="text-align:center; color:#64748b; padding:12px;">No passenger records found.</td></tr>`;
                            } else {
                                passengers.forEach((p, idx) => {
                                    const isCan = p.currentStatus === 'CAN' || p.currentStatus === 'CANCELLED';
                                    const statusColor = isCan ? 'status-cancelled' : 'status-confirmed';
                                    
                                    // Coach & Berth assignment from DB
                                    let coachBerth = '--';
                                    if (p.seat && p.seat.trim() !== '') {
                                        coachBerth = `${p.seat} ${p.berth ? `(${p.berth})` : ''}`;
                                    } else if (p.bookingStatus === 'RAC' || p.currentStatus === 'RAC') {
                                        coachBerth = `RAC ${p.Position ? `(${p.Position})` : ''}`;
                                    } else if (p.bookingStatus === 'WL' || p.currentStatus === 'WL') {
                                        coachBerth = `WL ${p.Position ? `(${p.Position})` : ''}`;
                                    } else if (isCan) {
                                        coachBerth = 'Cancelled';
                                    }

                                    const insuranceStatus = hasInsurance ? `Opted` : `--`;

                                    passengerRowsHtml += `
                                        <tr>
                                            <td>${idx + 1}</td>
                                            <td><strong>${p.name}</strong></td>
                                            <td>${p.age} / ${p.gender}</td>
                                            <td><span class="booking-status">${p.bookingStatus} ${p.Position ? `(${p.Position})` : ''}</span></td>
                                            <td><span class="${statusColor}">${p.currentStatus} ${p.Position ? `(${p.Position})` : ''}</span></td>
                                            <td><strong>${coachBerth}</strong></td>
                                            <td>${insuranceStatus}</td>
                                        </tr>
                                    `;
                                });
                            }

                            // 4. Render the Complete Dynamic Container
                            dynamicContainer.innerHTML = `
                                <!-- 1. Journey Departure / Duration / Arrival Banner -->
                                <div class="journey-schedule-banner">
                                    <div class="schedule-station-block">
                                        <div class="stn-time">${b.departure ? b.departure.substring(0, 5) : '--:--'}</div>
                                        <div class="stn-date">${b.journeyDate}</div>
                                        <div class="stn-name">${b.from}</div>
                                    </div>

                                    <div class="schedule-duration-track">
                                        <div class="duration-text">${b.duration || '--'}</div>
                                        <div class="duration-line-indicator">
                                            <span class="line-dot start-dot"></span>
                                            <span class="line-bar"></span>
                                            <i class="fa-solid fa-train-subway line-train-icon"></i>
                                            <span class="line-bar"></span>
                                            <span class="line-dot end-dot"></span>
                                        </div>
                                        <div class="track-tag">Class: ${b.className || '--'} | Quota: ${b.quota || 'General'}</div>
                                    </div>

                                    <div class="schedule-station-block text-right">
                                        <div class="stn-time">${b.arrival ? b.arrival.substring(0, 5) : '--:--'}</div>
                                        <div class="stn-date">${b.journeyDate}</div>
                                        <div class="stn-name">${b.to}</div>
                                    </div>
                                </div>

                                <!-- 2. Boarding Banner with IRCTC Advisory -->
                                <div class="boarding-alert-banner" style="background: #eff6ff; border-left: 4px solid #1a365d; border-radius: 6px; padding: 12px 16px; margin: 12px 0; font-size: 13px; color: #1e293b; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                                    <div>
                                        <i class="fa-solid fa-train-subway text-blue me-2"></i>
                                        <span>Boarding at: <strong>${b.from}</strong> | <strong>${b.journeyDate}</strong> | <strong>${b.departure ? b.departure.substring(0, 5) : '--:--'} hrs.</strong></span>
                                    </div>
                                    <div style="font-size: 12px; color: #c2410c; font-weight: 600;">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Boarding allowed ONLY from selected station
                                    </div>
                                </div>

                                <!-- 3. Passenger Details Table -->
                                <div class="card-inner-section">
                                    <div class="section-subheading">
                                        <i class="fa-solid fa-users"></i> Passenger Details
                                    </div>
                                    <div style="overflow-x:auto; width:100%;">
                                        <table class="passengers-modern-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Passenger Name</th>
                                                    <th>Age / Gender</th>
                                                    <th>Booking Status</th>
                                                    <th>Current Status</th>
                                                    <th>Coach & Berth</th>
                                                    <th>Insurance Policy</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${passengerRowsHtml}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- 4. Booking Details & Payment Details (2 Columns) -->
                                <div class="details-two-column-grid">
                                    
                                    <!-- Column 1: Booking Details -->
                                    <div class="details-box-card">
                                        <div class="details-box-header"><i class="fa-regular fa-calendar-check"></i> Booking Details</div>
                                        <div class="details-table-list">
                                            <div class="d-row"><span>Transaction ID:</span> <strong class="mono-txt">TXN${b.pnr}</strong></div>
                                            <div class="d-row"><span>Ticket Type:</span> <strong>E-ticket</strong></div>
                                            <div class="d-row"><span>Booked On:</span> <strong>${b.bookingDate || '--'}</strong></div>
                                            <div class="d-row"><span>Booked From:</span> <strong>IRCTC WEBSITE</strong></div>
                                            <div class="d-row"><span>Charting Status:</span> ${chartingHtml}</div>
                                        </div>
                                    </div>

                                    <!-- Column 2: Payment Details -->
                                    <div class="details-box-card">
                                        <div class="details-box-header"><i class="fa-regular fa-credit-card"></i> Payment Details</div>
                                        <div class="details-table-list">
                                            <div class="d-row"><span>Payment Mode:</span> <strong>IRCTC e-Wallet / UPI</strong></div>
                                            <div class="d-row"><span>Ticket Base Fare:</span> <strong>₹${baseFare.toFixed(2)}</strong></div>
                                            <div class="d-row"><span>Convenience Fee (incl. GST):</span> <strong>₹${convenienceFee.toFixed(2)}</strong></div>
                                            <div class="d-row"><span>Travel Insurance Premium:</span> <strong>₹${insuranceAmount.toFixed(2)}</strong></div>
                                            <div class="d-row total-row"><span>TOTAL AMOUNT:</span> <strong class="total-amt">₹${totalFare}</strong></div>
                                        </div>
                                    </div>

                                </div>

                                <!-- 5. Travel Insurance Details Card -->
                                <div class="insurance-summary-card">
                                    <div class="insurance-header">
                                        <i class="fa-solid fa-shield-halved text-blue"></i>
                                        <strong>Travel Insurance Details</strong>
                                    </div>
                                    <div class="insurance-grid-cols">
                                        <div><span>Travel Insurance Opted:</span> <strong>${hasInsurance ? 'Yes' : 'No'}</strong></div>
                                        <div><span>Policy Issue Date:</span> <strong>${hasInsurance && b.bookingDate ? b.bookingDate : '--'}</strong></div>
                                        <div><span>Premium (incl. of GST):</span> <strong>₹${insuranceAmount.toFixed(2)}</strong></div>
                                        <div><span>Insured Passengers:</span> <strong>${hasInsurance ? passengers.length : 0}</strong></div>
                                    </div>
                                </div>

                                <!-- 6. Action Buttons Bar -->
                                <div class="accordion-actions-bar">
                                    <button type="button" class="btn-sec-action" onclick="alert('PNR ${b.pnr} status is current and valid.')">
                                        <i class="fa-solid fa-magnifying-glass"></i> Get PNR Status
                                    </button>
                                    
                                    <button type="button" class="btn-sec-action" onclick="alert('SMS with ticket details sent to your registered mobile.')">
                                        <i class="fa-solid fa-comment-sms"></i> Get SMS
                                    </button>

                                    <button type="button" class="btn-sec-action" onclick="alert('Boarding point change is permitted up to 4 hours prior to chart preparation.')">
                                        <i class="fa-solid fa-location-crosshairs"></i> Change Boarding Point
                                    </button>

                                    ${b.status === 'CANCELLED' ? `
                                        <button type="button" class="btn-sec-action text-blue" onclick="showRefundExplanation('${b.pnr}')">
                                            <i class="fa-solid fa-receipt"></i> Refund Calculation
                                        </button>
                                    ` : `
                                        <button type="button" class="btn-danger-action" onclick="openCancelModal('${b.bookingId}')">
                                            <i class="fa-regular fa-circle-xmark"></i> Cancel E-Ticket
                                        </button>
                                    `}

                                    <a href="/Booking/DownloadTicket/${b.bookingId}" class="btn-primary-action no-loader">
                                        <i class="fa-solid fa-download"></i> Download E-Ticket
                                    </a>

                                    <button type="button" class="btn-sec-action" onclick="window.print()">
                                        <i class="fa-solid fa-print"></i> Print
                                    </button>
                                </div>

                                <!-- 7. Bottom Quick Cross-Services Banner -->
                                <div class="cross-services-banner">
                                    <a href="https://www.air.irctc.co.in" target="_blank" class="service-pill"><i class="fa-solid fa-plane"></i> Book Flight</a>
                                    <a href="https://www.hotel.irctc.co.in" target="_blank" class="service-pill"><i class="fa-solid fa-hotel"></i> Book Hotel</a>
                                    <a href="https://www.bus.irctc.co.in" target="_blank" class="service-pill"><i class="fa-solid fa-bus"></i> Book Bus</a>
                                    <a href="/Home/Meals" class="service-pill"><i class="fa-solid fa-utensils"></i> Order Food - E-Catering</a>
                                    <a href="https://www.irctctourism.com" target="_blank" class="service-pill"><i class="fa-solid fa-bed"></i> Book Retiring Room</a>
                                    <a href="https://www.irctctourism.com" target="_blank" class="service-pill"><i class="fa-solid fa-umbrella-beach"></i> Book Tourist Package</a>
                                </div>
                            `;
                        })
                        .catch(err => {
                            console.error(err);
                            dynamicContainer.innerHTML = `<div style="padding:16px; color:#ef4444;">Failed to load booking details from database.</div>`;
                        });
                }
            }
        }

        // SHOW TICKETS LIST BASED ON TABS
        function filterBookings(type, el) {

            const now = new Date();
            const cards = document.querySelectorAll('.accordion-ticket-card');

            let visible = 0;

            document.querySelectorAll('.tab-btn-modern').forEach(b => b.classList.remove('active'));
            if (el) el.classList.add('active');

            cards.forEach(card => {

                const journeyEnd = new Date(card.getAttribute('data-journey-end'));
                const status = card.getAttribute('data-ticket-status');

                let show = false;

                if (type === 'all') show = true;

                else if (type === 'upcoming')
                    show = (now <= journeyEnd && status !== "CANCELLED");

                else if (type === 'past')
                    show = (now > journeyEnd || status == "CANCELLED");

                if (show) {
                    card.style.display = 'block';
                    visible++;
                } else {
                    card.style.display = 'none';
                }
            });

            const emptyEl = document.getElementById('emptyState');
            if (emptyEl) {
                emptyEl.style.display = visible === 0 ? 'block' : 'none';
            }
        }

        // UPCOMING, PAST, ALL TICKETS COUNT
        function updateCounts() {
            const now = new Date();
            const cards = document.querySelectorAll('.accordion-ticket-card');

            let upcoming = 0, past = 0;

            cards.forEach(card => {

                const journeyEnd = new Date(card.getAttribute('data-journey-end'));
                const ticketStatus = card.getAttribute('data-ticket-status');

                if (ticketStatus === "CANCELLED") {
                    past++;
                    return;
                }

                if (now <= journeyEnd)
                    upcoming++;
                else
                    past++;
            });

            const upEl = document.getElementById('upcomingCount');
            const pastEl = document.getElementById('pastCount');
            const allEl = document.getElementById('allCount');

            if (upEl) upEl.innerText = upcoming;
            if (pastEl) pastEl.innerText = past;
            if (allEl) allEl.innerText = cards.length;
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateCounts();
            const activeTab = document.querySelector('.tab-btn-modern.active');
            if (activeTab) filterBookings('upcoming', activeTab);
        });

        // AFTER DOJ IF TRY TO CANCEL TICKET ERROR OCCURS
        let currentForm = null;

        function handleCancel(btn) {
            const journeyDate = btn.getAttribute('data-date');
            const today = new Date().toISOString().split('T')[0];

            if (journeyDate < today) {
                showToast("Cancellation is Not Allowed as ticket is beyond permissible limit of cancellation");
                return;
            }

            currentForm = btn.closest('form');

            document.getElementById('cancelModal').style.display = 'flex'; // ✅ center
        }

        // 
        function confirmCancelYes() {

            if (currentForm) currentForm.submit();
        }

        // 
        function closeCancelModal() {

            document.getElementById('cancelModal').style.display = 'none';
        }

        // REFUND NOTE ON CANCEL TICKET WILL SHOW IN THE TICKET CARD
        async function showRefundExplanation(pnr) {

            const modalText = document.getElementById("refundMessage");
            modalText.innerText = "Loading...";

            document.getElementById("refundOverlay").style.display = "flex";

            try {
                const response = await fetch(`/Booking/GetRefundDetails?pnr=${pnr}`);

                if (!response.ok) throw new Error("API failed");

                const data = await response.json();

                showRefund(data); // ✅ THIS FILLS EVERYTHING

            } catch (error) {
                modalText.innerText = "Failed to load refund details.";
                console.error(error);
            }
        }

        // DATA IN REFUND
        function showRefund(data) {
            document.getElementById("pnr").innerText = data.pnr;
            document.getElementById("fare").innerText = data.fare;
            document.getElementById("deduction").innerText = data.deduction;
            document.getElementById("refund").innerText = data.refundAmount;
            document.getElementById("refundMessage").innerText = data.message;

            document.getElementById("refundOverlay").style.display = "flex";
        }

        // CLOSE REFUND
        function closeRefund() {
            document.getElementById("refundOverlay").style.display = "none";
        }

        // ✅ Default = Upcoming
        window.onload = function () {
            document.querySelector('.tab-btn.active').click();
        };

        // 
        function fixModalBug() {
            document.body.classList.remove('modal-open');
            document.body.style.overflow = 'auto';

            const backdrops = document.querySelectorAll('.modal-backdrop');
            backdrops.forEach(b => b.remove());
        }

        // CLOSE MODAL ON CLICK CANCEL
        function openCancelModal(bookingId) {

            fetch(`/Booking/GetBookingForCancel?id=${bookingId}`)
            .then(res => res.json())
            .then(data => {

                const b = data.booking;

                        function getStatusClass(status) {
            if (status === "CNF") return "green";
            if (status === "CANCELLED") return "red";
            if (status === "RAC") return "blue";
            return "black";
        }

                document.getElementById("cancelBookingDetails").innerHTML = `
                <div class="cancel-header">
                    <div class="left">
                        <p><b>PNR:</b> ${b.pnr}</p>
                        <p><b>Train:</b> ${b.trainName} (${b.trainNo})</p>
                        <p><b>${b.from} → ${b.to}</b></p>
                        <p><b>Journey:</b> ${b.journeyDate}</p>
                        <p><b>Booking Date:</b> ${b.bookingDate}</p>
                        <p><b>Quota:</b> ${b.quota}</p>
                        <p><b>Travel Insurance:</b> ₹${b.insurance}</p>
                    </div>

                    <div class="right">
                        <p><b>Class:</b> ${b.className}</p>
                        <p><b>Base Fare:</b> ₹${b.baseFare}</p>
                        <p><b>Board & Deboard:</b> ${b.journeyFull}</p>
                        <p><b>Convenience Fee (Incl. GST):</b> ₹${b.convenienceFees}</p>
                        <p><b>Duration:</b> ${b.duration}</p>
                     </div>
                </div>
                `;

                let rows = `
                    <tr>
                        <th>Select</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Gender</th>
                        <th>Booking Status</th>
                        <th>Current Status</th>
                </tr>
                `;

                data.passengers.forEach(p => {
                rows += `
                <tr>
                    <td>
                        <input type="checkbox" value="${p.id}"
                            ${p.currentStatus === 'CAN' ? 'disabled' : ''}>
                    </td>

                    <td>${p.name}</td>
                    <td>${p.age}</td>
                    <td>${p.gender}</td>

                    <!-- ✅ BOOKING STATUS -->
                    <td class="booking-status">
                        ${p.bookingStatus}
                        ${(p.bookingStatus === 'RAC' || p.bookingStatus === 'WL') && p.position
                            ? ` (${p.position})` : ''}
                    </td>

                    <!-- ✅ CURRENT STATUS -->
                    <td style="color:${p.currentStatus === 'CAN' ? 'red' : 'green'}; font-weight:bold;">
                        ${p.currentStatus}
                        ${(p.currentStatus === 'RAC' || p.currentStatus === 'WL') && p.position
                            ? ` (${p.position})` : ''}
                    </td>
                </tr>
                `;
            });

                document.getElementById("passengerTable").innerHTML = rows;

                document.getElementById("fullCancelModal").style.display = "flex";
            })
            .catch(err => {
                console.error(err);
                alert("Failed to load cancel details");  
            });
        }

        // IF NOT SELECTING A SINGLE PASSENGER
        let selectedPassengers = [];

        function confirmPassengerCancel() {

            selectedPassengers = [];

            document.querySelectorAll('#passengerTable input:checked')
                .forEach(cb => selectedPassengers.push(cb.value));

            if (selectedPassengers.length === 0) {
                showErrorModal("Please select at least one passenger");
                return;
            }

            // ✅ ONLY OPEN CONFIRMATION MODAL
            document.getElementById("irctcConfirmModal").style.display = "flex";
        }

        // 2ND MODAL FOR CANCEL OF THE TICKET
        function closeIrctcModal() {
            document.getElementById("irctcConfirmModal").style.display = "none";
        }

        // FINAL CLOSE AND CANCEL FUNCTION
        function finalCancel() {
            closeIrctcModal();
            showLoader();
            cancelPassengers(selectedPassengers);
        }

        // CANCEL PASSENGER INDIVIDUALLY
        function cancelPassengers(passengerIds) {

            fetch('/Booking/CancelPassengers', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(passengerIds)
            })
            .then(res => res.json())
            .then(data => {

                hideLoader();

                if (data.success) {

                    // ✅ Update UI inside modal WITHOUT closing it

                    document.querySelectorAll('#passengerTable input:checked')
                        .forEach(cb => {

                            let row = cb.closest('tr');

                            // Current Status column (last column)
                            let statusCell = row.cells[row.cells.length - 1];

                            statusCell.innerHTML = "CAN";
                            statusCell.style.color = "red";
                            statusCell.style.fontWeight = "bold";

                            // Disable checkbox
                            cb.checked = false;
                            cb.disabled = true;
                        });

                    // Hide cancel button if no more selectable passengers
                    if (document.querySelectorAll('#passengerTable input:not(:disabled)').length === 0) {
                        document.getElementById("cancelBtn").style.display = "none";
                    }
                }
                
                else {
                    showErrorModal("Cancel failed");
                }
            })

            .catch(err => {
                hideLoader();
                console.error(err);
                showErrorModal("Cancellation failed. Please try again.");
            });
        }

        // ON CLICK VIEW OPEN DETAILS OF THE PASSENGERS
        function openDetailsModal(id) {

            fetch(`/Booking/Details/${id}`)   // calling existing Details action
                .then(res => res.text())      // VERY IMPORTANT (HTML, not JSON)
                .then(html => {

                    document.getElementById("detailsModalBody").innerHTML = html;

                    document.getElementById("detailsModal").style.display = "flex";
                })
                .catch(err => {
                    console.error(err);
                    alert("Failed to load details");
                });
        }

        // CLOSE DETAILS MODAL
        function closeDetailsModal() {
            document.getElementById("detailsModal").style.display = "none";
            if (window.bookingHasBeenUpdated) {
                showLoader();
                setTimeout(() => {
                    safeReload();
                }, 100);
            }
        }

        // ON CLOSE RELOADS PAGE IF MODIFIED
        function closeFullModal() {
            document.getElementById("fullCancelModal").style.display = "none";
            if (window.bookingHasBeenUpdated) {
                showLoader();
                setTimeout(() => {
                    safeReload();
                }, 100);
            }
        }

        // IF ERROR OCCURS
        function showErrorModal(msg) {
            document.getElementById("errorText").innerText = msg;
            document.getElementById("errorModal").style.display = "flex";
        }

        // CLOSE THE ERROR OCCURS
        function closeErrorModal() {
            document.getElementById("errorModal").style.display = "none";
        }

        document.addEventListener("change", function () {

            const checked = document.querySelectorAll('#passengerTable input:checked').length;

            document.getElementById("cancelBtn").style.display =
                checked > 0 ? "inline-block" : "none";
        });

        // <p><b>Status:</b>
        //    <span style="color:${getStatusClass(b.status)}; font-weight:bold;">
        //        ${b.status}
        //    </span>
        // </p>

    </script>
}

