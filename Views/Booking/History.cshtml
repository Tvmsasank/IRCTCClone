@section Scripts{
    <script>

        // TOGGLE ACCORDION (100% DYNAMIC FROM DATABASE)
        function toggleBookingAccordion(bookingId) {
            const body = document.getElementById(`acc-body-${bookingId}`);
            const chevron = document.getElementById(`chevron-${bookingId}`);
            const dynamicContainer = document.getElementById(`acc-content-dynamic-${bookingId}`);

            if (!body) return;

            const isExpanded = body.style.display === 'block';

            if (isExpanded) {
                body.style.display = 'none';
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            } else {
                body.style.display = 'block';
                if (chevron) chevron.style.transform = 'rotate(180deg)';

                // Fetch dynamic booking & passenger data if not yet loaded
                if (dynamicContainer && !dynamicContainer.getAttribute('data-loaded')) {
                    fetch(`/Booking/GetBookingDetails?id=${bookingId}`)
                        .then(res => res.json())
                        .then(data => {
                            dynamicContainer.setAttribute('data-loaded', 'true');
                            if (!data || !data.booking) {
                                dynamicContainer.innerHTML = `<div style="padding:16px; color:#ef4444;">Failed to load booking details from database.</div>`;
                                return;
                            }

                            const b = data.booking;
                            const passengers = data.passengers || [];

                            // 1. Dynamic Charting Status (Prepared within 8 hours of train departure as per IRCTC rules)
                            let isPrepared = b.isChartPrepared;
                            if (isPrepared === undefined && b.rawJourneyDate && b.departure) {
                                try {
                                    const depDateTime = new Date(`${b.rawJourneyDate}T${b.departure}`);
                                    const diffHours = (depDateTime - new Date()) / 3600000;
                                    isPrepared = diffHours <= 8;
                                } catch (e) { }
                            }

                            let chartingHtml = isPrepared
                                ? `<span class="badge-chart badge-chart-prepared" style="background:#dcfce7; color:#15803d; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700;"><i class="fa-solid fa-circle-check me-1"></i> Chart Prepared</span>`
                                : `<span class="badge-chart badge-chart-not-prepared" style="background:#fef3c7; color:#92400e; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700;"><i class="fa-solid fa-clock me-1"></i> Chart Not Prepared</span>`;

                            // 2. Dynamic Insurance & Fares from Database
                            const insuranceAmount = parseFloat(b.insurance || 0);
                            const hasInsurance = insuranceAmount > 0;
                            const baseFare = parseFloat(b.baseFare || 0);
                            const convenienceFee = parseFloat(b.convenienceFees || 0);
                            const totalFare = parseFloat(b.fare || (baseFare + convenienceFee + insuranceAmount)).toFixed(2);

                            // 3. Dynamic Passenger Rows
                            let passengerRowsHtml = '';
                            if (passengers.length === 0) {
                                passengerRowsHtml = `<tr><td colspan="7" style="text-align:center; color:#64748b; padding:12px;">No passenger records found.</td></tr>`;
                            } else {
                                passengers.forEach((p, idx) => {
                                    const currUpper = (p.currentStatus || '').toUpperCase();
                                    const bookUpper = (p.bookingStatus || '').toUpperCase();

                                    // Color coding: Green for CNF / AVAILABLE, Orange/Yellow for RAC, Red for WL / CAN
                                    let statusColor = 'status-confirmed';
                                    if (currUpper === 'CAN' || currUpper === 'CANCELLED') {
                                        statusColor = 'status-cancelled';
                                    } else if (currUpper.includes('WL') || currUpper.includes('WAIT')) {
                                        statusColor = 'status-badge-wl';
                                    } else if (currUpper.includes('RAC')) {
                                        statusColor = 'status-badge-rac';
                                    }

                                    let bookColor = 'status-confirmed';
                                    if (bookUpper === 'CAN' || bookUpper === 'CANCELLED') {
                                        bookColor = 'status-cancelled';
                                    } else if (bookUpper.includes('WL') || bookUpper.includes('WAIT')) {
                                        bookColor = 'status-badge-wl';
                                    } else if (bookUpper.includes('RAC')) {
                                        bookColor = 'status-badge-rac';
                                    }

                                    // Coach & Berth assignment from DB
                                    let coachBerth = '--';
                                    const isBookWL = bookUpper.includes('WL') || bookUpper.includes('WAIT');
                                    const isCurrCNF = currUpper === 'CNF' || currUpper === 'CONFIRMED';

                                    if (isBookWL && isCurrCNF && !isPrepared) {
                                        coachBerth = '<span style="color:#64748b; font-size:12px; font-weight:600;" title="Confirmed: Berth will be allotted at Chart Preparation">-- <small style="display:block; font-size:10px; color:#2563eb; font-weight:700;">(Allotted at Charting)</small></span>';
                                    } else if (p.seat && p.seat.trim() !== '') {
                                        coachBerth = `${p.seat} ${p.berth ? `(${p.berth})` : ''}`;
                                    } else if (p.bookingStatus === 'RAC' || p.currentStatus === 'RAC') {
                                        coachBerth = `RAC ${p.Position ? `(${p.Position})` : ''}`;
                                    } else if (p.bookingStatus === 'WL' || p.currentStatus === 'WL') {
                                        coachBerth = `WL ${p.Position ? `(${p.Position})` : ''}`;
                                    } else if (currUpper === 'CAN' || currUpper === 'CANCELLED') {
                                        coachBerth = 'Cancelled';
                                    }

                                    let mealBadge = '';
                                    if (p.meal && p.meal.trim() !== '') {
                                        mealBadge = `<div style="margin-top:4px;"><span style="display:inline-flex; align-items:center; gap:4px; font-size:11px; padding:2px 7px; border-radius:4px; background:#f0fdf4; color:#166534; border:1px solid #bbf7d0; font-weight:600;"><i class="fa-solid fa-utensils"></i> Meal: ${p.meal}</span></div>`;
                                    }

                                    const insuranceStatus = hasInsurance ? `Opted` : `--`;

                                    passengerRowsHtml += `
                                        <tr>
                                            <td>${idx + 1}</td>
                                            <td><strong>${p.name}</strong></td>
                                            <td>${p.age} / ${p.gender}</td>
                                            <td><span class="${bookColor}">${p.bookingStatus} ${p.Position ? `(${p.Position})` : ''}</span></td>
                                            <td><span class="${statusColor}">${p.currentStatus} ${p.Position ? `(${p.Position})` : ''}</span></td>
                                            <td>
                                                <strong>${coachBerth}</strong>
                                                ${mealBadge}
                                            </td>
                                            <td>${insuranceStatus}</td>
                                        </tr>
                                    `;
                                });
                            }

                            // 4. Render the Complete Dynamic Container
                            dynamicContainer.innerHTML = `
                                <!-- 1. Journey Departure / Duration / Arrival Banner -->
                                <div class="journey-schedule-banner">
                                    <div class="schedule-station-block">
                                        <div class="stn-time">${b.departure ? b.departure.substring(0, 5) : '--:--'}</div>
                                        <div class="stn-date">${b.journeyDate}</div>
                                        <div class="stn-name">${b.from}</div>
                                    </div>

