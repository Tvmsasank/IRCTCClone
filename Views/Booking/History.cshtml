        // ----------------------------------------------------
        let currentBpBookingId = null;
        let currentBpStationsData = [];

        function openBoardingModal(bookingId) {
            currentBpBookingId = bookingId;
            showLoader();
            fetch(`/Booking/GetBoardingStations?bookingId=${bookingId}`)
            .then(res => res.json())
            .then(data => {
                hideLoader();
                if (!data.success) {
                    showToast(data.message, "error");
                    return;
                }

                currentBpStationsData = data.stations || [];

                // Summary
                document.getElementById("bpTripSummary").innerHTML = `
                    <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                        <span><b>PNR:</b> <span style="color:#0284c7; font-weight:700;">${data.pnr}</span></span>
                        <span><b>Date:</b> ${data.journeyDate}</span>
                    </div>
                    <div style="margin-bottom:6px;">
                        <b>Train:</b> ${data.trainNo} - ${data.trainName}
                    </div>
                    <div style="display:flex; justify-content:space-between; color:#475569; font-size:12.5px;">
                        <span>Current Boarding: <strong style="color:#dc2626;">${data.currentBoarding}</strong> (${data.currentDeparture} hrs)</span>
                        <span>Destination: <strong>${data.destination}</strong></span>
                    </div>
                `;

                // Populate stations dropdown
                const select = document.getElementById("bpStationSelect");
                select.innerHTML = '<option value="">-- Choose New Boarding Station --</option>';

                let eligibleCount = 0;
                currentBpStationsData.forEach(st => {
                    const isCurrent = (st.stationName || '').trim().toLowerCase() === (data.currentBoarding || '').trim().toLowerCase();
                    const isDest = (st.stationName || '').trim().toLowerCase() === (data.destination || '').trim().toLowerCase();

                    if (!isCurrent && !isDest) {
                        const opt = document.createElement("option");
                        opt.value = st.stationName;
                        opt.dataset.departure = st.departureTime || '';
                        opt.dataset.day = st.dayNumber || '1';
                        opt.textContent = `${st.stationName} (Dep: ${st.departureTime || '--:--'} hrs, Day ${st.dayNumber || '1'})`;
                        select.appendChild(opt);
                        eligibleCount++;
                    }
                });

                if (eligibleCount === 0) {
                    select.innerHTML = '<option value="">No other intermediate stations available</option>';
                    document.getElementById("bpConfirmBtn").disabled = true;
                } else {
                    document.getElementById("bpConfirmBtn").disabled = false;
                }

                select.onchange = function() {
                    const selectedOpt = select.options[select.selectedIndex];
                    const dep = selectedOpt ? selectedOpt.dataset.departure : '';
                    const notice = document.getElementById("bpNewTimeNotice");
                    if (dep) {
                        notice.innerHTML = `<i class="fa-solid fa-clock"></i> New Departure Time: <strong>${dep} hrs</strong>`;
                    } else {
                        notice.innerHTML = '';
                    }
                };

                document.getElementById("bpNewTimeNotice").innerHTML = '';
                document.getElementById("boardingPointModal").style.display = "flex";
            })
            .catch(err => {
                hideLoader();
                console.error(err);
                showToast("Failed to load boarding stations. Please try again.", "error");
            });
        }

        function closeBoardingModal() {
            document.getElementById("boardingPointModal").style.display = "none";
        }

        function confirmBoardingChange() {
            const select = document.getElementById("bpStationSelect");
            const newStation = select.value;
            if (!newStation) {
                showToast("Please select a new boarding station.", "error");
                return;
            }

            const selectedOpt = select.options[select.selectedIndex];
            const depTime = selectedOpt ? selectedOpt.dataset.departure : '';

            if (!confirm(`Are you sure you want to change your boarding station to ${newStation}? As per IRCTC rules, this can only be done ONCE.`)) {
                return;
            }

            showLoader();
            fetch('/Booking/ChangeBoardingPoint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    bookingId: currentBpBookingId,
                    newStation: newStation,
                    departureTime: depTime
                })
            })
            .then(res => res.json())
            .then(data => {
                hideLoader();
                if (data.success) {
                    closeBoardingModal();
                    showToast(data.message, "success");
                    setTimeout(() => {
                        safeReload();
                    }, 800);
                } else {
                    showToast(data.message || "Failed to change boarding point.", "error");
                }
            })
            .catch(err => {
                hideLoader();
                console.error(err);
                showToast("Error processing boarding point change.", "error");
            });
        }

        function checkPnrStatusLive(pnr, bookingId, btn) {
            const modal = document.getElementById('pnrLiveStatusModal');
            const subtitle = document.getElementById('pnrModalPnrSubtitle');
            const body = document.getElementById('pnrModalBody');

            if (modal) modal.style.display = 'flex';
            if (subtitle) subtitle.textContent = `PNR: ${pnr}`;
            if (body) {
                body.innerHTML = `
                    <div style="text-align: center; padding: 30px; color: #64748b;">
                        <i class="fa-solid fa-spinner fa-spin fs-2 text-primary"></i>
                        <p class="mt-2 mb-0">Querying live reservation status from PRS...</p>
                    </div>`;
            }

            let origHtml = '';
            if (btn) {
                origHtml = btn.innerHTML;
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Checking...`;
                btn.disabled = true;
            }

            fetch(`/Booking/GetPnrStatusDetails?pnr=${encodeURIComponent(pnr)}&bookingId=${bookingId}`)
                .then(res => res.json())
                .then(data => {
                    if (btn) {
                        btn.innerHTML = origHtml;
                        btn.disabled = false;
                    }

                    if (!data || !data.success) {
                        if (body) {
                            body.innerHTML = `
                                <div style="padding: 20px; text-align: center; color: #ef4444;">
                                    <i class="fa-solid fa-circle-exclamation fs-2 mb-2"></i>
                                    <p>${(data && data.message) || 'Unable to retrieve PNR status at this moment.'}</p>
                                </div>`;
                        }
                        return;
                    }

                    showToast(`PNR ${pnr} status refreshed successfully!`, "success");

                    let chartBadge = data.isChartPrepared
                        ? `<span style="background:#dcfce7; color:#15803d; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700;"><i class="fa-solid fa-circle-check me-1"></i> Chart Prepared</span>`
                        : `<span style="background:#fef3c7; color:#92400e; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700;"><i class="fa-solid fa-clock me-1"></i> Chart Not Prepared</span>`;

                    let paxRows = '';
                    (data.passengers || []).forEach((p, idx) => {
                        let coachBerth = '--';
                        let isBookWL = (p.bookingStatus || '').toUpperCase().includes('WL') || (p.bookingStatus || '').toUpperCase().includes('WAIT');
                        let isCurrCNF = (p.currentStatus || '').toUpperCase() === 'CNF' || (p.currentStatus || '').toUpperCase() === 'CONFIRMED';

                        if (isBookWL && isCurrCNF && !data.isChartPrepared) {
                            coachBerth = '<span style="color:#64748b; font-size:11.5px; font-weight:600;" title="Confirmed: Berth will be allotted at Chart Preparation">-- <small style="display:block; font-size:10px; color:#2563eb; font-weight:700;">(Allotted at Charting)</small></span>';
                        } else if (p.seat && p.seat.trim() !== '') {
                            coachBerth = `${p.seat} ${p.berth ? `(${p.berth})` : ''}`;
                        } else if (p.currentStatus === 'RAC' || p.bookingStatus === 'RAC') {
                            coachBerth = `RAC ${p.position ? `(${p.position})` : ''}`;
                        } else if (p.currentStatus === 'WL' || p.bookingStatus === 'WL') {
                            coachBerth = `WL ${p.position ? `(${p.position})` : ''}`;
                        }

                        let cnfColor = (p.currentStatus === 'CNF' || p.currentStatus === 'CONFIRMED') ? '#15803d' : (p.currentStatus === 'RAC' ? '#ea580c' : '#dc2626');

                        paxRows += `
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 10px 12px; font-weight: 600; color: #64748b;">${idx + 1}</td>
                                <td style="padding: 10px 12px; font-weight: 700; color: #1e293b;">${p.name} <small style="color:#64748b; font-weight:400;">(${p.age}/${p.gender})</small></td>
                                <td style="padding: 10px 12px;"><span style="background:#f1f5f9; color:#334155; padding:3px 8px; border-radius:4px; font-weight:700; font-size:12px;">${p.bookingStatus}</span></td>
                                <td style="padding: 10px 12px;"><span style="color:${cnfColor}; font-weight:800; font-size:13px;">${p.currentStatus}</span></td>
                                <td style="padding: 10px 12px; font-weight: 700; color: #1e3a8a;">${coachBerth}</td>
                            </tr>`;
                    });

                    body.innerHTML = `
                        <!-- Train & Journey Strip -->
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px 16px; margin-bottom:16px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                                <div>
                                    <div style="font-weight:800; font-size:15px; color:#1e3a8a;">
                                        <i class="fa-solid fa-train me-1"></i> ${data.trainNumber} / ${data.trainName}
                                    </div>
                                    <div style="font-size:13px; color:#64748b; margin-top:2px;">
                                        <span>Class: <strong>${data.classCode}</strong></span>
                                        <span style="margin:0 6px;">•</span>
                                        <span>Quota: <strong>${data.quota}</strong></span>
                                        <span style="margin:0 6px;">•</span>
                                        <span>Date: <strong>${data.journeyDate}</strong></span>
                                    </div>
                                </div>
                                <div>
                                    ${chartBadge}
                                </div>
                            </div>
                            <div style="margin-top:10px; padding-top:10px; border-top:1px dashed #cbd5e1; font-size:13px; color:#334155; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                                <div><strong>From / Boarding:</strong> ${data.from} (${data.departure || '--:--'} hrs.)</div>
                                <div><strong>To:</strong> ${data.to} (${data.arrival || '--:--'} hrs.)</div>
                            </div>
                        </div>

                        <!-- Passenger Status Table -->
                        <div style="margin-bottom:10px;">
                            <div style="font-weight:700; color:#1e293b; font-size:14px; margin-bottom:8px;">
                                <i class="fa-solid fa-users text-primary me-1"></i> Passenger Live Status
                            </div>
                            <div style="overflow-x:auto;">
                                <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                    <thead>
                                        <tr style="background:#f1f5f9; color:#475569; text-align:left;">
                                            <th style="padding:8px 12px; border-radius:6px 0 0 6px;">#</th>
                                            <th style="padding:8px 12px;">Passenger</th>
                                            <th style="padding:8px 12px;">Booking Status</th>
                                            <th style="padding:8px 12px;">Current Status</th>
                                            <th style="padding:8px 12px; border-radius:0 6px 6px 0;">Coach & Berth</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${paxRows || '<tr><td colspan="5" style="text-align:center; padding:12px; color:#94a3b8;">No passenger records.</td></tr>'}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    `;
                })
                .catch(err => {
                    if (btn) {
                        btn.innerHTML = origHtml;
                        btn.disabled = false;
                    }
                    if (body) {
                        body.innerHTML = `
                            <div style="padding: 20px; text-align: center; color: #ef4444;">
                                <i class="fa-solid fa-circle-exclamation fs-2 mb-2"></i>
                                <p>Error connecting to PRS server. Please try again.</p>
                            </div>`;
                    }
                });
        }

        function closePnrStatusModal() {
            const modal = document.getElementById('pnrLiveStatusModal');
            if (modal) modal.style.display = 'none';
        }

    </script>
}

