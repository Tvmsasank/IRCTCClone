@model IRCTCClone.Models.Booking

@{
    ViewData["Title"] = "Booking Confirmation";
}

@{
    var successMessage = TempData["BookingSuccess"] as string;
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: "success",
                title: "Booking Successful!",
                text: "@successMessage",
                confirmButtonText: "OK",
                confirmButtonColor: "#3085d6",
                timer: 7000,
                timerProgressBar: true
            });
        });
    </script>
}

<div class="booking-confirmation">

    <h2 class="confirmation-title">🎟️ Booking Confirmation</h2>

    <div class="booking-info-wrapper">

        <!-- LEFT SIDE : JOURNEY DETAILS -->
        <div class="journey-info">

            <p><strong>PNR:</strong> @Model.PNR</p>
            <p><strong>Train:</strong> @Model.TrainNumber - @Model.TrainName</p>
            <p><strong>From:</strong> @Model.Frmst (@Model.FromStationCode)</p>
            <p><strong>To:</strong> @Model.Tost (@Model.ToStationCode)</p>
            <p><strong>Journey Date:</strong> @Model.JourneyDate.ToString("dd-MM-yyyy")</p>

            @if (Model.Train != null && Model.JourneyDate != null)
            {
                var departureDateTime = Model.JourneyDate.Date + Model.Train.Departure;
                <p><strong>Departure:</strong> @departureDateTime.ToString("dd-MM-yyyy HH:mm")</p>
            }

            <p><strong>Class:</strong> @Model.ClassCode</p>

            <p>
                <strong>Status:</strong>
                <span class="status">@Model.Status</span>
            </p>

        </div>

        <!-- RIGHT SIDE : FARE -->
        <div class="fare-box">

            <h4>💰 Fare Breakdown</h4>

            <p><strong>Base Fare:</strong> ₹@Model.BaseFare</p>
            <p><strong>Quota:</strong> @Model.Quota</p>
            <p><strong>Convenience Fee:</strong> ₹@(Model.GST + 20.00m)</p>
            <p><strong>Travel Insurance:</strong> ₹0.45</p>

            @if (Model.QuotaCharge != 0)
            {
                <p><strong>Quota Charge:</strong> ₹@Model.QuotaCharge</p>
            }

            <p><strong>Surge Charge:</strong> ₹@Model.SurgeAmount</p>

            <p class="total-fare">
                <strong>Total Fare:</strong> ₹@Model.TotalFare
            </p>

        </div>

    </div>


    <!-- BUTTONS -->
    <div class="ticket-actions-confirmation">

        <a href="/Booking/DownloadTicket/@Model.Id"
           class="btn-ticket download btn-download">
            📄 Download E-Ticket
        </a>

        <a href="/Booking/History"
           class="btn-ticket view">
            📂 View My Bookings
        </a>

    </div>

    <!-- PASSENGERS -->
    <h3 class="passenger-heading">👥 Details of Passengers</h3>

    <table class="table table-bordered passenger-table">
        <thead>
            <tr>
                <th>Sl. No</th>
                <th>Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Status</th>
                <th>Coach</th>
                <th>Seat / Berth</th>
                <th>Current Status</th>
            </tr>
        </thead>

        <tbody>
            @{
                int index = 1;
            }

            @foreach (var item in Model.Passengers)
            {
                string coach = "--";
                string seat = "--";

                if (item.BookingStatus == "CNF" && !string.IsNullOrEmpty(item.SeatNumber))
                {
                    if (item.SeatNumber.Contains("-"))
                    {
                        var parts = item.SeatNumber.Split('-');
                        coach = parts[0];
                        seat = parts[1];
                    }
                    else
                    {
                        coach = item.SeatPrefix ?? "--";
                        seat = item.SeatNumber;
                    }
                }

                <tr>
                    <td>@index</td>
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                    <td>@item.Gender</td>
                    <td>
                        <span class="status-badge @item.BookingStatus">
                            @item.BookingStatus
                        </span>
                    </td>
                    <td>@coach</td>
                    <td>@seat</td>
                    <td>@item.BookingStatus</td>
                </tr>

                index++;
            }
        </tbody>
    </table>
</div>


<style>

    .ticket-actions-confirmation a {
        display: inline-flex;
        align-items: center;
    }

    .booking-confirmation {
        background: #f8f9fa;
        padding: 25px;
        border-radius: 10px;
    }

    .ticket-actions-confirmation {
        display: flex;
        gap: 15px;
        margin: 20px 0;
        justify-content: flex-end;
    }
    .btn-ticket {
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: 0.2s;
    }

    .download {
        background: #0078d7;
        color: white;
    }

        .download:hover {
            background: #005fa3;
        }

    .view {
        background: #f1f3f5;
        color: #333;
        border: 1px solid #ddd;
    }

        .view:hover {
            background: #e2e6ea;
        }
    .status-badge {
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: bold;
    }

    .CNF {
        background: #d4edda;
        color: #155724;
    }

    .RAC {
        background: #fff3cd;
        color: #856404;
    }

    .WL {
        background: #f8d7da;
        color: #721c24;
    }

    .booking-info-wrapper {
        display: flex;
        justify-content: space-between;
        gap: 40px;
        background: #f8f9fa;
        padding: 25px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .journey-info {
        width: 55%;
        font-size: 15px;
        line-height: 1.7;
    }

    .fare-box {
        width: 35%;
        background: white;
        border-radius: 8px;
        padding: 15px 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .fare-box p {
            margin: 4px 0;
        }

    .total-fare {
        margin-top: 10px;
        font-size: 16px;
        color: #0078d7;
    }

    .status {
        font-weight: bold;
        color: green;
    }

    .passenger-heading {
        margin-top: 20px;
    }

    .passenger-table {
        margin-top: 10px;
        font-size: 14px;
        background: #fff;
    }

        .passenger-table thead {
            background: #dce9f9;
            color: #003366;
        }

        .passenger-table th,
        .passenger-table td {
            text-align: center;
            padding: 8px;
        }</style>
