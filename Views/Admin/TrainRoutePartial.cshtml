@model IEnumerable<IRCTCClone.Models.TrainRoute>

@functions {
    static readonly Dictionary<string, string> StationClusters = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        // Hyderabad / Secunderabad
        { "SC", "HYD" }, { "SECUNDERABAD", "HYD" }, { "SECUNDERABAD JN", "HYD" },
        { "HYB", "HYD" }, { "HYDERABAD", "HYD" }, { "HYDERABAD DECCAN", "HYD" },
        { "KCG", "HYD" }, { "KACHEGUDA", "HYD" },
        { "LPI", "HYD" }, { "LINGAMPALLI", "HYD" },
        { "BMT", "HYD" }, { "BEGAMPET", "HYD" },
        { "CHZ", "HYD" }, { "CHARLAPALLI", "HYD" },

        // Visakhapatnam
        { "VSKP", "VIZAG" }, { "VISAKHAPATNAM", "VIZAG" },
        { "DVD", "VIZAG" }, { "DUVVADA", "VIZAG" },
        { "SCM", "VIZAG" }, { "SIMHACHALAM", "VIZAG" },

        // Delhi
        { "NDLS", "DELHI" }, { "NEW DELHI", "DELHI" },
        { "DLI", "DELHI" }, { "DELHI", "DELHI" }, { "OLD DELHI", "DELHI" },
        { "NZM", "DELHI" }, { "HAZRAT NIZAMUDDIN", "DELHI" },
        { "ANVT", "DELHI" }, { "ANAND VIHAR", "DELHI" }, { "ANAND VIHAR TERMINAL", "DELHI" },
        { "DEE", "DELHI" }, { "DELHI SARAI ROHILLA", "DELHI" },

        // Mumbai
        { "CSMT", "MUMBAI" }, { "C SHIVAJI MAH T", "MUMBAI" }, { "MUMBAI CST", "MUMBAI" },
        { "DR", "MUMBAI" }, { "DADAR", "MUMBAI" },
        { "MMCT", "MUMBAI" }, { "MUMBAI CENTRAL", "MUMBAI" },
        { "BDTS", "MUMBAI" }, { "BANDRA TERMINUS", "MUMBAI" },
        { "LTT", "MUMBAI" }, { "LOKMANYA TILAK T", "MUMBAI" },
        { "TNA", "MUMBAI" }, { "THANE", "MUMBAI" },
        { "KYN", "MUMBAI" }, { "KALYAN", "MUMBAI" }, { "KALYAN JN", "MUMBAI" },

        // Bangalore
        { "SBC", "BLR" }, { "KSR BENGALURU", "BLR" }, { "BANGALORE CITY", "BLR" },
        { "YPR", "BLR" }, { "YESVANTPUR", "BLR" },
        { "SMVB", "BLR" }, { "SMVT BENGALURU", "BLR" },
        { "BNC", "BLR" }, { "BANGALORE CANT", "BLR" },

        // Chennai
        { "MAS", "CHENNAI" }, { "CHENNAI CENTRAL", "CHENNAI" }, { "MGR CHENNAI CENTRAL", "CHENNAI" },
        { "MS", "CHENNAI" }, { "CHENNAI EGMORE", "CHENNAI" },
        { "TBM", "CHENNAI" }, { "TAMBARAM", "CHENNAI" },

        // Kolkata
        { "HWH", "KOLKATA" }, { "HOWRAH", "KOLKATA" }, { "HOWRAH JN", "KOLKATA" },
        { "SDAH", "KOLKATA" }, { "SEALDAH", "KOLKATA" },
        { "KOAA", "KOLKATA" }, { "KOLKATA", "KOLKATA" },
        { "SHM", "KOLKATA" }, { "SHALIMAR", "KOLKATA" },
        { "SRC", "KOLKATA" }, { "SANTRAGACHI", "KOLKATA" }
    };

    string Normalize(string? str)
    {
        if (string.IsNullOrWhiteSpace(str)) return "";
        var sb = new System.Text.StringBuilder();
        foreach (char c in str.ToUpperInvariant())
        {
            if (char.IsLetterOrDigit(c) || char.IsWhiteSpace(c))
                sb.Append(c);
            else if (c == '-')
                sb.Append(' ');
        }
        return string.Join(" ", sb.ToString().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries));
    }

    int MatchStationScore(IRCTCClone.Models.Station? s, string? query)
    {
        if (s == null || string.IsNullOrWhiteSpace(query)) return 0;
        string q = query.Trim().ToUpperInvariant();
        string sCode = (s.Code ?? "").Trim().ToUpperInvariant();
        string sName = (s.Name ?? "").Trim().ToUpperInvariant();

        string qName = q;
        string qCode = "";

        if (q.Contains("-"))
        {
            var parts = q.Split(new[] { '-' }, StringSplitOptions.RemoveEmptyEntries).Select(p => p.Trim()).ToArray();
            if (parts.Length >= 2)
            {
                if (parts[1].Length <= 5 && !parts[1].Contains(" "))
                {
                    qName = parts[0];
                    qCode = parts[1];
                }
                else if (parts[0].Length <= 5 && !parts[0].Contains(" "))
                {
                    qCode = parts[0];
                    qName = parts[1];
                }
            }
        }
        else if (q.Length <= 5 && !q.Contains(" "))
        {
            qCode = q;
        }

        // Tier 1: Exact code match (e.g. SC == SC, VSKP == VSKP)
        if (!string.IsNullOrEmpty(qCode) && !string.IsNullOrEmpty(sCode) && sCode == qCode)
            return 1000;

        // Tier 2: Exact full name match
        string normQueryName = Normalize(qName);
        string normStnName = Normalize(sName);
        if (!string.IsNullOrEmpty(normQueryName) && normStnName == normQueryName)
            return 900;

        // Tier 3: Clean name without common rail suffixes
        string cleanQuery = normQueryName.Replace(" JUNCTION", "").Replace(" JN", "").Replace(" TERMINUS", "").Replace(" TERM", "").Replace(" CANTT", "").Replace(" ROAD", "").Replace(" RD", "").Trim();
        string cleanStn = normStnName.Replace(" JUNCTION", "").Replace(" JN", "").Replace(" TERMINUS", "").Replace(" TERM", "").Replace(" CANTT", "").Replace(" ROAD", "").Replace(" RD", "").Trim();
        if (!string.IsNullOrEmpty(cleanQuery) && cleanQuery.Length >= 3 && cleanStn == cleanQuery)
            return 800;

        // Tier 4: Exact word boundary match (all words in query exist in station name)
        var queryWords = cleanQuery.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        var stnWords = cleanStn.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (queryWords.Length > 0 && stnWords.Length > 0)
        {
            if (queryWords.All(qw => qw.Length >= 3 && stnWords.Contains(qw)))
                return 700;
            if (stnWords.All(sw => sw.Length >= 3 && queryWords.Contains(sw)))
                return 600;
        }

        // Tier 5: Nearby / Cluster Station Match (e.g. Visakhapatnam cluster: VSKP <-> DVD, Hyderabad cluster: SC <-> HYB/KCG/LPI)
        string? qCluster = null;
        if (!string.IsNullOrEmpty(qCode) && StationClusters.TryGetValue(qCode, out var c1)) qCluster = c1;
        else if (!string.IsNullOrEmpty(cleanQuery) && StationClusters.TryGetValue(cleanQuery, out var c2)) qCluster = c2;

        if (!string.IsNullOrEmpty(qCluster))
        {
            if (!string.IsNullOrEmpty(sCode) && StationClusters.TryGetValue(sCode, out var sc1) && sc1 == qCluster)
                return 500;
            if (!string.IsNullOrEmpty(cleanStn) && StationClusters.TryGetValue(cleanStn, out var sc2) && sc2 == qCluster)
                return 500;
        }

        return 0;
    }
}

@if (Model == null || !Model.Any())
{
    <div class="schedule-modal-wrapper">
        <div class="schedule-top-title-bar">
            <div class="top-title-left">
                <i class="bi bi-calendar3 text-primary me-2"></i>
                <span class="top-title-main">Train Schedule</span>
                <span class="top-title-badge">Official Route Timetable</span>
            </div>
            <button type="button" class="btn-schedule-close" id="closeScheduleModal" title="Close (Esc)">&times;</button>
        </div>
        <div class="schedule-empty-state">
            <i class="bi bi-exclamation-circle text-muted" style="font-size: 2.5rem; display: block; margin-bottom: 10px;"></i>
            <span style="font-size: 1rem; font-weight: 600; color: #475569;">No route timetable details available for this train.</span>
        </div>
    </div>
}
else
{
    var routeList = Model.Where(r => !r.IsSkipped).OrderBy(r => r.StopNumber).ToList();
    if (!routeList.Any())
    {
        routeList = Model.OrderBy(r => r.StopNumber).ToList();
    }
    for (int i = 0; i < routeList.Count; i++)
    {
        routeList[i].StopNumber = i + 1;
    }
    var firstStop = routeList.FirstOrDefault();
    var lastStop = routeList.LastOrDefault();

    int totalStops = routeList.Count;

    string originStation = firstStop?.Station?.Name ?? "ORIGIN";
    string originCode = firstStop?.Station?.Code ?? "";
    string destStation = lastStop?.Station?.Name ?? "DESTINATION";
    string destCode = lastStop?.Station?.Code ?? "";

    // 1. Train's Total Journey Duration (Origin to Destination)
    int totalMinutes = 0;
    if (firstStop != null && lastStop != null)
    {
        int dayDiff = (lastStop.Day >= firstStop.Day) ? (lastStop.Day - firstStop.Day) : 0;
        var dep = firstStop.DepartureTime ?? TimeSpan.Zero;
        var arr = lastStop.ArrivalTime ?? TimeSpan.Zero;
        totalMinutes = (dayDiff * 24 * 60) + (int)(arr.TotalMinutes - dep.TotalMinutes);
        if (totalMinutes < 0) totalMinutes += 24 * 60;
    }

    int hrs = totalMinutes / 60;
    int mins = totalMinutes % 60;
    string totalJourneyTimeStr = $"{hrs} hrs {(mins > 0 ? mins + " mins" : "00 mins")}";

    var trainNumber = ViewBag.TrainNumber != null ? ViewBag.TrainNumber.ToString() : "";
    var trainName = ViewBag.TrainName as string ?? "";

    var fromStation = ViewBag.FromStation as string;
    var toStation = ViewBag.ToStation as string;

    // 2. User's Searched Journey Duration & Stops (Strictly 1 Boarding and 1 Destination in forward route order)
    var boardingCandidates = routeList
        .Select(r => new { Route = r, Score = MatchStationScore(r.Station, fromStation) })
        .Where(x => x.Score > 0)
        .OrderByDescending(x => x.Score)
        .ToList();

    var destCandidates = routeList
        .Select(r => new { Route = r, Score = MatchStationScore(r.Station, toStation) })
        .Where(x => x.Score > 0)
        .OrderByDescending(x => x.Score)
        .ToList();

    IRCTCClone.Models.TrainRoute? userBoardingStop = null;
    IRCTCClone.Models.TrainRoute? userDestStop = null;

    if (boardingCandidates.Any() && destCandidates.Any())
    {
        var bestPair = (from b in boardingCandidates
                        from d in destCandidates
                        where d.Route.StopNumber > b.Route.StopNumber
                        orderby (b.Score + d.Score) descending, b.Route.StopNumber ascending
                        select new { Boarding = b.Route, Dest = d.Route })
                        .FirstOrDefault();

        if (bestPair != null)
        {
            userBoardingStop = bestPair.Boarding;
            userDestStop = bestPair.Dest;
        }
        else
        {
            userBoardingStop = boardingCandidates.First().Route;
            userDestStop = destCandidates.First().Route;
        }
    }
    else if (boardingCandidates.Any())
    {
        userBoardingStop = boardingCandidates.First().Route;
    }
    else if (destCandidates.Any())
    {
        userDestStop = destCandidates.First().Route;
    }

    bool hasUserSegment = userBoardingStop != null && userDestStop != null && userDestStop.StopNumber > userBoardingStop.StopNumber;
    int userStationsCount = 0;
    string userJourneyTimeStr = "--";
    string userBoardingCode = userBoardingStop?.Station?.Code ?? "";
    string userBoardingName = userBoardingStop?.Station?.Name ?? fromStation ?? "";
    string userDestCode = userDestStop?.Station?.Code ?? "";
    string userDestName = userDestStop?.Station?.Name ?? toStation ?? "";

    if (hasUserSegment)
    {
        userBoardingCode = userBoardingStop?.Station?.Code ?? "";
        userBoardingName = userBoardingStop?.Station?.Name ?? fromStation ?? "";
        userDestCode = userDestStop?.Station?.Code ?? "";
        userDestName = userDestStop?.Station?.Name ?? toStation ?? "";
        userStationsCount = (userDestStop.StopNumber - userBoardingStop.StopNumber) + 1;

        int userDayDiff = (userDestStop.Day >= userBoardingStop.Day) ? (userDestStop.Day - userBoardingStop.Day) : 0;
        var userDep = userBoardingStop.DepartureTime ?? userBoardingStop.ArrivalTime ?? TimeSpan.Zero;
        var userArr = userDestStop.ArrivalTime ?? userDestStop.DepartureTime ?? TimeSpan.Zero;
        int userTotalMinutes = (userDayDiff * 24 * 60) + (int)(userArr.TotalMinutes - userDep.TotalMinutes);
        if (userTotalMinutes < 0) userTotalMinutes += 24 * 60;

        int uh = userTotalMinutes / 60;
        int um = userTotalMinutes % 60;
        userJourneyTimeStr = $"{uh} hrs {(um > 0 ? um + " mins" : "00 mins")}";
    }

    var runsOnStr = (ViewBag.RunsOn as string ?? "-------").Trim().Replace(" ", "");
    if (runsOnStr.Length < 7) { runsOnStr = runsOnStr.PadRight(7, '-'); }
    var dayLabels = new[] { "M", "T", "W", "T", "F", "S", "S" };
    var dayNames = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    bool[] isActiveDay = new bool[7];
    for (int i = 0; i < 7; i++)
    {
        char c = runsOnStr[i];
        isActiveDay[i] = (c != '-' && c != '0' && c != 'N' && c != 'n' && c != ' ');
    }

    <div class="schedule-modal-wrapper">
        <!-- 🖥️ Desktop Schedule View (> 768px) -->
        <div class="desktop-schedule-view">
            <!-- 🏷️ 1. Top Header: "Train Schedule" Title + Close Button -->
            <div class="schedule-top-title-bar">
                <div class="top-title-left">
                    <i class="bi bi-calendar3 text-primary me-2 fs-5"></i>
                    <span class="top-title-main">Train Schedule</span>
                    <span class="top-title-badge">Official Route Timetable</span>
                </div>
                <button type="button" class="btn-schedule-close" id="closeScheduleModal" title="Close (Esc)">&times;</button>
            </div>

            <!-- 🚆 2. Blue Train Banner: Train Number, Train Name, and TRAIN'S Origin & Destination -->
            <div class="schedule-train-banner">
            <div class="train-main-info">
                @if (!string.IsNullOrEmpty(trainNumber))
                {
                    <span class="train-number-pill">@trainNumber</span>
                }
                <span class="train-name-heading">@trainName</span>

                <!-- Displays TRAIN'S True Origin & Destination (not user's search) -->
                <div class="journey-segment-pill" title="Train Origin & Terminus">
                    <span class="segment-station origin">
                        @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(originCode + " " + originStation, "18px")
                        <i class="bi bi-geo-alt-fill text-danger" style="margin-right: 6px;"></i> @originStation
                    </span>
                    <i class="bi bi-arrow-right segment-arrow" style="margin: 0 4px;"></i>
                    <span class="segment-station dest">
                        @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(destCode + " " + destStation, "18px")
                        <i class="bi bi-geo-alt-fill text-success" style="margin-right: 6px;"></i> @destStation
                    </span>
                </div>
            </div>
        </div>

        <!-- 📊 3. Meta Row: Runs On, Total Stops, Total Journey Time, Your Journey Time & Extreme-Right Search -->
        <div class="schedule-meta-bar">
            <!-- Runs on -->
            <div class="meta-item meta-runs">
                <span class="meta-label">Runs On:</span>
                <div class="runs-chips-strip">
                    @for (int i = 0; i < 7; i++)
                    {
                        <span class="run-day-chip @(isActiveDay[i] ? "active" : "inactive")" title="@dayNames[i]: @(isActiveDay[i] ? "Operational" : "Not Operating")">
                            @dayLabels[i]
                        </span>
                    }
                </div>
            </div>

            <div class="meta-separator"></div>

            <!-- Total Stops -->
            <div class="meta-item meta-stops">
                <span class="meta-label">Total Stops</span>
                <div class="meta-value">
                    <span class="stops-highlight">@totalStops</span>
                    <span class="stops-text">Stops</span>
                </div>
            </div>

            <div class="meta-separator"></div>

            <!-- Total Journey Time (Train's Full Journey: Origin to Destination) -->
            <div class="meta-item meta-duration">
                <span class="meta-label">Total Journey Time</span>
                <div class="duration-highlight">
                    <i class="bi bi-clock-history text-secondary"></i>
                    <span class="duration-text">@totalJourneyTimeStr</span>
                </div>
                <div class="orig-dest-subtitle" title="Train Origin - Destination">
                    @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(originCode + " " + originStation, "14px")
                    <span>@(originStation)</span> - 
                    @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(destCode + " " + destStation, "14px")
                    <span>@(destStation)</span>
                </div>
            </div>

            <div class="meta-separator"></div>

            <!-- 👤 Your Journey Time (User's Searched Boarding to Destination) -->
            <div class="meta-item meta-user-journey">
                <span class="meta-label label-user-journey"><i class="bi bi-person-badge-fill me-1"></i>Your Journey Time</span>
                <div class="duration-highlight text-primary">
                    <i class="bi bi-stopwatch-fill text-primary"></i>
                    <span class="duration-text">@userJourneyTimeStr</span>
                </div>
                <div class="orig-dest-subtitle user-segment-sub" title="Your Boarding - Destination">
                    @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(userBoardingCode + " " + userBoardingName, "15px")
                    <span>@(userBoardingName)</span> - 
                    @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(userDestCode + " " + userDestName, "15px")
                    <span>@(userDestName)</span>
                </div>
            </div>

            <!-- 🔍 Quick Station Filter - Positioned at Extreme Right -->
            <div class="meta-item meta-search ms-auto">
                <div class="schedule-search-input-wrap">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" id="routeStationSearch" placeholder="Search station or code..." autocomplete="off" />
                    <button type="button" id="clearStationSearch" class="btn-clear-station-search" style="display:none;">&times;</button>
                </div>
            </div>
        </div>

        <!-- 📋 4. Constant Height Timetable Table Container -->
        <div class="schedule-table-container">
            <table class="schedule-table" id="scheduleTable">
                <thead>
                    <tr>
                        <th class="col-sno text-center">S.No</th>
                        <th class="col-code">Station Code</th>
                        <th class="col-name">Station Name</th>
                        <th class="col-time text-center">Arrival</th>
                        <th class="col-time text-center">Departure</th>
                        <th class="col-dist text-center">Distance</th>
                        <th class="col-day text-center">Day</th>
                    </tr>
                </thead>
                <tbody id="scheduleTableBody">
                    @foreach (var route in routeList)
                    {
                        var isFirst = route.StopNumber == 1;
                        var isLast = route.DepartureTime == null || route.StopNumber == totalStops;
                        var stnCode = route.Station?.Code ?? "-";
                        var stnName = route.Station?.Name ?? "-";

                        bool isSearchFrom = (userBoardingStop != null && route.StopNumber == userBoardingStop.StopNumber);
                        bool isSearchTo = (userDestStop != null && route.StopNumber == userDestStop.StopNumber);

                        var searchData = $"{route.StopNumber} {stnCode} {stnName}".ToLower();

                        <tr class="route-table-row @(isSearchFrom ? "row-boarding" : "") @(isSearchTo ? "row-destination" : "")" data-search="@searchData">
                            <td class="col-sno text-center font-monospace">@route.StopNumber</td>
                            <td class="col-code">
                                <span class="station-code-badge">@stnCode</span>
                            </td>
                            <td class="col-name">
                                <span class="station-name-text">@stnName</span>
                                @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(stnCode + " " + stnName, "19px")
                                @if (route.IsTemporary)
                                {
                                    <span class="badge bg-success-subtle text-success" style="font-size: 11px; padding: 2px 7px; border: 1px solid #86efac; border-radius: 4px; margin-left: 6px;"><i class="bi bi-clock-history me-1"></i>Temporary Halt &bull; @(route.TemporaryReason ?? "Festival Season")</span>
                                }
                                @if (isSearchFrom)
                                {
                                    <span class="segment-indicator boarding-tag"><i class="bi bi-box-arrow-in-right"></i> Boarding</span>
                                }
                                @if (isSearchTo)
                                {
                                    <span class="segment-indicator dest-tag"><i class="bi bi-box-arrow-right"></i> Destination</span>
                                }
                            </td>
                            <td class="col-time text-center">
                                @if (isFirst || !route.ArrivalTime.HasValue)
                                {
                                    <span class="endpoint-time-badge">Starts</span>
                                }
                                else
                                {
                                    <span class="regular-time">@route.ArrivalTime.Value.ToString(@"hh\:mm")</span>
                                }
                            </td>
                            <td class="col-time text-center">
                                @if (isLast || !route.DepartureTime.HasValue)
                                {
                                    <span class="endpoint-time-badge">Ends</span>
                                }
                                else
                                {
                                    <span class="regular-time">@route.DepartureTime.Value.ToString(@"hh\:mm")</span>
                                }
                            </td>
                            <td class="col-dist text-center">
                                <span class="distance-text">@route.Distance km</span>
                            </td>
                            <td class="col-day text-center">
                                <span class="day-badge">Day @route.Day</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="noMatchingStations" class="no-matching-stations" style="display:none;">
                <i class="bi bi-search text-muted" style="font-size: 2.2rem; display: block; margin-bottom: 8px;"></i>
                <div style="font-weight: 600; color: #475569; font-size: 0.95rem;">No matching stations found</div>
                <div class="text-muted small mt-1">Try searching by another station name or code</div>
            </div>
        </div>

        <!-- 🏷️ 5. Footer Bar with Total Stations & User's Traveled Stops (Single Straight Line) -->
        <div class="schedule-footer-bar">
            <div class="footer-left">
                <span class="footer-count">
                    <i class="bi bi-pin-map-fill text-primary me-1"></i>
                    Showing <strong id="stationCountDisplay">@totalStops</strong> of @totalStops total stations
                </span>
                @if (hasUserSegment && userStationsCount > 0)
                {
                    <span class="footer-trip-separator">•</span>
                    <span class="footer-user-trip-badge">
                        <i class="bi bi-person-check-fill text-primary me-1"></i>
                        <span>Your Trip: <strong>@userStationsCount stations</strong> (@IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(userBoardingName, "15px")@userBoardingName <i class="bi bi-arrow-right text-primary mx-1"></i> @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(userDestName, "15px")@userDestName)</span>
                    </span>
                }
            </div>
            <div class="footer-right">
                <span class="text-muted small">Indian Railways Timetable &bull; Times in 24-hr IST</span>
            </div>
        </div>
    </div> <!-- End Desktop Schedule View -->

        <!-- 📱 Mobile Schedule View (<= 768px, matching official IRCTC media_1789705803551.jpg) -->
        <div class="mobile-schedule-view">
            <!-- Top Blue Title Bar -->
            <div class="m-schedule-header">
                <span class="m-schedule-title">Train Schedule</span>
                <button type="button" class="btn-schedule-close m-schedule-close" title="Close (Esc)">&times;</button>
            </div>

            <!-- Centered Train Info -->
            <div class="m-train-summary">
                <div class="m-train-name-num">@trainNumber - (@trainName)</div>
                <div class="m-train-endpoints">
                    <span>@originStation</span>
                    <i class="bi bi-arrow-right mx-1"></i>
                    <span>@destStation</span>
                </div>
                <div class="m-runs-strip">
                    @{
                        var dayShortLabels = new[] { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" };
                    }
                    @for (int i = 0; i < 7; i++)
                    {
                        <span class="m-run-chip @(isActiveDay[i] ? "m-chip-active" : "m-chip-inactive")">
                            @dayShortLabels[i]
                        </span>
                    }
                </div>
            </div>

            <!-- Clean 3-Column Stations List -->
            <div class="m-schedule-list-container">
                @foreach (var route in routeList)
                {
                    var isFirst = route.StopNumber == 1;
                    var isLast = route.DepartureTime == null || route.StopNumber == totalStops;
                    var stnCode = route.Station?.Code ?? "-";
                    var stnName = route.Station?.Name ?? "-";

                    bool isSearchFrom = (userBoardingStop != null && route.StopNumber == userBoardingStop.StopNumber);
                    bool isSearchTo = (userDestStop != null && route.StopNumber == userDestStop.StopNumber);

                    string arrStr = isFirst || !route.ArrivalTime.HasValue ? "N.A." : route.ArrivalTime.Value.ToString(@"hh\:mm");
                    string depStr = isLast || !route.DepartureTime.HasValue ? "N.A." : route.DepartureTime.Value.ToString(@"hh\:mm");

                    <div class="m-station-row @(isSearchFrom ? "m-row-boarding" : "") @(isSearchTo ? "m-row-destination" : "")">
                        <!-- Left: Station Code & Timings -->
                        <div class="m-stn-col-left">
                            <div class="m-stn-code">@stnCode</div>
                            <div class="m-stn-time">@arrStr - @depStr</div>
                        </div>

                        <!-- Middle: Station Name -->
                        <div class="m-stn-col-mid">
                            <div class="m-stn-name">
                                @stnName.ToUpperInvariant()
                                @if (route.IsTemporary)
                                {
                                    <span class="badge bg-success-subtle text-success" style="font-size: 10px; padding: 2px 6px; border: 1px solid #86efac; border-radius: 4px; margin-left: 4px; display:inline-block;"><i class="bi bi-clock-history me-1"></i>Temp Halt &bull; @(route.TemporaryReason ?? "Festival Season")</span>
                                }
                                @if (isSearchFrom)
                                {
                                    <span class="segment-indicator boarding-tag" style="display:inline-flex; margin-left:6px; font-size:0.7rem; padding:2px 6px;"><i class="bi bi-box-arrow-in-right"></i> Boarding</span>
                                }
                                @if (isSearchTo)
                                {
                                    <span class="segment-indicator dest-tag" style="display:inline-flex; margin-left:6px; font-size:0.7rem; padding:2px 6px;"><i class="bi bi-box-arrow-right"></i> Destination</span>
                                }
                            </div>
                        </div>

                        <!-- Right: Day & Circular Badge -->
                        <div class="m-stn-col-right">
                            <div class="m-day-label">Day</div>
                            <div class="m-day-circle">@route.Day</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

