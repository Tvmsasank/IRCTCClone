    <script>
        (function () {
            var $input = $("#routeStationSearch");
            var $clear = $("#clearStationSearch");
            var $empty = $("#noMatchingStations");
            var $countDisplay = $("#stationCountDisplay");
            
            // Fast cache of rows for lag-free 60fps search
            var cachedRows = [];
            var $rows = $("#scheduleTableBody tr");
            $rows.each(function () {
                cachedRows.push({
                    el: this,
                    text: $(this).data("search") || $(this).text().toLowerCase()
                });
            });

            $input.on("input", function () {
                var q = $(this).val().toLowerCase().trim();
                $clear.toggle(q.length > 0);

                var visibleCount = 0;
                for (var i = 0; i < cachedRows.length; i++) {
                    var item = cachedRows[i];
                    var isMatch = q.length === 0 || item.text.indexOf(q) !== -1;
                    item.el.style.display = isMatch ? "" : "none";
                    if (isMatch) visibleCount++;
                }

                $empty.toggle(visibleCount === 0);
                if ($countDisplay.length) {
                    $countDisplay.text(visibleCount);
                }
            });

            $clear.on("click", function () {
                $input.val("").trigger("input").focus();
            });
        })();
    </script>
