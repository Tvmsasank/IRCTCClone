@using IRCTCClone.Models
@model List<TrainRoute>

@{
    ViewBag.Title = "Add Train Route";
    var stations = ViewBag.Stations as List<Station> ?? new List<Station>();
    var routes = ViewBag.Routes as List<TrainRoute> ?? new List<TrainRoute>();
    var temporaryStops = ViewBag.TemporaryStops as List<TrainTemporaryStop> ?? new List<TrainTemporaryStop>();
    int trainId = ViewBag.TrainId;
}

@{
    var train = ViewBag.Train as Train;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

@{
    // Extract coach positions list
    var coachList = new List<string>();
    if (!string.IsNullOrWhiteSpace(train?.CoachPositions))
    {
        coachList = train.CoachPositions.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(c => c.Trim().ToUpper())
                                        .ToList();
    }
    else
    {
        coachList = new List<string> { "ENG", "GN", "GN", "H1", "A1", "A2", "B1", "B2", "B3", "M1", "SE1", "S1", "S2", "S3", "GN", "GN", "EOG" };
    }
    int totalDistance = routes.LastOrDefault()?.Distance ?? 799;
}

<!-- ✅ FLOATING SINGLE-LINE MINIMALIST STICKY STRIP (Revealed on Scroll Down) -->
<div id="stickyTrainStrip" class="sticky-train-strip">
    <div class="strip-container">
        <!-- Train Badge -->
        <div class="strip-train-info">
            <span class="strip-train-num"><i class="bi bi-train-front-fill me-1"></i> @train.Number</span>
            <span class="strip-train-name">@train.Name</span>
        </div>

        <div class="strip-separator"></div>

        <!-- From ➜ To -->
        <div class="strip-route-info">
            <span class="strip-station-name"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@train.FromStation?.Name</span>
            <span class="strip-time-badge">@train.Departure.ToString(@"hh\:mm")</span>
            <i class="bi bi-arrow-right strip-route-arrow"></i>
            <span class="strip-station-name"><i class="bi bi-geo-alt text-success me-1"></i>@train.ToStation?.Name</span>
            <span class="strip-time-badge">@train.Arrival.ToString(@"hh\:mm")</span>
        </div>

        <div class="strip-separator"></div>

        <!-- Meta Details (Distance & Journey Time) in a Single Line -->
        <div class="strip-meta-info">
            <span class="strip-meta-pill"><i class="bi bi-speedometer2 text-primary me-1"></i> @totalDistance km</span>
            <span class="strip-meta-pill"><i class="bi bi-clock-history text-info me-1"></i> @train.Duration</span>
            <span class="strip-meta-pill strip-coach-pill"><i class="bi bi-grid-3x2-gap-fill text-warning me-1"></i> @coachList.Count Coaches</span>
        </div>
    </div>
</div>

<!-- ✅ EXPANDED TOP TIMELINE & ANIMATED COACH TRACK (Normal Scroll State) -->
<div class="train-hero-card mb-4" id="trainHeroCard">
    <div class="train-hero-header">
        <div class="hero-left">
            <div class="hero-badge-pill">
                <i class="bi bi-train-front"></i> Indian Railways Official Schedule
            </div>
            <h2 class="hero-train-title">
                <span class="hero-train-num">@train.Number</span>
                <span class="hero-train-name">@train.Name</span>
            </h2>
            <div class="hero-journey-points">
                <div class="journey-point">
                    <span class="point-label"><i class="bi bi-geo-alt-fill text-danger"></i> Source</span>
                    <span class="point-station">@train.FromStation?.Name</span>
                    <span class="point-time">Dep: @train.Departure.ToString(@"hh\:mm")</span>
                </div>
                <div class="journey-arrow-box">
                    <span class="journey-dist-badge">@totalDistance km</span>
                    <div class="journey-arrow-line">
                        <i class="bi bi-chevron-right arrow-anim"></i>
                    </div>
                    <span class="journey-time-badge"><i class="bi bi-clock"></i> @train.Duration</span>
                </div>
                <div class="journey-point">
                    <span class="point-label"><i class="bi bi-geo-alt-fill text-success"></i> Destination</span>
                    <span class="point-station">@train.ToStation?.Name</span>
                    <span class="point-time">Arr: @train.Arrival.ToString(@"hh\:mm")</span>
                </div>
            </div>
        </div>

        <div class="hero-right">
            <div class="hero-stats-card">
                <div class="stat-row">
                    <span class="stat-label">Total Halts:</span>
                    <span class="stat-val">@routes.Count</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Train Type:</span>
                    <span class="stat-val text-primary font-weight-bold">@(string.IsNullOrEmpty(train.TrainType) ? "SUPERFAST" : train.TrainType)</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Total Coaches:</span>
                    <span class="stat-val">@coachList.Count</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 🚆 LIVE ANIMATED COACH COMPOSITION TRACK -->
    <div class="rake-track-section">
        <div class="rake-track-header">
            <div class="rake-title">
                <i class="bi bi-train-front-fill text-primary"></i>
                <span>Live Coach Positions & Rake Composition</span>
                <span class="badge-coach-count">@coachList.Count Units</span>
            </div>
            <div class="rake-track-legend">
                <span class="legend-dot loco-dot"></span> ENG/LOCO
                <span class="legend-dot gen-dot"></span> GN (General)
                <span class="legend-dot sl-dot"></span> Sleeper (SL/SE)
                <span class="legend-dot ac3-dot"></span> 3AC / 3E
                <span class="legend-dot ac2-dot"></span> 2AC
                <span class="legend-dot ac1-dot"></span> 1AC
                <span class="legend-dot eog-dot"></span> EOG/HOG
                <span class="legend-dot slr-dot"></span> SLR
            </div>
        </div>

        <!-- The Animated Train on Tracks -->
        <div class="rake-scroll-container">
            <div class="rail-track"></div>
            <div class="train-consist">
                @for (int c = 0; c < coachList.Count; c++)
                {
                    var code = coachList[c];
                    string coachClass = "coach-gen";
                    string coachIcon = "bi-people-fill";

                    if (code == "ENG" || code == "LOCO")
                    {
                        coachClass = "coach-loco";
                        coachIcon = "bi-train-front-fill";
                    }
                    else if (code == "EOG" || code == "HOG")
                    {
                        coachClass = "coach-eog";
                        coachIcon = "bi-lightning-charge-fill";
                    }
                    else if (code == "SLR")
                    {
                        coachClass = "coach-slr";
                        coachIcon = "bi-box-seam-fill";
                    }
                    else if (code.StartsWith("SE") || (code.StartsWith("S") && code != "SLR"))
                    {
                        coachClass = "coach-sleeper";
                        coachIcon = "bi-moon-stars-fill";
                    }
                    else if (code.StartsWith("B") || code.StartsWith("M"))
                    {
                        coachClass = "coach-ac3";
                        coachIcon = "bi-snow";
                    }
                    else if (code.StartsWith("A"))
                    {
                        coachClass = "coach-ac2";
                        coachIcon = "bi-snow2";
                    }
                    else if (code.StartsWith("H"))
                    {
                        coachClass = "coach-ac1";
                        coachIcon = "bi-gem";
                    }
                    else if (code.StartsWith("C") || (code.StartsWith("E") && !code.StartsWith("ENG") && !code.StartsWith("EOG")))
                    {
                        coachClass = "coach-cc";
                        coachIcon = "bi-person-workspace";
                    }
                    else
                    {
                        coachClass = "coach-gen";
                        coachIcon = "bi-people-fill";
                    }

                    <div class="coach-unit @coachClass" style="animation-delay: @(c * 0.04)s;">
                        <div class="coach-roof"></div>
                        <div class="coach-body">
                            <span class="coach-icon"><i class="bi @coachIcon"></i></span>
                            <span class="coach-code">@code</span>
                        </div>
                        <div class="coach-undercarriage">
                            <span class="wheel left-wheel"></span>
                            <span class="wheel right-wheel"></span>
                        </div>
                        <span class="coach-pos-idx">@(c + 1)</span>
                    </div>

                    @if (c < coachList.Count - 1)
                    {
                        <div class="coach-coupler"></div>
                    }
                }
            </div>
            <div class="rail-ties"></div>
        </div>
    </div>
</div>


<!-- Bootstrap Icons  -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="route-card shadow-sm">

    <!-- ✅ Section Header with Train Badge -->
    <div class="route-header-bar">
        <div>
            <div class="route-title">
                <i class="bi bi-signpost-split"></i>
                <span>Train Route & Stoppage Management</span>
            </div>
            <div class="route-subtitle">
                Train: <span class="train-code-badge">@train.Number</span> @train.Name • Setup intermediate halts, temporary festival stops & schedule adjustments
            </div>
        </div>
        <a asp-action="TrainList" class="btn-top-back">
            <i class="bi bi-arrow-left"></i> Back to Train List
        </a>
    </div>

    <!-- ✅ Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-popup ">
            <div class="popup-content">
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <form method="post" asp-action="AddRoute" asp-route-trainId="@trainId" onsubmit="var ti = document.getElementById('tempDates'); if(ti) ti.disabled = false;">
        <input type="hidden" id="deletedIds" name="deletedIds" />

        <!-- ✅ MODERN CONTROLS BAR -->
        <div class="route-controls-card mb-4">
            <div class="route-controls-header">
                <div>
                    <span class="controls-title"><i class="bi bi-calendar2-range me-2 text-primary"></i>Schedule & Date Exceptions</span>
                    <span class="controls-sub">Configure Skip dates, Cancellations, and Temporary Stoppages</span>
                </div>
            </div>

            <div class="route-controls-grid">
                <div class="date-box">
                    <label>
                        <i class="bi bi-slash-circle text-warning me-1"></i> Skip Dates 
                        <span id="skipDatesCount" class="text-primary fw-bold ms-1" style="font-size:12px;"></span>
                    </label>
                    <input type="text" id="skipDates" name="skipDates"
                           value="@ViewBag.SkipDates"
                           placeholder="Select Dates"
                           autocomplete="off" class="date-input" />
                </div>

                <div class="date-box">
                    <label>
                        <i class="bi bi-x-octagon text-danger me-1"></i> Cancel Dates 
                        <span id="cancelDatesCount" class="text-danger fw-bold ms-1" style="font-size:12px;"></span>
                    </label>
                    <input type="text" id="cancelDates" name="cancelDates"
                           value="@ViewBag.CancelDates"
                           placeholder="Select Dates"
                           autocomplete="off" class="date-input" />
                </div>

                <div class="date-box">
                    <label>
                        <i class="bi bi-clock-history text-primary me-1"></i> Temporary Stoppage Dates 
                        <span id="tempDatesCount" class="text-primary fw-bold ms-1" style="font-size:12px;"></span>
                    </label>
                    <input type="text" id="tempDates" name="tempDates"
                           value="@ViewBag.TempDates"
                           placeholder="@(Model.Any(r => r.IsTemporary) ? "Select Dates" : "Add a temporary stop first")"
                           autocomplete="off" class="date-input" @(Model.Any(r => r.IsTemporary) ? "" : "disabled") />
                </div>
            </div>

            <div class="route-controls-actions">
                <button type="button" onclick="clearSkipDates()" class="btn-ctrl btn-ctrl-warning">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset Skip
                </button>

                <button type="button" onclick="clearCancelDates()" class="btn-ctrl btn-ctrl-danger">
                    <i class="bi bi-x-circle"></i> Reset Cancel
                </button>

                <button type="button" id="btnResetTemp" onclick="clearTempDates()" class="btn-ctrl btn-ctrl-primary" disabled>
                    <i class="bi bi-clock-history"></i> Reset Temporary
                </button>

                <button type="submit" class="btn-ctrl btn-ctrl-save">
                    <i class="bi bi-check2-circle"></i> Save Route
                </button>
            </div>
        </div>

        <!-- ✅ Table (Minimalistic & Screen Responsive) -->
        <div class="table-responsive route-table-wrapper mb-4">
            <table class="route-table" id="routeTable">
                <thead>
                    <tr>
                        <th style="width:65px; min-width:65px;">Stop #</th>
                        <th style="width:260px; min-width:200px; max-width:300px; text-align:left; padding-left:14px;">Station</th>
                        <th style="width:115px; min-width:110px;">Arrival</th>
                        <th style="width:115px; min-width:110px;">Departure</th>
                        <th style="width:110px; min-width:100px;">Distance (km)</th>
                        <th style="width:75px; min-width:70px;">Day</th>
                        <th style="width:95px; min-width:90px;" class="text-center">Action</th>
                        <th style="width:75px; min-width:70px; text-align:center;">Skip?</th>
                    </tr>
                </thead>

                <tbody id="routeTableBody">

                    @if (Model != null && Model.Any())
                    {
                        for (int i = 0; i < Model.Count; i++)
                        {
                            <tr class="fade-row @(Model[i].IsTemporary ? "temporary-row" : "")">
                                <td style="width:65px; text-align:center;">
                                    <input name="routes[@i].StopNumber" type="number" min="1" class="stop-number-input" value="@Model[i].StopNumber" readonly />
                                </td>

                                <td style="width:260px; min-width:200px; max-width:300px; text-align:left; padding-left:14px;">
                                    <div class="station-cell-flex">
                                        <select name="routes[@i].StationId" class="modern-select">
                                            @foreach (var s in stations)
                                            {
                                                <option value="@s.Id" selected="@(s.Id == Model[i].StationId)">
                                                    @s.Name
                                                </option>
                                            }
                                        </select>
                                        @if (Model[i].IsTemporary)
                                        {
                                            <span class="temp-badge temp-badge-pill">
                                                <i class="bi bi-clock-history"></i> Temp Halt
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td style="width:115px; text-align:center;">
                                    <input name="routes[@i].ArrivalTime" type="time" class="modern-time"
                                           value="@(Model[i].ArrivalTime?.ToString(@"hh\:mm"))" />
                                </td>

                                <td style="width:115px; text-align:center;">
                                    <input name="routes[@i].DepartureTime" type="time" class="modern-time"
                                           value="@(Model[i].DepartureTime?.ToString(@"hh\:mm"))" />
                                </td>

                                <td style="width:110px; text-align:center;">
                                    <input name="routes[@i].Distance" type="number" class="modern-number" value="@Model[i].Distance" placeholder="0" />
                                </td>

                                <td style="width:75px; text-align:center;">
                                    <input name="routes[@i].Day" type="number" min="1" class="modern-number" style="width:55px;" value="@Model[i].Day" />
                                </td>

                                <!-- Hidden ID & IsTemporary -->
                                <td style="display:none;">
                                    <input name="routes[@i].Id" type="hidden" value="@Model[i].Id" />
                                    <input type="hidden" name="routes[@i].IsTemporary" value="@(Model[i].IsTemporary ? "true" : "false")" class="is-temp-input" />
                                </td>

                                <td style="width:95px; text-align:center;">
                                    <div style="display:flex; justify-content:center; align-items:center; gap:8px;">
                                        <button type="button" class="btn-action-add" onclick="openInsertModal(this)" title="Insert Stop Below">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                        <button type="button" class="btn-action-delete" onclick="deleteRouteRow(this)" title="Delete Stop">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                                <td style="width:75px; text-align:center;">
                                    <input type="checkbox"
                                           class="skip-checkbox modern-checkbox"
                                           name="routes[@i].IsSkipped"
                                           value="true"
                                           @(Model[i].IsSkipped ? "checked" : "") />

                                    <input type="hidden" name="routes[@i].IsSkipped" value="false" />
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="fade-row">
                            <td style="width:65px; text-align:center;">
                                <input name="routes[0].StopNumber" type="number" class="stop-number-input" value="1" readonly />
                            </td>

                            <td style="width:260px; min-width:200px; max-width:300px; text-align:left; padding-left:14px;">
                                <div class="station-cell-flex">
                                    <select name="routes[0].StationId" class="modern-select">
                                        @foreach (var s in stations)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    </select>
                                </div>
                            </td>

                            <td style="width:115px; text-align:center;">
                                <input name="routes[0].ArrivalTime" type="time" class="modern-time" />
                            </td>
                            <td style="width:115px; text-align:center;">
                                <input name="routes[0].DepartureTime" type="time" class="modern-time" />
                            </td>
                            <td style="width:110px; text-align:center;">
                                <input name="routes[0].Distance" type="number" class="modern-number" placeholder="0" />
                            </td>
                            <td style="width:75px; text-align:center;">
                                <input name="routes[0].Day" min="1" type="number" class="modern-number" style="width:55px;" value="1" />
                            </td>

                            <!-- Hidden ID & IsTemporary -->
                            <td style="display:none;">
                                <input name="routes[0].Id" type="hidden" value="0" />
                                <input type="hidden" name="routes[0].IsTemporary" value="false" class="is-temp-input" />
                            </td>

                            <td style="width:95px; text-align:center;">
                                <div style="display:flex; justify-content:center; align-items:center; gap:8px;">
                                    <button type="button" class="btn-action-add" onclick="openInsertModal(this)" title="Insert Stop Below">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                    <button type="button" class="btn-action-delete" onclick="deleteRouteRow(this)" title="Delete Stop">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                            <td style="width:75px; text-align:center;">
                                <input type="checkbox"
                                       class="skip-checkbox modern-checkbox"
                                       name="routes[0].IsSkipped"
                                       value="true" />
                                <input type="hidden" name="routes[0].IsSkipped" value="false" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ✅ Bottom Action Buttons -->
        <div class="route-bottom-bar">
            <div class="bottom-bar-left">
                <button type="button" id="addRow" class="btn-bottom-add">
                    <i class="bi bi-plus-circle-fill"></i> Add Stop at End
                </button>
            </div>
            <div class="bottom-bar-right">
                <a asp-action="TrainList" class="btn-bottom-back">
                    <i class="bi bi-arrow-left"></i> Back to Train List
                </a>
                <button type="submit" class="btn-bottom-save">
                    <i class="bi bi-check2-circle"></i> Save Route
                </button>
            </div>
        </div>

    </form>
</div>

<!-- Modern Redesigned Modal Dialog for Choosing Stop Type (Regular vs Temp Halt) -->
<div id="insertStopDialog" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.65); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); z-index:99999; align-items:center; justify-content:center;">
    <div class="custom-modal-card" style="background:#ffffff; border-radius:20px; max-width:440px; width:92%; padding:28px 24px; box-shadow:0 25px 50px -12px rgba(0,0,0,0.35); text-align:left; position:relative; border:1px solid #e2e8f0;">
        
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
            <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:38px; height:38px; border-radius:12px; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:19px;">
                    <i class="bi bi-plus-circle-fill"></i>
                </div>
                <div>
                    <h5 style="margin:0; font-size:17px; font-weight:800; color:#0f172a; letter-spacing:-0.2px;">Insert Stop Below</h5>
                    <span style="font-size:12px; color:#64748b;">Configure stoppage characteristics</span>
                </div>
            </div>
            <button type="button" onclick="closeInsertDialog()" style="background:#f1f5f9; border:none; width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:18px; cursor:pointer; color:#64748b; transition:all 0.2s ease;">&times;</button>
        </div>

        <p style="color:#64748b; font-size:13.5px; margin-bottom:20px; line-height:1.5;">Choose whether to insert a standard regular timetable halt or a temporary/seasonal festival stoppage:</p>
        
        <div style="display:flex; flex-direction:column; gap:14px;">
            <!-- Regular Stop Option -->
            <button type="button" class="btn-option-card btn-regular-stop" onclick="confirmInsertStop(false)">
                <div class="option-icon-box regular-icon-box">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="option-text-box">
                    <div class="option-title">Regular Stop</div>
                    <div class="option-desc">Permanent scheduled halt active for all regular dates</div>
                </div>
                <div class="option-arrow">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </button>

            <!-- Temporary Halt Option -->
            <button type="button" class="btn-option-card btn-temp-stop" onclick="confirmInsertStop(true)">
                <div class="option-icon-box temp-icon-box">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="option-text-box">
                    <div class="option-title">
                        Temporary Halt
                        <span class="badge-seasonal">Festival / Special</span>
                    </div>
                    <div class="option-desc">Special stoppage active during designated seasonal dates</div>
                </div>
                <div class="option-arrow">
                    <i class="bi bi-chevron-right"></i>
                </div>
            </button>
        </div>

        <div style="margin-top:20px; text-align:right;">
            <button type="button" onclick="closeInsertDialog()" style="background:transparent; border:none; color:#64748b; font-weight:600; font-size:13px; cursor:pointer; padding:6px 12px; border-radius:6px;">Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- ✅ JAVASCRIPT -->
    <script>
        var tableBody = document.getElementById("routeTableBody");
        var deletedIdsInput = document.getElementById("deletedIds");
        var selectedRowForInsert = null;

        function openInsertModal(btn) {
            selectedRowForInsert = btn.closest("tr");
            var dialog = document.getElementById("insertStopDialog");
            if (dialog) dialog.style.display = "flex";
        }

        function closeInsertDialog() {
            var dialog = document.getElementById("insertStopDialog");
            if (dialog) dialog.style.display = "none";
            selectedRowForInsert = null;
        }

        function confirmInsertStop(isTemporary) {
            var currentRow = selectedRowForInsert;
            closeInsertDialog();
            if (!currentRow) return;

            var newRow = currentRow.cloneNode(true);
            newRow.classList.add("fade-row");

            var tempInput = newRow.querySelector(".is-temp-input");
            var badge = newRow.querySelector(".temp-badge");
            if (badge) badge.remove();

            if (isTemporary) {
                newRow.classList.add("temporary-row");
                if (tempInput) tempInput.value = "true";

                var select = newRow.querySelector("select");
                var stationCell = select ? select.closest("td") : null;
                if (stationCell) {
                    var flexContainer = stationCell.querySelector(".station-cell-flex") || stationCell.querySelector(".d-flex") || stationCell;
                    if (flexContainer && !flexContainer.querySelector(".temp-badge")) {
                        var newBadge = document.createElement("span");
                        newBadge.className = "temp-badge temp-badge-pill";
                        newBadge.innerHTML = '<i class="bi bi-clock-history"></i> Temp Halt';
                        flexContainer.appendChild(newBadge);
                    }
                }
            } else {
                newRow.classList.remove("temporary-row");
                if (tempInput) tempInput.value = "false";
            }

            var idInput = newRow.querySelector("input[name$='.Id']");
            if (idInput) idInput.value = "0";

            var select = newRow.querySelector("select");
            if (select) select.selectedIndex = 0;

            newRow.querySelectorAll("input").forEach(function (inp) {
                if (inp.type === "time" || inp.name.endsWith(".Distance")) {
                    inp.value = "";
                } else if (inp.type === "checkbox") {
                    inp.checked = false;
                } else if (inp.name.endsWith(".IsSkipped") && inp.type === "hidden") {
                    inp.value = "false";
                }
            });

            var currentDay = currentRow.querySelector("input[name$='.Day']");
            var newDay = newRow.querySelector("input[name$='.Day']");
            if (currentDay && newDay) {
                newDay.value = currentDay.value || 1;
            }

            currentRow.after(newRow);
            updateRowIndicesAndOrder();
            updateTempControlsState();
        }

        // ✅ Add Stop at Bottom (Regular Stop)
        document.getElementById("addRow").addEventListener("click", function () {
            var rowCount = tableBody.rows.length;
            var newRow = tableBody.rows[0].cloneNode(true);

            newRow.classList.remove("temporary-row");
            newRow.classList.add("fade-row");

            // Remove temp badge if cloned from a temp row
            var badge = newRow.querySelector(".temp-badge");
            if (badge) {
                badge.remove();
            }

            var tempInput = newRow.querySelector(".is-temp-input");
            if (tempInput) {
                tempInput.value = "false";
            }

            newRow.querySelectorAll("input, select").forEach(function (input) {
                if (input.tagName.toLowerCase() === "select") {
                    input.selectedIndex = 0;
                }
                else if (input.name.endsWith(".Id")) {
                    input.value = "0";
                }
                else if (input.name.endsWith(".Day")) {
                    input.value = 1;
                }
                else if (input.type === "checkbox") {
                    input.checked = false;
                }
                else if (input.name.endsWith(".IsSkipped") && input.type === "hidden") {
                    input.value = "false";
                }
                else if (input.name.endsWith(".IsTemporary") && input.type === "hidden") {
                    input.value = "false";
                }
                else {
                    input.value = "";
                }
            });

            tableBody.appendChild(newRow);
            updateRowIndicesAndOrder();
            updateTempControlsState();
        });

        // ✅ Delete row
        function deleteRouteRow(btn) {
            var row = btn.closest("tr");
            var idInput = row.querySelector("input[name$='.Id']");

            if (tableBody.rows.length > 1) {
                let confirmDelete = confirm("Do you want to delete this stop?");
                if (confirmDelete) {
                    if (idInput && idInput.value && idInput.value != "0") {
                        var deletedIds = deletedIdsInput.value ? deletedIdsInput.value.split(",") : [];
                        deletedIds.push(idInput.value);
                        deletedIdsInput.value = deletedIds.join(",");
                    }
                    row.remove();
                    updateRowIndicesAndOrder();
                    updateTempControlsState();
                }
            } else {
                alert("At least one stop is required.");
            }
        }

        // ✅ Fix indices and sequential Stop #
        function updateRowIndicesAndOrder() {
            tableBody.querySelectorAll("tr").forEach(function (row, index) {
                row.querySelectorAll("input, select").forEach(function (input) {
                    if (input.name) {
                        input.name = input.name.replace(/routes\[\d+\]/, "routes[" + index + "]");
                    }
                });
                var stopInput = row.querySelector(".stop-number-input");
                if (stopInput) {
                    stopInput.value = index + 1;
                }
            });
        }

        // ✅ Dynamic Temporary Controls State
        function updateTempControlsState() {
            var tempRows = tableBody.querySelectorAll(".is-temp-input[value='true']");
            var hasTemp = tempRows.length > 0;

            var tempInput = document.getElementById("tempDates");
            var resetBtn = document.getElementById("btnResetTemp");

            if (tempInput) {
                tempInput.disabled = !hasTemp;
                if (!hasTemp) {
                    tempInput.placeholder = "Add a temporary stop first";
                    if (tempFp) {
                        tempFp.clear();
                    }
                    tempInput.value = "";
                    tempInput.title = "";
                    var countEl = document.getElementById("tempDatesCount");
                    if (countEl) countEl.textContent = "";
                } else {
                    tempInput.placeholder = "Select Dates";
                }
            }

            if (resetBtn) {
                resetBtn.disabled = !hasTemp;
            }
        }

        // ✅ Fade-out success popup
        document.addEventListener("DOMContentLoaded", () => {
            const popup = document.querySelector(".success-popup");
            if (popup) {
                const popupContent = popup.querySelector(".popup-content");
                setTimeout(() => {
                    popupContent.classList.add("fade-out");
                    setTimeout(() => {
                        popup.style.display = "none";
                    }, 500);
                }, 100);
            }
        });

        // GLOBAL FLATPICKR INSTANCES
        let skipFp;
        let cancelFp;
        let tempFp;

        function updateDateCounts() {
            const sInput = document.getElementById("skipDates");
            const cInput = document.getElementById("cancelDates");
            const tInput = document.getElementById("tempDates");
            const sCount = document.getElementById("skipDatesCount");
            const cCount = document.getElementById("cancelDatesCount");
            const tCount = document.getElementById("tempDatesCount");

            if (sInput && sCount) {
                const dates = (sInput.value || "")
                    .split(/[,;\s]+/)
                    .map(s => s.trim())
                    .filter(s => /^\d{4}-\d{2}-\d{2}$/.test(s));
                const count = (new Set(dates)).size;
                sCount.textContent = count > 0 ? `(${count} date${count > 1 ? 's' : ''})` : "";
                sInput.title = sInput.value;
            }
            if (cInput && cCount) {
                const dates = (cInput.value || "")
                    .split(/[,;\s]+/)
                    .map(s => s.trim())
                    .filter(s => /^\d{4}-\d{2}-\d{2}$/.test(s));
                const count = (new Set(dates)).size;
                cCount.textContent = count > 0 ? `(${count} date${count > 1 ? 's' : ''})` : "";
                cInput.title = cInput.value;
            }
            if (tInput && tCount) {
                const dates = (tInput.value || "")
                    .split(/[,;\s]+/)
                    .map(s => s.trim())
                    .filter(s => /^\d{4}-\d{2}-\d{2}$/.test(s));
                const count = (new Set(dates)).size;
                tCount.textContent = count > 0 ? `(${count} date${count > 1 ? 's' : ''})` : "";
                tInput.title = tInput.value;
            }
        }

        function initDatePickers() {
            const skipInput = document.getElementById("skipDates");
            const cancelInput = document.getElementById("cancelDates");
            const tempInput = document.getElementById("tempDates");

            if (typeof flatpickr === 'undefined') {
                setTimeout(initDatePickers, 80);
                return;
            }

            // Up to 6 full months in advance
            var maxLimitDate = new Date();
            maxLimitDate.setMonth(maxLimitDate.getMonth() + 6);

            function calcMinDate(dates) {
                var min = new Date();
                min.setHours(0, 0, 0, 0);
                if (dates && dates.length > 0) {
                    for (var i = 0; i < dates.length; i++) {
                        var parsed = new Date(dates[i]);
                        if (!isNaN(parsed) && parsed < min) {
                            min = parsed;
                        }
                    }
                }
                return min;
            }

            // ✅ INIT SKIP CALENDAR (UP TO 6 MONTHS)
            if (skipInput && !skipFp) {
                const initialSkipDates = (skipInput.value || "")
                    .split(/[,;\s]+/)
                    .map(s => s.trim())
                    .filter(s => /^\d{4}-\d{2}-\d{2}$/.test(s));

                skipFp = flatpickr(skipInput, {
                    mode: "multiple",
                    dateFormat: "Y-m-d",
                    conjunction: ", ",
                    closeOnSelect: false,
                    allowInput: false,
                    minDate: calcMinDate(initialSkipDates),
                    maxDate: maxLimitDate,
                    monthSelectorType: "dropdown",
                    defaultDate: initialSkipDates,
                    onChange: function (selectedDates, dateStr) {
                        skipInput.value = dateStr;
                        updateDateCounts();
                    }
                });
            }

            // ✅ INIT CANCEL CALENDAR (UP TO 6 MONTHS)
            if (cancelInput && !cancelFp) {
                const initialCancelDates = (cancelInput.value || "")
                    .split(/[,;\s]+/)
                    .map(s => s.trim())
                    .filter(s => /^\d{4}-\d{2}-\d{2}$/.test(s));

                cancelFp = flatpickr(cancelInput, {
                    mode: "multiple",
                    dateFormat: "Y-m-d",
                    conjunction: ", ",
                    closeOnSelect: false,
                    allowInput: false,
                    minDate: calcMinDate(initialCancelDates),
                    maxDate: maxLimitDate,
                    monthSelectorType: "dropdown",
                    defaultDate: initialCancelDates,
                    onChange: function (selectedDates, dateStr) {
                        cancelInput.value = dateStr;
                        updateDateCounts();
                    }
                });
            }

            // ✅ INIT TEMPORARY CALENDAR (UP TO 6 MONTHS)
            if (tempInput && !tempFp) {
                const initialTempDates = (tempInput.value || "")
                    .split(/[,;\s]+/)
                    .map(s => s.trim())
                    .filter(s => /^\d{4}-\d{2}-\d{2}$/.test(s));

                tempFp = flatpickr(tempInput, {
                    mode: "multiple",
                    dateFormat: "Y-m-d",
                    conjunction: ", ",
                    closeOnSelect: false,
                    allowInput: false,
                    minDate: calcMinDate(initialTempDates),
                    maxDate: maxLimitDate,
                    monthSelectorType: "dropdown",
                    defaultDate: initialTempDates,
                    onChange: function (selectedDates, dateStr) {
                        tempInput.value = dateStr;
                        updateDateCounts();
                    }
                });
            }

            updateDateCounts();
            updateTempControlsState();

            // ✅ VALIDATION FOR CHECKBOXES
            document.addEventListener("change", function (e) {
                if (e.target.classList.contains("skip-checkbox")) {
                    let dates = skipInput ? skipInput.value : "";
                    if (e.target.checked && (!dates || dates.trim() === "")) {
                        alert("Select SKIP dates first from the calendar above.");
                        e.target.checked = false;
                    }
                }
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initDatePickers);
        } else {
            initDatePickers();
        }

        // ✅ GLOBAL RESET FUNCTIONS
        function clearCancelDates() {
            if (cancelFp) {
                cancelFp.clear();
            }
            const cInput = document.getElementById("cancelDates");
            if (cInput) {
                cInput.value = "";
                cInput.title = "";
            }
            updateDateCounts();
        }

        function clearSkipDates() {
            if (skipFp) {
                skipFp.clear();
            }
            const sInput = document.getElementById("skipDates");
            if (sInput) {
                sInput.value = "";
                sInput.title = "";
            }
            updateDateCounts();
        }

        function clearTempDates() {
            if (tempFp) {
                tempFp.clear();
            }
            const tInput = document.getElementById("tempDates");
            if (tInput) {
                tInput.value = "";
                tInput.title = "";
            }
            updateDateCounts();
        }

        // 🚆 Sticky Single-Line Train Strip Toggle on Scroll Down
        window.addEventListener("scroll", function () {
            var strip = document.getElementById("stickyTrainStrip");
            var hero = document.getElementById("trainHeroCard");
            if (!strip) return;

            var threshold = hero ? (hero.offsetTop + hero.offsetHeight - 20) : 200;
            if (window.scrollY > threshold) {
                strip.classList.add("visible");
            } else {
                strip.classList.remove("visible");
            }
        });

        // 🔥 Keep admin session alive
        setInterval(() => {
            fetch('/Admin/KeepAlive', {
                method: 'GET',
                credentials: 'include'
            });
        }, 60000); // every 1 minute
    </script>
}

