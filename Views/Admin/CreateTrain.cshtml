@model IRCTCClone.Models.Train

@{
    ViewData["Title"] = "Add New Train";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-3 pb-5"> 
    <h2 class="mb-3 text-primary">Add New Train</h2>
        <div class="">
            <a asp-action="Dashboard" class="btn btn-home mb-3">Back to DashBoard</a>
        </div>

    <!-- ✅ Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="trainForm" method="post">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Train Details</h5>

                <div class="row mb-2"> 
                    <div class="col-md-4">
                        <label class="form-label">Train Number</label>
                        <input asp-for="Number" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Train Name</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Train Type</label>

                        <select id="trainType" name="trainType" class="form-select">
                            <option value="">Select Train Type</option>

                            @foreach (var mdtrain in ViewBag.mdtrains as List<IRCTCClone.Models.MDTrains>)
                            {
                                <option value="@mdtrain.Type">@mdtrain.Type</option>
                            }
                        </select>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Service Start Date (Optional)</label>
                            <input asp-for="ServiceStartDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Service End Date (Optional)</label>
                            <input asp-for="ServiceEndDate" type="date" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label class="form-label">From Station</label>
                        <select asp-for="FromStationId" class="form-select" required>
                            <option value="">Select Station</option>
                            @foreach (var station in ViewBag.Stations as List<IRCTCClone.Models.Station>)
                            {
                                <option value="@station.Id">@station.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">To Station</label>
                        <select asp-for="ToStationId" class="form-select" required>
                            <option value="">Select Station</option>
                            @foreach (var station in ViewBag.Stations as List<IRCTCClone.Models.Station>)
                            {
                                <option value="@station.Id">@station.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Departure Time</label>
                        <input asp-for="Departure" type="time" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Arrival Time</label>
                        <input asp-for="Arrival" type="time" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Duration</label>
                        <input asp-for="Duration" class="form-control" placeholder="e.g. 00:00" required />
                    </div>
                    <!-- Add this field to your Add Train HTML Form -->
                    <div class="form-group mb-3">
                        <label class="form-label" style="font-weight:600;">Coach Composition Order</label>
                        <input type="text"
                               name="CoachPositions"
                               class="form-control"
                               placeholder="e.g. S1,S2,S3,B1,B2,A1"/>
                        <small class="text-muted">Enter comma-separated coach codes (e.g. S1,S2 = Sleeper, B1,B2 = AC 3 Tier, A1 = AC 2 Tier)</small>
                    </div>
                    <div class="mt-3">
                        <label class="form-label"><strong>Runs On</strong></label>

                        <div class="d-flex gap-3 flex-wrap">

                            <label><input type="checkbox" asp-for="RunMon" /> Mon</label>
                            <label><input type="checkbox" asp-for="RunTue" /> Tue</label>
                            <label><input type="checkbox" asp-for="RunWed" /> Wed</label>
                            <label><input type="checkbox" asp-for="RunThu" /> Thu</label>
                            <label><input type="checkbox" asp-for="RunFri" /> Fri</label>
                            <label><input type="checkbox" asp-for="RunSat" /> Sat</label>
                            <label><input type="checkbox" asp-for="RunSun" /> Sun</label>

                        </div>
                    </div>
                </div>

                <hr />
                <div id="classSection">
                    <h5 class="fw-bold mb-3">Train Classes</h5>
                    <table class="table table-bordered align-middle" id="classTable">
                        <thead class="table-light">
                            <tr>
                                <th>Class Code</th>
                                <th>Booking Code</th>
                                <th>Seats</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input name="classCodes" class="form-control" placeholder="e.g. 1A, 2A, SL" required /></td>
                                <td><input name="BookingCode" class="form-control" placeholder="e.g. H, A, S" required /></td>
                                <td><input name="seats" type="number" class="form-control" placeholder="Seats" required /></td>
                                <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <button type="button" id="addClassRow" class="btn btn-secondary btn-sm mb-3">+ Add Class</button>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">Save Train</button>
                    <a asp-action="TrainList" class="btn btn-outline-secondary">Cancel</a>
                    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts { 
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const typeDropdown = document.getElementById("trainType");
            const classSection = document.getElementById("classSection");
            const form = document.getElementById("trainForm");

            // 🔁 Toggle UI based on type
            typeDropdown.addEventListener("change", function () {

                const type = this.value;

                if (type === "MEMU" || type === "DEMU" || type === "MMTS") {

                    classSection.style.display = "none";

                    // 🔥 Disable validation completely
                    document.querySelectorAll("#classTable input").forEach(i => {
                        i.disabled = true;
                        i.removeAttribute("required");
                    });

                } else {

                    classSection.style.display = "block";

                    // 🔥 Enable again for normal trains
                    document.querySelectorAll("#classTable input").forEach(i => {
                        i.disabled = false;
                        i.setAttribute("required", "required");
                    });
                }
            });

            // 🔥 FORM SUBMIT LOGIC
            form.addEventListener("submit", function (e) {

                const type = typeDropdown.value;

                // ❌ REMOVE mandatory validation

                if (type === "MEMU" || type === "DEMU" || type === "MMTS") {

                    // MEMU/DEMU flow
                    document.querySelectorAll("#classTable input").forEach(i => {
                        i.disabled = true;
                    });

                    this.action = "/GetMemuDemu/CreateMemuDemu";
                }
                else {

                    // ✅ NORMAL TRAIN (type can be NULL)
                    this.action = "/Admin/CreateTrain";
                }

                if (type === "MEMU" || type === "DEMU" || type === "MMTS") {

                    // 🔥 FINAL SAFETY
                    document.querySelectorAll("#classTable input").forEach(i => {
                        i.disabled = true;
                    });

                    this.action = "/GetMemuDemu/CreateMemuDemu";

                } else {

                    this.action = "/Admin/CreateTrain";
                }

                console.log("Submitting to:", this.action);
            });

        });

        document.addEventListener("DOMContentLoaded", function () {
            const addBtn = document.getElementById("addClassRow");
            const tableBody = document.querySelector("#classTable tbody");

            addBtn.addEventListener("click", function () {
                const newRow = document.createElement("tr");
                newRow.innerHTML = `
                    <td><input name="classCodes" class="form-control" placeholder="e.g. 1A, 2A, SL" required></td>
                    <td><input name="BookingCode" class="form-control" placeholder="e.g. H, A, S" required></td>
                    <td><input name="seats" type="number" class="form-control" placeholder="Seats" required></td>
                    <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
                `;
                tableBody.appendChild(newRow);
            });

            // Delegate remove-row click
            tableBody.addEventListener("click", function (e) {
                if (e.target.classList.contains("remove-row")) {

                    const totalRows = tableBody.querySelectorAll("tr").length;

                    if (totalRows <= 1) {
                        alert("Atleast one train class must be added.");
                        return;
                    }

                    if (confirm("Are you sure do you want to remove this class?")) {
                        e.target.closest("tr").remove();
                    }
                }
            });
        });

                // 🔥 Keep admin session alive
        setInterval(() => {
            fetch('/Admin/KeepAlive', {
                method: 'GET',
                credentials: 'include'
            });
        }, 60000); // every 1 minute
    </script>
}