@using IrctcClone.Helpers
@model List<IRCTCClone.Models.Station>

@{
    ViewData["Title"] = "Search Trains";
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var maxDate = DateTime.Today.AddMonths(2).ToString("yyyy-MM-dd");
    ViewBag.ForceLogin = TatkalHelper.ShouldForceLogin();
    ViewBag.AutoTatkal = TatkalHelper.ShouldAutoSelectTatkal();
    ViewBag.IsLoggedIn = User.Identity.IsAuthenticated;
    ViewBag.TatkalExclusive = TatkalHelper.IsTatkalExclusiveWindow();
}

