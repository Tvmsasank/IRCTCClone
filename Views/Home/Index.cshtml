    function formatTime(t) {
        if (!t || t === "NULL") return "--";

        // Convert to string (safe)
        let time = t.toString();

        // Remove milliseconds if present
        if (time.includes(".")) {
            time = time.split(".")[0];
        }

        // Remove seconds → HH:mm
        let parts = time.split(":");

        if (parts.length >= 2) {
            return parts[0] + ":" + parts[1];
        }

        return time;
    }

