 *@

<div class="home-page">
    <div class="search-card">
        <!-- Header (Desktop) -->
        <div class="search-card-header">
            <h1 class="search-title" data-translate="bookticket">BOOK TICKET</h1>
        </div>

        <!-- Mobile Tabs (Visible only on mobile <= 768px when logged in) -->
        @if (User.Identity.IsAuthenticated)
        {
            <div class="mobile-search-tabs">
                <button type="button" class="mobile-tab-btn active" data-tab="book">Book Ticket</button>
                <a href="/Booking/History?filter=upcoming" class="mobile-tab-btn">Upcoming Journey</a>
                <a href="/Booking/History" class="mobile-tab-btn">Last Transaction</a>
            </div>
        }

        <form method="post" action="/Train/TrainResults" id="homeSearchForm" novalidate>

            <!-- From Station -->
            <div class="field-group grid-from">
                <label class="field-label" data-translate="from">From*</label>
                <div class="station-input-wrapper">
                    <span class="mobile-row-icon"><i class="bi bi-cursor-fill" style="transform: rotate(45deg); display: inline-block;"></i></span>
                    <div class="floating-group">
                        <input type="text"
                               id="fromStation"
                               name="fromStation"
                               placeholder=" "
                               autocomplete="off"
                               required />
                        <label for="fromStation">
                            <span class="desktop-label-txt" data-translate="from_placeholder">Enter source station</span>
                            <span class="mobile-label-txt">From</span>
                        </label>
                        <input type="hidden" id="fromStationId" name="fromStationId" />
                        <div id="fromStationList" class="autocomplete-list"></div>
                    </div>
                </div>
            </div>

            <!-- Swap Button -->
            <div class="swap-row">
                <div class="swap-line"></div>
                <button type="button" class="swap-btn" id="swapStations" title="Swap Stations">
                    <span class="desktop-swap-icon"><i class="bi bi-arrow-left-right"></i></span>
                    <span class="mobile-swap-icon"><i class="bi bi-arrow-down-up"></i></span>
                </button>
                <div class="swap-line"></div>
            </div>

            <!-- To Station -->
            <div class="field-group grid-to">
                <label class="field-label" data-translate="to">To*</label>
                <div class="station-input-wrapper">
                    <span class="mobile-row-icon"><i class="bi bi-geo-alt-fill"></i></span>
                    <div class="floating-group">
                        <input type="text"
                               id="toStation"
                               name="toStation"
                               placeholder=" "
                               autocomplete="off"
                               required />
                        <label for="toStation">
                            <span class="desktop-label-txt" data-translate="to_placeholder">Enter destination station</span>
                            <span class="mobile-label-txt">To</span>
                        </label>
                        <input type="hidden" id="toStationId" name="toStationId" />
                        <div id="toStationList" class="autocomplete-list"></div>
                    </div>
                </div>
            </div>

            <!-- Date -->
            <div class="field-group grid-date">
                <label class="field-label" data-translate="date">DD/MM/YYYY *</label>
                <div class="mobile-date-wrapper">
                    <span class="mobile-row-icon"><i class="bi bi-calendar3"></i></span>
                    <input type="text"
                           id="journeyDate"
                           name="journeyDate"
                           class="date-input"
                           placeholder="Select Journey Date"
                           data-translate="date_placeholder"
                           required />
                </div>
            </div>

            <!-- Classes -->
            <div class="field-group grid-class">
                <label class="field-label" data-translate="classes">Classes</label>
                
                <!-- Desktop Native Select -->
                <select id="classFilterDropdown" name="classCode" class="form-control desktop-only-select">
                    <option value="ALL" selected="@(ViewBag.classCode == null || ViewBag.classCode == "ALL")">All Classes</option>
                    <option value="EA" selected="@(ViewBag.classCode == "EA")">Anubhuti Class (EA)</option>
                    <option value="1A" selected="@(ViewBag.classCode == "1A")">AC First Class (1A)</option>
                    <option value="EV" selected="@(ViewBag.classCode == "EC")">Vistadome AC (EV)</option>
                    <option value="EC" selected="@(ViewBag.classCode == "EC")">Exec. Chair Car (EC)</option>
                    <option value="2A" selected="@(ViewBag.classCode == "2A")">AC 2 Tier (2A)</option>
                    <option value="FC" selected="@(ViewBag.classCode == "FC")">First Class (FC)</option>
                    <option value="3A" selected="@(ViewBag.classCode == "3A")">AC 3 Tier (3A)</option>
                    <option value="3E" selected="@(ViewBag.classCode == "3E")">AC 3 Economy (3E)</option>
                    <option value="VS" selected="@(ViewBag.classCode == "VS")">Vistadome Non AC (VS)</option>
                    <option value="2S" selected="@(ViewBag.classCode == "2S")">Second Sitting (2S)</option>
                </select>

                <!-- Mobile Custom Dropdown -->
                <div class="mobile-custom-select" id="mobileClassDropdown">
                    <div class="mobile-select-trigger" id="mobileClassTrigger">
                        <div class="mobile-trigger-left">
                            <span class="mobile-row-icon"><i class="bi bi-briefcase-fill"></i></span>
                            <span class="mobile-select-text" id="mobileClassText">All Classes</span>
                        </div>
                        <span class="mobile-select-arrow"><i class="bi bi-chevron-down"></i></span>
                    </div>
                    <div class="mobile-dropdown-panel" id="mobileClassPanel">
                        <div class="mobile-dropdown-item active" data-value="ALL">All Classes</div>
                        <div class="mobile-dropdown-item" data-value="EA">Anubhuti Class (EA)</div>
                        <div class="mobile-dropdown-item" data-value="1A">AC First Class (1A)</div>
                        <div class="mobile-dropdown-item" data-value="EV">Vistadome AC (EV)</div>
                        <div class="mobile-dropdown-item" data-value="EC">Exec. Chair Car (EC)</div>
                        <div class="mobile-dropdown-item" data-value="2A">AC 2 Tier (2A)</div>
                        <div class="mobile-dropdown-item" data-value="FC">First Class (FC)</div>
                        <div class="mobile-dropdown-item" data-value="3A">AC 3 Tier (3A)</div>
                        <div class="mobile-dropdown-item" data-value="3E">AC 3 Economy (3E)</div>
                        <div class="mobile-dropdown-item" data-value="VS">Vistadome Non AC (VS)</div>
                        <div class="mobile-dropdown-item" data-value="2S">Second Sitting (2S)</div>
                    </div>
                </div>
            </div>

            <!-- Quota -->
            <div class="field-group grid-quota">
                <label class="field-label" data-translate="quota">Quota</label>
                
                <!-- Desktop Native Select -->
                <select id="quota" name="quota" class="form-control desktop-only-select" style="cursor: pointer">

                    @if (ViewBag.TatkalExclusive == true && ViewBag.IsLoggedIn == true)
                    {
                        <option value="TATKAL" id="tatkalOption">TATKAL</option>
                        <option value="PT" id="premiumTatkalOption">PREMIUM TATKAL</option>
                    }

                    else
                    {
                        <option value="GENERAL">GENERAL</option>
                        <option value="LADIES">LADIES</option>
                        <option value="SENIOR">LOWER BERTH/SENIOR CITIZEN</option>
                        <option value="PwD">PERSON WITH DISABILITY</option>
                        <option value="DP">DUTY PASS</option>
                        <option value="TATKAL" id="tatkalOption">TATKAL</option>
                        <option value="PT" id="premiumTatkalOption">PREMIUM TATKAL</option>
                    }
                </select>

                <!-- Mobile Custom Dropdown -->
                <div class="mobile-custom-select" id="mobileQuotaDropdown">
                    <div class="mobile-select-trigger" id="mobileQuotaTrigger">
                        <div class="mobile-trigger-left">
                            <span class="mobile-row-icon"><i class="bi bi-grid-fill"></i></span>
                            <span class="mobile-select-text" id="mobileQuotaText">GENERAL</span>
                        </div>
                        <span class="mobile-select-arrow"><i class="bi bi-chevron-down"></i></span>
                    </div>
                    <div class="mobile-dropdown-panel" id="mobileQuotaPanel">
                        @if (ViewBag.TatkalExclusive == true && ViewBag.IsLoggedIn == true)
                        {
                            <div class="mobile-dropdown-item active" data-value="TATKAL">TATKAL</div>
                            <div class="mobile-dropdown-item" data-value="PT">PREMIUM TATKAL</div>
                        }
                        else
                        {
                            <div class="mobile-dropdown-item active" data-value="GENERAL">GENERAL</div>
                            <div class="mobile-dropdown-item" data-value="LADIES">LADIES</div>
                            <div class="mobile-dropdown-item" data-value="SENIOR">LOWER BERTH/SR.CITIZEN</div>
                            <div class="mobile-dropdown-item" data-value="PwD">PERSON WITH DISABILITY</div>
                            <div class="mobile-dropdown-item" data-value="DP">DUTY PASS</div>
                            <div class="mobile-dropdown-item" data-value="TATKAL">TATKAL</div>
                            <div class="mobile-dropdown-item" data-value="PT">PREMIUM TATKAL</div>
                        }
                    </div>
                </div>
            </div>

            <!-- 3 CONCESSIONS CHECKBOXES (Home Page) -->
            <div class="field-group grid-concessions home-concessions-group">
                <label class="home-concession-item">
                    <input type="checkbox" id="homeChkDisabilityConcession" name="pwdConcession" value="true" />
                    <span>Person With Disability Concession</span>
                </label>
                <label class="home-concession-item">
                    <input type="checkbox" id="homeChkFlexibleWithDate" name="flexibleWithDate" value="true" />
                    <span>Flexible With Date</span>
                </label>
                <label class="home-concession-item">
                    <input type="checkbox" id="homeChkRailwayPassConcession" name="railwayPassConcession" value="true" />
                    <span>Railway Pass Concession</span>
                </label>
            </div>

            <!-- Search Button -->
            <button type="submit" class="mainpageloginbtn grid-button" data-translate="searchtrains">Search Trains</button>

            <!-- Search MEMU/DEMU/MMTS Trains (Placed directly below Search Trains) -->
            <button type="button" class="home-memu-sub-btn" onclick="openMemuModal()" data-translate="searchmemu">
                <i class="bi bi-train-front me-2"></i>
                <span>Search MEMU/DEMU/MMTS Trains</span>
            </button>

            <!-- Links Row / Mobile Quick Actions -->
            <div class="home-bottom-links-row @(!User.Identity.IsAuthenticated ? "guest-bottom-links" : "auth-bottom-links")">
                <div class="bottom-action-col grid-pnr">
                    <a asp-controller="Booking" asp-action="CheckPNR" class="bottom-action-btn" data-translate="checkpnr">
                        <i class="bi bi-clipboard-check-fill me-1"></i> <span>PNR STATUS</span>
                    </a>
                </div>

                <!-- Desktop MEMU button (hidden on mobile) -->
                <div class="bottom-action-col grid-memu desktop-only-memu">
                    <button type="button" class="bottom-action-btn memu-btn" onclick="openMemuModal()" data-translate="searchmemu">
                        <i class="bi bi-train-front me-1"></i>
                        <span>SEARCH MEMU/DEMU/MMTS TRAINS</span>
                    </button>
                </div>

                <div class="bottom-action-col grid-chart">
                    <a href="https://www.irctc.co.in/online-charts/" target="_blank" class="bottom-action-btn" data-translate="chartvacancy">
                        <i class="bi bi-file-earmark-bar-graph-fill me-1"></i> <span>CHARTS / VACANCY</span>
                    </a>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="bottom-action-col grid-refund">
                        <a asp-controller="Booking" asp-action="History" class="bottom-action-btn">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            <span>Refund Status</span>
                        </a>
                    </div>

                    <div class="bottom-action-col grid-favourite">
                        <a asp-controller="Booking" asp-action="History" class="bottom-action-btn btn-two-line">
                            <i class="bi bi-geo-alt-fill me-1"></i>
                            <div class="btn-text-group">
                                <span>Re-Book Favourite</span>
                                <span>Journey</span>
                            </div>
                        </a>
                    </div>
                }            
            </div>
        </form>
    </div>
</div>

<!-- ✅ ADD MEMU MODAL HERE -->
<div id="memuModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">

        <span class="modal-close" onclick="closeMemu()">✖</span>

        <h4>MEMU / DEMU / MMTS Trains</h4>

        <table class="table">
            <thead>
                <tr>
                    <th>Train</th>
                    <th>Type</th>
                    <th>Departure</th>
                    <th>Arrival</th>
                    <th>Duration</th>
                    <th>RunsOn</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody id="memuBody"></tbody>
        </table>

    </div>
</div>

<!-- ✅ TRAIN SCHEDULE MODAL -->
<div id="scheduleModal" class="modal-overlay" style="display:none;">
    <div class="modal-content schedule-modal">

        <span class="modal-close" onclick="closeSchedule()">✖</span>

        <h4>Train Schedule</h4>

        <table class="table">
            <thead>
                <tr>
                    <th>Stop</th>
                    <th>Station</th>
                    <th>Arrival</th>
                    <th>Departure</th>
                    <th>Distance</th>
                    <th>Day</th>
                </tr>
            </thead>

            <tbody id="scheduleBody"></tbody>
        </table>

    </div>
</div>

<!-- Background Overlay -->
<div id="sidebar-overlay" class="sidebar-overlay"></div>

<div id="smartBubble" onclick="openSmartSearch()">
    🤖
    <span class="smart-label">Smart Search</span>
</div>

<div id="smartOverlay">
    <div id="smartBox">

        <span class="close-btn" onclick="closeSmartSearch()">✖</span>

