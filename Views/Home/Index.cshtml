    function closeMemu() {
        document.getElementById("memuModal").style.display = "none";
    }

    function openSmartSearch() {
        document.getElementById("smartOverlay").style.display = "flex";

        // hide main results
        document.querySelector(".train-results-container")?.classList.add("blur-bg");
    }

    function closeSmartSearch() {
        document.getElementById("smartOverlay").style.display = "none";

        document.querySelector(".train-results-container")?.classList.remove("blur-bg");
    }

    const bubble = document.getElementById("smartBubble");

    let isDragging = false;
    let startX, startY;
    let moved = false;

    const DRAG_THRESHOLD = 5; // 🔥 adjust sensitivity

    // DESKTOP EVENTS
    bubble.addEventListener("mousedown", (e) => {
        isDragging = true;
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;
        moveBubble(e.clientX, e.clientY);
    });

    document.addEventListener("mouseup", () => {
        isDragging = false;
    });

    // 📱 MOBILE TOUCH EVENTS (THIS IS YOUR MISSING PART)
    bubble.addEventListener("touchstart", () => {
        isDragging = true;
    });

    document.addEventListener("touchmove", (e) => {
        if (!isDragging) return;

        const touch = e.touches[0];
        moveBubble(touch.clientX, touch.clientY);
    });

    document.addEventListener("touchend", () => {
        isDragging = false;
    });

    // COMMON MOVE FUNCTION
    function moveBubble(x, y) {
        bubble.style.left = (x - 30) + "px";
        bubble.style.top = (y - 30) + "px";
    }

    bubble.addEventListener("mousedown", (e) => {
        isDragging = true;
        moved = false;

        startX = e.clientX;
        startY = e.clientY;

        bubble.style.transition = "none";
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;

        let dx = e.clientX - startX;
        let dy = e.clientY - startY;

        // 🔥 detect real drag
        if (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD) {
            moved = true;
        }

        let x = bubble.offsetLeft + dx;
        let y = bubble.offsetTop + dy;

        x = Math.max(0, Math.min(window.innerWidth - bubble.offsetWidth, x));
        y = Math.max(0, Math.min(window.innerHeight - bubble.offsetHeight, y));

        bubble.style.left = x + "px";
        bubble.style.top = y + "px";
        bubble.style.right = "auto";
        bubble.style.bottom = "auto";
        bubble.style.position = "fixed";

        // reset start for smooth dragging
        startX = e.clientX;
        startY = e.clientY;
    });

    document.addEventListener("mouseup", () => {
        isDragging = false;

        // 🔥 delay reset (IMPORTANT)
        setTimeout(() => {
            moved = false;
        }, 50);

        bubble.style.transition = "0.3s";
    });

    // 🔥 CLICK HANDLER
    bubble.onclick = function (e) {
        if (moved) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        }

        openSmartSearch();
    };



    // automatic tatkal selection in the dropdown
    document.getElementById("homeSearchForm").addEventListener("submit", function (e) {

        // 🔴 LOGIN BLOCK (YOUR 09:45 / 10:45 LOGIC)
        if (window.forceLogin === true && window.isLoggedIn === false) {
            // ❌ DO NOT BLOCK
            // let request go to server
            return;
        }

        // existing logic
        const fromText = document.getElementById("fromStation").value;
        const toText = document.getElementById("toStation").value;

        const fromId = document.getElementById("fromStationId").value;
        const toId = document.getElementById("toStationId").value;

        saveRecentSearch(fromText, toText, fromId, toId);

        let input = document.getElementById("journeyDate");
        let parts = input.value.split("/");

        if (parts.length === 3) {
            let formatted = `${parts[2]}-${parts[1]}-${parts[0]}`;
            input.value = formatted;
        }
    });

    document.addEventListener("DOMContentLoaded", function () {

        if (window.autoTatkal === true) {
            const quotaDropdown = document.querySelector('select[name="quota"]');
            if (quotaDropdown) {
                quotaDropdown.value = "TATKAL";
            }
        }

    });

    //automatic tatkal date added on select from dropdown
    document.addEventListener("DOMContentLoaded", function () {

        let fp = flatpickr("#journeyDate", {
            dateFormat: "d/m/Y",
            defaultDate: "today",
            minDate: "today",
            maxDate: new Date().fp_incr(63),   // ✅ FINAL FIX
            disableMobile: true,
            onChange: function(selectedDates, dateStr, instance) {
                updateQuotaOptions();
            },
            onOpen: function() {
                $(".mobile-date-wrapper").addClass("focus-active");
            },
            onClose: function() {
                $(".mobile-date-wrapper").removeClass("focus-active");
            }
        });

        const quotaDropdown = document.getElementById("quota");

        quotaDropdown.addEventListener("change", function () {

            const today = new Date();
            today.setHours(0,0,0,0);

            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);

            const next7Days = new Date(today);
            next7Days.setDate(today.getDate() + 6);

            if (this.value === "TATKAL" || this.value === "PT") {

                fp.set("minDate", today);
                fp.set("maxDate", next7Days);

                fp.set("disable", [
                    function (date) {
                        date.setHours(0,0,0,0);
                        return date < today || date > next7Days;
                    }
                ]);

                fp.setDate(tomorrow);

            } else {

                fp.set("minDate", today);
                fp.set("maxDate", new Date().fp_incr(63));  // ✅ FIXED
                fp.set("disable", []);
                fp.setDate(today);
            }

        });

    });

    function updateQuotaOptions() {

        const dateInput = document.getElementById("journeyDate");

        if (!dateInput) return;

        let selectedDate = flatpickr.parseDate(
            dateInput.value,
            "d/m/Y"
        );

        if (!selectedDate) return;

        const today = new Date();
        today.setHours(0,0,0,0);

        const lastTatkalDate = new Date(today);
        lastTatkalDate.setDate(today.getDate() + 6);

        const tatkal =
            document.getElementById("tatkalOption");

        const premium =
            document.getElementById("premiumTatkalOption");

        if (tatkal) {
            tatkal.hidden = (selectedDate > lastTatkalDate);
        }
        if (premium) {
            premium.hidden = (selectedDate > lastTatkalDate);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {

        document.getElementById("journeyDate")
            .addEventListener("change", updateQuotaOptions);

        updateQuotaOptions();
    });

    // Mobile Custom Dropdown logic (Classes & Quota)
    // Mobile Custom Dropdown logic (Classes & Quota) & Input Focus
    $(function () {
        // Toggle Classes Panel
        $("#mobileClassTrigger").on("click", function (e) {
            e.stopPropagation();
            $("#mobileQuotaPanel").removeClass("open");
            $("#mobileQuotaTrigger").removeClass("focus-active has-dropdown-open");
            
            const isOpen = $("#mobileClassPanel").hasClass("open");
            if (isOpen) {
                $("#mobileClassPanel").removeClass("open");
                $("#mobileClassTrigger").removeClass("focus-active has-dropdown-open");
            } else {
                $("#mobileClassPanel").addClass("open");
                $("#mobileClassTrigger").addClass("focus-active has-dropdown-open");
            }
        });

        // Toggle Quota Panel
        $("#mobileQuotaTrigger").on("click", function (e) {
            e.stopPropagation();
            $("#mobileClassPanel").removeClass("open");
            $("#mobileClassTrigger").removeClass("focus-active has-dropdown-open");
            
            const isOpen = $("#mobileQuotaPanel").hasClass("open");
            if (isOpen) {
                $("#mobileQuotaPanel").removeClass("open");
                $("#mobileQuotaTrigger").removeClass("focus-active has-dropdown-open");
            } else {
                $("#mobileQuotaPanel").addClass("open");
                $("#mobileQuotaTrigger").addClass("focus-active has-dropdown-open");
            }
        });

        // Select Class Option
        $("#mobileClassPanel .mobile-dropdown-item").on("click", function (e) {
            e.stopPropagation();
            const val = $(this).data("value");
            const text = $(this).text().trim();
            $("#mobileClassText").text(text);
            $("#mobileClassPanel .mobile-dropdown-item").removeClass("active");
            $(this).addClass("active");
            $("#classFilterDropdown").val(val).trigger("change");
            $("#mobileClassPanel").removeClass("open");
            $("#mobileClassTrigger").removeClass("focus-active has-dropdown-open");
        });

        // Select Quota Option
        $("#mobileQuotaPanel .mobile-dropdown-item").on("click", function (e) {
            e.stopPropagation();
            const val = $(this).data("value");
            const text = $(this).text().trim();
            $("#mobileQuotaText").text(text);
            $("#mobileQuotaPanel .mobile-dropdown-item").removeClass("active");
            $(this).addClass("active");
            $("#quota").val(val).trigger("change");
            $("#mobileQuotaPanel").removeClass("open");
            $("#mobileQuotaTrigger").removeClass("focus-active has-dropdown-open");
        });

        // Close dropdowns on outside click
        $(document).on("click", function () {
            $("#mobileClassPanel, #mobileQuotaPanel").removeClass("open");
            $("#mobileClassTrigger, #mobileQuotaTrigger").removeClass("focus-active has-dropdown-open");
        });

        // Station Inputs Focus Handling
        $("#fromStation, #toStation").on("focus", function () {
            $(this).closest(".station-input-wrapper").addClass("focus-active");
        });

        $("#fromStation, #toStation").on("blur", function () {
            const $wrap = $(this).closest(".station-input-wrapper");
            setTimeout(function () {
                if (!$wrap.find(".autocomplete-list:visible").length) {
                    $wrap.removeClass("focus-active has-dropdown-open");
                }
            }, 250);
        });

        // Two-way sync: when native select changes, update mobile custom dropdown display
        $("#classFilterDropdown").on("change", function () {
            const val = $(this).val();
            const text = $(this).find("option:selected").text().trim();
            if (text) $("#mobileClassText").text(text);
            $("#mobileClassPanel .mobile-dropdown-item").removeClass("active");
            $("#mobileClassPanel .mobile-dropdown-item[data-value='" + val + "']").addClass("active");
        });

        $("#quota").on("change", function () {
            const val = $(this).val();
            const text = $(this).find("option:selected").text().trim();
            if (text) $("#mobileQuotaText").text(text);
            $("#mobileQuotaPanel .mobile-dropdown-item").removeClass("active");
            $("#mobileQuotaPanel .mobile-dropdown-item[data-value='" + val + "']").addClass("active");
        });

        // Initial sync on page load
        const initClassText = $("#classFilterDropdown option:selected").text().trim();
        if (initClassText) $("#mobileClassText").text(initClassText);

        const initQuotaText = $("#quota option:selected").text().trim();
        if (initQuotaText) $("#mobileQuotaText").text(initQuotaText);
    });

</script>

