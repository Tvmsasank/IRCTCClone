<!-- ♿ Person With Disability Concession Confirmation Modal (Home Page) -->
<div id="homePwdConcessionModal" class="concession-modal-overlay" style="display:none;" role="dialog" aria-modal="true">
    <div class="concession-modal-card">
        <div class="concession-modal-header">
            <h5>Confirmation</h5>
            <button type="button" class="concession-modal-close" onclick="closeHomePwdModal(false)" aria-label="Close">✖</button>
        </div>
        <div class="concession-modal-body">
            <p>Specially abled availing the concession need to carry Photo Identity card issued by Railways which is to be produced for On board / off board verification during journey. Escort passengers also need to carry photo identity card mentioned at the time of booking.</p>
        </div>
        <div class="concession-modal-footer">
            <button type="button" class="concession-btn-ok" onclick="closeHomePwdModal(true)">
                <i class="bi bi-check-lg me-1"></i> OK
            </button>
        </div>
    </div>
</div>

<!-- 🎫 Railway Pass Concession Confirmation Modal (Home Page) -->
<div id="homeRailwayPassModal" class="concession-modal-overlay" style="display:none;" role="dialog" aria-modal="true">
    <div class="concession-modal-card">
        <div class="concession-modal-header">
            <h5>Confirmation</h5>
            <button type="button" class="concession-modal-close" onclick="closeHomeRailwayPassModal(false)" aria-label="Close">✖</button>
        </div>
        <div class="concession-modal-body">
            <p>You are booking ticket in Railway Pass Concession. Do you want to continue?</p>
        </div>
        <div class="concession-modal-footer concession-modal-footer-two">
            <button type="button" class="concession-btn-ok" onclick="closeHomeRailwayPassModal(true)">OK</button>
            <button type="button" class="concession-btn-cancel" onclick="closeHomeRailwayPassModal(false)">Cancel</button>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    function openHomePwdModal() {
        document.getElementById("homePwdConcessionModal").style.display = "flex";
    }

    function closeHomePwdModal(isConfirmed) {
        document.getElementById("homePwdConcessionModal").style.display = "none";
        const cb = document.getElementById("homeChkDisabilityConcession");
        if (cb) {
            cb.checked = isConfirmed;
            if (isConfirmed) {
                const quotaSelect = document.getElementById("quota");
                if (quotaSelect) quotaSelect.value = "PwD";
            }
        }
    }

    function openHomeRailwayPassModal() {
        document.getElementById("homeRailwayPassModal").style.display = "flex";
    }

    function closeHomeRailwayPassModal(isConfirmed) {
        document.getElementById("homeRailwayPassModal").style.display = "none";
        const cb = document.getElementById("homeChkRailwayPassConcession");
        if (cb) {
            cb.checked = isConfirmed;
            if (isConfirmed) {
                const quotaSelect = document.getElementById("quota");
                if (quotaSelect) quotaSelect.value = "DP";
            }
        }
    }

    $(document).on("change", "#homeChkDisabilityConcession", function () {
        if (this.checked) {
            openHomePwdModal();
        }
    });

    $(document).on("change", "#homeChkRailwayPassConcession", function () {
        if (this.checked) {
            openHomeRailwayPassModal();
        }
    });

    $(document).on("click", "#homePwdConcessionModal", function (e) {
        if ($(e.target).is("#homePwdConcessionModal")) {
            closeHomePwdModal(false);
        }
    });

    $(document).on("click", "#homeRailwayPassModal", function (e) {
        if ($(e.target).is("#homeRailwayPassModal")) {
            closeHomeRailwayPassModal(false);
        }
    });

    // 🌍 GLOBAL FLAGS (accessible everywhere)
    window.isLoggedIn =
        '@ViewBag.IsLoggedIn'.toLowerCase() === 'true';

    window.forceLogin =
        '@ViewBag.ForceLogin'.toLowerCase() === 'true';

    document.addEventListener("DOMContentLoaded", function () {

        // ONLY during 07:30 → 08:15
        // AND only for logged out users
        if (window.forceLogin && !window.isLoggedIn) {

            function redirectToLogin() {
                window.location.href = '/Account/Login';
            }

            // Station inputs
            document.getElementById("fromStation")
                ?.addEventListener("focus", redirectToLogin);

            document.getElementById("toStation")
                ?.addEventListener("focus", redirectToLogin);

            // Date
            document.getElementById("journeyDate")
                ?.addEventListener("focus", redirectToLogin);

            // Class dropdown
            document.getElementById("classFilterDropdown")
                ?.addEventListener("click", redirectToLogin);

            // Quota dropdown
            document.getElementById("quota")
                ?.addEventListener("click", redirectToLogin);

            // Search button
            document.querySelector(".mainpageloginbtn")
                ?.addEventListener("click", function (e) {

                    e.preventDefault();

                    redirectToLogin();
                });
        }

        // Prevents double submits on homepage Search
        let searchSubmitted = false;
        $("#homeSearchForm").on("submit", function (e) {
            // 🚫 Do not show loader or disable button if form validation fails
            const form = this;
            if (!form.checkValidity()) {
                return;
            }
            if (!$('#fromStationId').val() || !$('#toStationId').val()) {
                return;
            }
            if ($('#fromStationId').val() === $('#toStationId').val()) {
                return;
            }

            if (searchSubmitted) {
                e.preventDefault();
                return false;
            }
            searchSubmitted = true;
            const btn = $(this).find(".mainpageloginbtn");
            btn.prop("disabled", true);
            btn.text("Searching...");
            showLoader();
        });

    });

    //SEARCH TRAINS FOR MEMU AND DEMU
    function openMemuModal() {

        const from = document.getElementById("fromStationId").value;
        const to = document.getElementById("toStationId").value;
        const dateInput = document.getElementById("journeyDate").value;
        const trainType = document.getElementById("trainTypeFilter")?.value || "";

        if (!from || !to) {
            showToast("Please enter the required inputs");
            return;
        }

        // Convert dd/MM/yyyy to yyyy-MM-dd for standard API binding
        let journeyDate = dateInput;
        const parts = dateInput.split("/");
        if (parts.length === 3) {
            journeyDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
        }

        fetch(`/GetMemuDemu/GetMD?fromId=${from}&toId=${to}&journeyDate=${journeyDate}&trainType=${trainType}`)
            .then(res => res.json())
            .then(data => {

                let html = "";

                if (!data || !Array.isArray(data) || data.length === 0) {
                    let msg = "No MEMU/DEMU/MMTS trains found";
                    if (data && data.success === false && data.message) {
                        msg = data.message;
                    }
                    html = `<tr><td colspan="7">${msg}</td></tr>`;
                } else {

                    data.forEach(t => {
                        html += `
                        <tr>
                            <td>${t.number} - ${t.name}</td>
                            <td>${t.trainType}</td>
                            <td>${t.departure}</td>
                            <td>${t.arrival}</td>
                            <td>${t.duration}</td>
                            <td>${formatRunsOn(t)}</td>
                            <td class="memu-actions">
                                <button onclick="viewSchedule(${t.id}, '${t.trainType}')">📍</button>
                                <button onclick="viewRoute(${t.id})">🗺</button>
                                <button onclick="viewLive(${t.id})">🔴</button>
                            </td>
                        </tr>`;
                    });
                }

                document.getElementById("memuBody").innerHTML = html;
                document.getElementById("memuModal").style.display = "flex";
            });
    }

    function formatRunsOn(t) {
        const days = [
            t.runMon == 1 ? "M" : "-",
            t.runTue == 1 ? "T" : "-",
            t.runWed == 1 ? "W" : "-",
            t.runThu == 1 ? "T" : "-",
            t.runFri == 1 ? "F" : "-",
            t.runSat == 1 ? "S" : "-",
            t.runSun == 1 ? "S" : "-"
        ];

        // ✅ If all 1 → Daily
        if (days.every(d => d !== "-")) {
            return "Daily";
        }

        return days.join(" ");
    }

    function viewSchedule(id, trainType) {

        fetch(`/GetMemuDemu/GetSchedule?trainId=${id}&trainType=${trainType}`)
            .then(res => res.json())
            .then(data => {

                let html = "";

                if (!data || data.length === 0) {
                    html = `<tr><td colspan="4">No schedule found</td></tr>`;
                } else {
                data.forEach((s, i) => {
                    html += `
                    <tr>
                        <td>${i + 1}</td>
                        <td>${s.stationName} (${s.stationCode})</td>
                        <td>${formatTime(s.arrivalTime)}</td>
                        <td>${formatTime(s.departureTime)}</td>
                        <td>${s.distance ?? '-'}</td>
                        <td>${s.day ?? '-'}</td>
                    </tr>`;
                });
                }

                document.getElementById("scheduleBody").innerHTML = html;
                document.getElementById("scheduleModal").style.display = "flex";
            });
    }

