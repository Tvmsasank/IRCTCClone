        border: 1px solid #cbd8ea !important;
        outline: none !important;
        box-shadow: none !important;
    }

    /* Overlay */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        display: none; /* ✅ default hidden */
        justify-content: center;
        align-items: flex-start;
        overflow-y: auto;
        padding: 80px 10px;
        z-index: 20000;
    }

    .modal-content {
        background: white;
        width: 70%;
        max-width: 800px;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        position: relative;
    }

    /* Close button */
    .modal-close {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 22px;
        font-weight: bold;
        color: #666;
        cursor: pointer;
    }

        .modal-close:hover {
