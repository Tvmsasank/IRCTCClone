<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    // 🌍 GLOBAL FLAGS (accessible everywhere)
    window.isLoggedIn =
        '@ViewBag.IsLoggedIn'.toLowerCase() === 'true';

    window.forceLogin =
        '@ViewBag.ForceLogin'.toLowerCase() === 'true';

    document.addEventListener("DOMContentLoaded", function () {

        // ONLY during 07:30 → 08:15
        // AND only for logged out users
        if (window.forceLogin && !window.isLoggedIn) {

            function redirectToLogin() {
                window.location.href = '/Account/Login';
            }

            // Station inputs
            document.getElementById("fromStation")
                ?.addEventListener("focus", redirectToLogin);

            document.getElementById("toStation")
                ?.addEventListener("focus", redirectToLogin);

            // Date
            document.getElementById("journeyDate")
                ?.addEventListener("focus", redirectToLogin);

            // Class dropdown
            document.getElementById("classFilterDropdown")
                ?.addEventListener("click", redirectToLogin);

            // Quota dropdown
            document.getElementById("quota")
                ?.addEventListener("click", redirectToLogin);

            // Search button
            document.querySelector(".mainpageloginbtn")
                ?.addEventListener("click", function (e) {

                    e.preventDefault();

                    redirectToLogin();
                });
        }

        // Prevents double submits on homepage Search
        let searchSubmitted = false;
        $("#homeSearchForm").on("submit", function (e) {
            // 🚫 Do not show loader or disable button if form validation fails
            const form = this;
            if (!form.checkValidity()) {
                return;
            }
            if (!$('#fromStationId').val() || !$('#toStationId').val()) {
                return;
            }
            if ($('#fromStationId').val() === $('#toStationId').val()) {
                return;
            }

            if (searchSubmitted) {
                e.preventDefault();
                return false;
            }
            searchSubmitted = true;
            const btn = $(this).find(".mainpageloginbtn");
            btn.prop("disabled", true);
            btn.text("Searching...");
            showLoader();
        });

    });

    //SEARCH TRAINS FOR MEMU AND DEMU
    function openMemuModal() {

        const from = document.getElementById("fromStationId").value;
        const to = document.getElementById("toStationId").value;
        const dateInput = document.getElementById("journeyDate").value;
        const trainType = document.getElementById("trainTypeFilter")?.value || "";

        if (!from || !to) {
            showToast("Please enter the required inputs");
            return;
        }

        // Convert dd/MM/yyyy to yyyy-MM-dd for standard API binding
        let journeyDate = dateInput;
        const parts = dateInput.split("/");
        if (parts.length === 3) {
            journeyDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
        }

        fetch(`/GetMemuDemu/GetMD?fromId=${from}&toId=${to}&journeyDate=${journeyDate}&trainType=${trainType}`)
            .then(res => res.json())
            .then(data => {

                let html = "";

                if (!data || !Array.isArray(data) || data.length === 0) {
                    let msg = "No MEMU/DEMU/MMTS trains found";
                    if (data && data.success === false && data.message) {
                        msg = data.message;
                    }
                    html = `<tr><td colspan="7">${msg}</td></tr>`;
                } else {

                    data.forEach(t => {
                        html += `
                        <tr>
                            <td>${t.number} - ${t.name}</td>
                            <td>${t.trainType}</td>
                            <td>${t.departure}</td>
                            <td>${t.arrival}</td>
                            <td>${t.duration}</td>
                            <td>${formatRunsOn(t)}</td>
                            <td class="memu-actions">
                                <button onclick="viewSchedule(${t.id}, '${t.trainType}')">📍</button>
                                <button onclick="viewRoute(${t.id})">🗺</button>
                                <button onclick="viewLive(${t.id})">🔴</button>
                            </td>
                        </tr>`;
                    });
                }

                document.getElementById("memuBody").innerHTML = html;
                document.getElementById("memuModal").style.display = "flex";
            });
    }

    function formatRunsOn(t) {
        const days = [
            t.runMon == 1 ? "M" : "-",
            t.runTue == 1 ? "T" : "-",
            t.runWed == 1 ? "W" : "-",
            t.runThu == 1 ? "T" : "-",
            t.runFri == 1 ? "F" : "-",
            t.runSat == 1 ? "S" : "-",
            t.runSun == 1 ? "S" : "-"
        ];

        // ✅ If all 1 → Daily
        if (days.every(d => d !== "-")) {
            return "Daily";
        }

        return days.join(" ");
    }

    function viewSchedule(id, trainType) {

        fetch(`/GetMemuDemu/GetSchedule?trainId=${id}&trainType=${trainType}`)
            .then(res => res.json())
            .then(data => {

                let html = "";

                if (!data || data.length === 0) {
                    html = `<tr><td colspan="4">No schedule found</td></tr>`;
                } else {
                data.forEach((s, i) => {
                    html += `
                    <tr>
                        <td>${i + 1}</td>
                        <td>${s.stationName} (${s.stationCode})</td>
                        <td>${formatTime(s.arrivalTime)}</td>
                        <td>${formatTime(s.departureTime)}</td>
                        <td>${s.distance ?? '-'}</td>
                        <td>${s.day ?? '-'}</td>
                    </tr>`;
                });
                }

                document.getElementById("scheduleBody").innerHTML = html;
                document.getElementById("scheduleModal").style.display = "flex";
            });
    }

    // function viewRoute(id) {
    //     fetch(`/GetMemuDemu/GetSchedule?trainId=${id}&trainType=${trainType}`)
    //         .then(res => res.json())
    //         .then(data => {

    //             let html = "";

    //             if (!data || data.length === 0) {
    //                 html =`<tr><td colspan="4">No routes found for the selected train</td></td>`;
    //             } else {
    //                 data.forEach((s, i => {
    //                     html += `
    //                     `
    //                 }
    //             }
    //         }
    // }

    function formatTime(t) {
        if (!t || t === "NULL") return "--";

        // Convert to string (safe)
        let time = t.toString();

        // Remove milliseconds if present
        if (time.includes(".")) {
            time = time.split(".")[0];
        }

        // Remove seconds → HH:mm
        let parts = time.split(":");

        if (parts.length >= 2) {
            return parts[0] + ":" + parts[1];
        }

        return time;
    }

    function closeSchedule() {
        document.getElementById("scheduleModal").style.display = "none";
    }

    function viewRoute(id) {
        alert("Route Map: " + id);
    }

    function viewLive(id) {
        alert("Live Status: " + id);
    }

    function closeMemu() {
        document.getElementById("memuModal").style.display = "none";
    }

    function openSmartSearch() {
        document.getElementById("smartOverlay").style.display = "flex";

        // hide main results
        document.querySelector(".train-results-container")?.classList.add("blur-bg");
    }

    function closeSmartSearch() {
        document.getElementById("smartOverlay").style.display = "none";

        document.querySelector(".train-results-container")?.classList.remove("blur-bg");
    }

    const bubble = document.getElementById("smartBubble");

    let isDragging = false;
    let startX, startY;
    let moved = false;

    const DRAG_THRESHOLD = 5; // 🔥 adjust sensitivity

    // DESKTOP EVENTS
    bubble.addEventListener("mousedown", (e) => {
        isDragging = true;
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;
        moveBubble(e.clientX, e.clientY);
    });

    document.addEventListener("mouseup", () => {
        isDragging = false;
    });

    // 📱 MOBILE TOUCH EVENTS (THIS IS YOUR MISSING PART)
    bubble.addEventListener("touchstart", () => {
        isDragging = true;
    });

    document.addEventListener("touchmove", (e) => {
        if (!isDragging) return;

        const touch = e.touches[0];
        moveBubble(touch.clientX, touch.clientY);
    });

    document.addEventListener("touchend", () => {
        isDragging = false;
    });

    // COMMON MOVE FUNCTION
    function moveBubble(x, y) {
        bubble.style.left = (x - 30) + "px";
        bubble.style.top = (y - 30) + "px";
    }

    bubble.addEventListener("mousedown", (e) => {
        isDragging = true;
        moved = false;

        startX = e.clientX;
        startY = e.clientY;

        bubble.style.transition = "none";
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;

        let dx = e.clientX - startX;
        let dy = e.clientY - startY;

        // 🔥 detect real drag
        if (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD) {
            moved = true;
        }

        let x = bubble.offsetLeft + dx;
        let y = bubble.offsetTop + dy;

        x = Math.max(0, Math.min(window.innerWidth - bubble.offsetWidth, x));
        y = Math.max(0, Math.min(window.innerHeight - bubble.offsetHeight, y));

        bubble.style.left = x + "px";
        bubble.style.top = y + "px";
        bubble.style.right = "auto";
        bubble.style.bottom = "auto";
        bubble.style.position = "fixed";

        // reset start for smooth dragging
        startX = e.clientX;
        startY = e.clientY;
    });

    document.addEventListener("mouseup", () => {
        isDragging = false;

        // 🔥 delay reset (IMPORTANT)
        setTimeout(() => {
            moved = false;
        }, 50);

        bubble.style.transition = "0.3s";
    });

    // 🔥 CLICK HANDLER
    bubble.onclick = function (e) {
        if (moved) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        }

        openSmartSearch();
    };

        document.addEventListener("DOMContentLoaded", function () {

        flatpickr("#journeyDate", {
            dateFormat: "d/m/Y",        // UI format like IRCTC
            defaultDate: "today",       // auto select today
            minDate: "today",
            maxDate: new Date().fp_incr(63), // 63 days limit

            showMonths: 1,
            disableMobile: true,        // force desktop style

            onChange: function(selectedDates, dateStr, instance) {

                updateQuotaOptions();
            }
        });

    });

    // automatic tatkal selection in the dropdown
    document.getElementById("homeSearchForm").addEventListener("submit", function (e) {

        // 🔴 LOGIN BLOCK (YOUR 09:45 / 10:45 LOGIC)
        if (window.forceLogin === true && window.isLoggedIn === false) {
            // ❌ DO NOT BLOCK
            // let request go to server
            return;
        }

        // existing logic
        const fromText = document.getElementById("fromStation").value;
        const toText = document.getElementById("toStation").value;

        const fromId = document.getElementById("fromStationId").value;
        const toId = document.getElementById("toStationId").value;

        saveRecentSearch(fromText, toText, fromId, toId);

        let input = document.getElementById("journeyDate");
        let parts = input.value.split("/");

        if (parts.length === 3) {
            let formatted = `${parts[2]}-${parts[1]}-${parts[0]}`;
            input.value = formatted;
        }
    });

    document.addEventListener("DOMContentLoaded", function () {

        if (window.autoTatkal === true) {
            const quotaDropdown = document.querySelector('select[name="quota"]');
            if (quotaDropdown) {
                quotaDropdown.value = "TATKAL";
            }
        }

    });

    //automatic tatkal date added on select from dropdown
    document.addEventListener("DOMContentLoaded", function () {

        let fp = flatpickr("#journeyDate", {
            dateFormat: "d/m/Y",
            defaultDate: "today",
            minDate: "today",
            maxDate: new Date().fp_incr(63),   // ✅ FINAL FIX
            disableMobile: true
        });

        const quotaDropdown = document.getElementById("quota");

        quotaDropdown.addEventListener("change", function () {

            const today = new Date();
            today.setHours(0,0,0,0);

            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);

            const next7Days = new Date(today);
            next7Days.setDate(today.getDate() + 6);

            if (this.value === "TATKAL" || this.value === "PT") {

                fp.set("minDate", today);
                fp.set("maxDate", next7Days);

                fp.set("disable", [
                    function (date) {
                        date.setHours(0,0,0,0);
                        return date < today || date > next7Days;
                    }
                ]);

                fp.setDate(tomorrow);

            } else {

                fp.set("minDate", today);
                fp.set("maxDate", new Date().fp_incr(63));  // ✅ FIXED
                fp.set("disable", []);
                fp.setDate(today);
            }

        });

    });

    function updateQuotaOptions() {

        const dateInput = document.getElementById("journeyDate");

        if (!dateInput) return;

        let selectedDate = flatpickr.parseDate(
            dateInput.value,
            "d/m/Y"
        );

        if (!selectedDate) return;

        const today = new Date();
        today.setHours(0,0,0,0);

        const lastTatkalDate = new Date(today);
        lastTatkalDate.setDate(today.getDate() + 6);

        const tatkal =
            document.getElementById("tatkalOption");

        const premium =
            document.getElementById("premiumTatkalOption");

        if (tatkal) {
            tatkal.hidden = (selectedDate > lastTatkalDate);
        }
        if (premium) {
            premium.hidden = (selectedDate > lastTatkalDate);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {

        document.getElementById("journeyDate")
            .addEventListener("change", updateQuotaOptions);

        updateQuotaOptions();
    });

</script>

<style>
    .date-input {
        width: 100%;
        padding: 11.5px;
        border-radius: 6px;
        border: 1px solid #cbd8ea !important;
        background-color: #fff;
    }

        /* REMOVE BLACK BORDER ON CLICK */
        .date-input:focus {
            border: 1px solid #cbd8ea !important;
            outline: none !important;
            box-shadow: none !important;
        }

    /* Calendar popup */
    .flatpickr-calendar {
        border-radius: 10px;
    }

    /* Selected date */
    .flatpickr-day.selected {
        background: #2b4dbb;
        border-color: #2b4dbb;
    }

    /* Hover */
    .flatpickr-day:hover {
        background: #e6ecff;
    }

    /* ALSO HANDLE FLATPICKR ACTIVE STATE */
