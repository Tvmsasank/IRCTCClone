        function toggleSectionSelectAll(section) {
            const selectorMap = {
                'class': '.class-filter-cb',
                'type': '.type-filter-cb',
                'deptime': '.dep-time-cb',
                'arrtime': '.arr-time-cb',
                'fromstn': '.fromstn-filter-cb',
                'tostn': '.tostn-filter-cb'
            };
            const selector = selectorMap[section];
            if (!selector) return;

            const cbs = document.querySelectorAll(selector);
            const anyUnchecked = Array.from(cbs).some(cb => !cb.checked);
            const newState = anyUnchecked; // if any unchecked, select all; else deselect all

            cbs.forEach(cb => cb.checked = newState);

            const link = document.getElementById('selAll-' + section);
            if (link) {
                link.innerText = newState ? 'Deselect All' : 'Select All';
            }

            filterTrains();
