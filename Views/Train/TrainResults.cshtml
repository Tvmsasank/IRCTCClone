        }

        function toggleSortMenu() {
            const menu = document.getElementById("sortMenu");
            menu.style.display = menu.style.display === "block" ? "none" : "block";
        }

        // Close dropdown when clicking outside
        document.addEventListener("click", function (e) {
            const btn = document.getElementById("sortBtn");
            const menu = document.getElementById("sortMenu");

            if (!btn.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = "none";
            }
        });

        function toggleFareModal(el){

            // close other modals
            document.querySelectorAll(".fare-modal")
                .forEach(m => m.style.display="none");

            const modal = el.querySelector(".fare-modal");

            modal.style.display = "block";

            // click outside closes it
            document.addEventListener("click", function handler(e){
                if(!el.contains(e.target)){
                    modal.style.display="none";
                    document.removeEventListener("click", handler);
                }
            });
        }

        function handleLiveStatus(event, trainNo) {

            event.preventDefault();
            event.stopPropagation();

            navigator.clipboard.writeText(trainNo)
                .then(() => {
                    alert("Train number " + trainNo + " copied!");

                    // Open after successful copy
                    window.open("https://enquiry.indianrail.gov.in/mntes/", "_blank");
                })
                .catch(() => {
                    alert("Copy failed. Please copy manually: " + trainNo);

                    // Still open site
                    window.open("https://enquiry.indianrail.gov.in/mntes/", "_blank");
                });
        }

        document.addEventListener("click", function (e) {
            if (e.target && e.target.id === "closeRouteMismatch") {
                e.preventDefault();

                fetch('/Train/ClearRouteMismatch', {
                    method: 'POST'
                })
                .then(res => {
                    if (res.ok) {
                        document.querySelector(".modal-overlay").style.display = "none";
                    }
                })
                .catch(err => console.error(err));
            }
        });

        function openSmartSearch() {
            document.getElementById("smartOverlay").style.display = "flex";

            // hide main results
            document.querySelector(".train-results-container")?.classList.add("blur-bg");
        }

            function closeSmartSearch() {
                document.getElementById("smartOverlay").style.display = "none";

                document.querySelector(".train-results-container")?.classList.remove("blur-bg");
            }

        const bubble = document.getElementById("smartBubble");

        let isDragging = false;
        let startX, startY;
        let moved = false;

        const DRAG_THRESHOLD = 5; // 🔥 adjust sensitivity

        bubble.addEventListener("mousedown", (e) => {
            isDragging = true;
            moved = false;

            startX = e.clientX;
            startY = e.clientY;

            bubble.style.transition = "none";
        });

        document.addEventListener("mousemove", (e) => {
            if (!isDragging) return;

            let dx = e.clientX - startX;
            let dy = e.clientY - startY;

            // 🔥 detect real drag
            if (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD) {
                moved = true;
            }

            let x = bubble.offsetLeft + dx;
            let y = bubble.offsetTop + dy;

            x = Math.max(0, Math.min(window.innerWidth - bubble.offsetWidth, x));
            y = Math.max(0, Math.min(window.innerHeight - bubble.offsetHeight, y));

            bubble.style.left = x + "px";
            bubble.style.top = y + "px";
            bubble.style.right = "auto";
            bubble.style.bottom = "auto";
            bubble.style.position = "fixed";

            // reset start for smooth dragging
            startX = e.clientX;
            startY = e.clientY;
        });

        document.addEventListener("mouseup", () => {
            isDragging = false;

            // 🔥 delay reset (IMPORTANT)
            setTimeout(() => {
                moved = false;
            }, 50);

            bubble.style.transition = "0.3s";
        });

        // 🔥 CLICK HANDLER
        bubble.onclick = function (e) {
            if (moved) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }

            openSmartSearch();
        };

        function openMap(url) {
            if (!url) {
                showToast("Route not available");
                return;
            }

            window.open(url, "_blank");
        }

        function loadTrainAlerts(trainId) {

            fetch('/Train/GetTrainAlerts?trainId=' + trainId)
                .then(res => res.json())
                .then(data => {

                    let html = "";

                    if (!data || data.length === 0) {
                        html = `<tr><td colspan="2">No updates available</td></tr>`;
                    } else {

                        data.forEach(a => {

                            let color = "black";

                            if (a.type === "Cancelled") color = "red";
                            else if (a.type === "Skipped") color = "orange";
                            else if (a.type === "Diverted") color = "blue";
                            else if (a.type === "Temporary Stop") color = "green";

                            html += `
                                <tr>
                                    <td style="color:${color}; font-weight:600;">
                                        ${a.type}
                                    </td>
                                    <td>${a.message}</td>
                                </tr>
                            `;
                        });
                    }

                    document.getElementById("alertBody").innerHTML = html;

                    // 🔥 OPEN MODAL
                    document.getElementById("alertModal").style.display = "flex";
                })
                .catch(err => {
                    console.error("Error:", err);
                });
        }

        function closeAlertModal() {
            document.getElementById("alertModal").style.display = "none";
        }

</script>

