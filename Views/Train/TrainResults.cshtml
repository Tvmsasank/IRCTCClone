@model IEnumerable<IRCTCClone.Models.Train>
@using IRCTCClone.E_D
@using IRCTCClone.Helpers
@using IRCTCClone.Models
@using IrctcClone.Helpers

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

@{
    ViewData["Title"] = "Train Results";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var journey = TempData.Peek("JourneyDate")?.ToString()
                  ?? DateTime.Today.ToString("yyyy-MM-dd");

    var journeyDateRaw = TempData.Peek("JourneyDate");

    DateTime journeyDate = DateTime.Today;

    if (journeyDateRaw != null && DateTime.TryParse(journeyDateRaw.ToString(), out journeyDate))
    {
        journey = journeyDate.ToString("yyyy-MM-dd");
    }
    else
    {
        journey = DateTime.Today.ToString("yyyy-MM-dd");
    }

    //var minDate = DateTime.Today.ToString("yyyy-MM-dd");

    var indiaTime = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(
        DateTime.UtcNow,
        "India Standard Time"
    );

    // var maxDate = indiaTime.TimeOfDay < new TimeSpan(8,0,0)
    //     ? indiaTime.Date.AddDays(59)
    //     : indiaTime.Date.AddDays(63);

    var window = ReservationHelper.GetReservationWindow();

    var minDate = window.min.ToString("yyyy-MM-dd");
    var maxDate = window.max.ToString("yyyy-MM-dd");

    var fromStation = TempData.Peek("FromStation")?.ToString();
    var toStation = TempData.Peek("ToStation")?.ToString();

    var userfromid = TempData.Peek("fromStationId");
    var usertoid = TempData.Peek("toStationId");

    var trainscount = ViewBag.ResultCount;

    var routeMismatch = TempData["RouteMismatch"];
    var searchedFrom = TempData["SearchedFrom"];
    var searchedTo = TempData["SearchedTo"];
    var actualFrom = TempData["ActualFrom"];
    var actualTo = TempData["ActualTo"];
    var trainId = TempData["trainId"];
    var classId = TempData["classId"];
    var classCode = TempData["classCode"];
    var actualFromId = TempData["ActualFromId"];
    var actualToId = TempData["ActualToId"];
    var routeJourneyDate = TempData["journeyDate"];

    TempData.Remove("RouteMismatch");
}

<section class="results-page fadeInUp">
    <div class="results-container">

         <!-- ✅ SEARCH SUMMARY BAR (ADD HERE) -->
        @{
            DateTime jd = DateTime.Today;

            if (ViewBag.JourneyDate != null)
            {
                DateTime.TryParse(ViewBag.JourneyDate.ToString(), out jd);
            }
        }

        <!-- ✅ END SEARCH SUMMARY BAR --> 

        @{
            string CleanStation(string s)
            {
                if (string.IsNullOrEmpty(s)) return s;
                var idx = s.IndexOf(" - ");
                return idx > 0 ? s.Substring(0, idx) : s;
            }

            var cleanFrom = CleanStation(fromStation);
            var cleanTo = CleanStation(toStation);

            string GetClassDisplayName(string code) {
                if (string.IsNullOrEmpty(code)) return "";
                string upper = code.ToUpper();
                if (upper.Contains("(1A)") || upper == "1A" || upper.Contains("FIRST CLASS")) return "AC First Class (1A)";
                if (upper.Contains("(2S)") || upper == "2S" || upper.Contains("SECOND SITTING")) return "Second Sitting (2S)";
                if (upper.Contains("(3E)") || upper == "3E" || upper.Contains("3 ECONOMY") || upper.Contains("3RD ECONOMY")) return "AC 3 Economy (3E)";
                if (upper.Contains("(SL)") || upper == "SL" || upper.Contains("SLEEPER")) return "Sleeper (SL)";
                if (upper.Contains("(2A)") || upper == "2A" || upper.Contains("2 TIER")) return "AC 2 Tier (2A)";
                if (upper.Contains("(3A)") || upper == "3A" || upper.Contains("3 TIER")) return "AC 3 Tier (3A)";
                if (upper.Contains("(CC)") || upper == "CC" || (upper.Contains("CHAIR CAR") && !upper.Contains("EXEC"))) return "AC Chair car (CC)";
                if (upper.Contains("(EC)") || upper == "EC" || upper.Contains("EXECUTIVE") || upper.Contains("EXEC. CHAIR")) return "Exec. Chair Car (EC)";
                if (upper.Contains("(EA)") || upper == "EA" || upper.Contains("ANUBHUTI")) return "Anubhuti Class (EA)";
                if (upper.Contains("(EV)") || upper == "EV" || upper.Contains("VISTADOME AC")) return "Vistadome AC (EV)";
                if (upper.Contains("(VS)") || upper == "VS" || upper.Contains("VISTADOME NON")) return "Vistadome Non AC (VS)";
                return code;
            }

            string GetClassShortCode(string code) {
                if (string.IsNullOrEmpty(code)) return "";
                string upper = code.ToUpper();
                if (upper.Contains("(1A)") || upper == "1A") return "1A";
                if (upper.Contains("(2S)") || upper == "2S") return "2S";
                if (upper.Contains("(3E)") || upper == "3E") return "3E";
                if (upper.Contains("(SL)") || upper == "SL") return "SL";
                if (upper.Contains("(2A)") || upper == "2A") return "2A";
                if (upper.Contains("(3A)") || upper == "3A") return "3A";
                if (upper.Contains("(CC)") || upper == "CC") return "CC";
                if (upper.Contains("(EC)") || upper == "EC") return "EC";
                if (upper.Contains("(EA)") || upper == "EA") return "EA";
                if (upper.Contains("(EV)") || upper == "EV") return "EV";
                if (upper.Contains("(VS)") || upper == "VS") return "VS";
                if (code.Contains("(") && code.Contains(")")) {
                    int s = code.IndexOf("(") + 1;
                    int e = code.IndexOf(")");
                    return code.Substring(s, e - s).Trim().ToUpper();
                }
                return code.Trim().ToUpper();
            }

            var classOrder = new List<string> { "1A", "2S", "3E", "SL", "2A", "3A", "CC", "EC", "EA", "EV", "VS" };

            var availableClasses = Model?
                .Where(t => t.Classes != null)
                .SelectMany(t => t.Classes)
                .GroupBy(c => GetClassShortCode(c.Code))
                .Select(g => new {
                    ShortCode = g.Key,
                    FullName = GetClassDisplayName(g.First().Code)
                })
                .Where(x => !string.IsNullOrEmpty(x.ShortCode))
                .OrderBy(x => {
                    int idx = classOrder.IndexOf(x.ShortCode);
                    return idx >= 0 ? idx : 99;
                })
                .ToList();

            var availableTypes = new[]
            {
                new { Type = "rajdhani", Name = "Rajdhani", Dot = "rajdhani" },
                new { Type = "shatabdi", Name = "Shatabdi", Dot = "shatabdi" },
                new { Type = "duronto", Name = "Duronto", Dot = "duronto" },
                new { Type = "vande-bharat", Name = "Vande Bharat", Dot = "vande" },
                new { Type = "amrit-bharat", Name = "Amrit Bharat", Dot = "amrit" },
                new { Type = "garib-rath", Name = "Garib Rath", Dot = "garib" },
                new { Type = "special", Name = "Special Trains", Dot = "special" },
                new { Type = "normal", Name = "Other Trains", Dot = "normal" }
            }.ToList();
        }

        @{
            string sortLabel = "None";

            switch (ViewBag.CurrentSort as string)
            {
                case "DEP_EARLY":
                    sortLabel = "Departure – Early First";
                    break;
                case "DEP_LATE":
                    sortLabel = "Departure – Late First";
                    break;
                case "ARR_EARLY":
                    sortLabel = "Arrival – Early First";
                    break;
                case "ARR_LATE":
                    sortLabel = "Arrival – Late First";
                    break;
                case "DUR_SHORT":
                    sortLabel = "Duration – Shortest First";
                    break;
                case "DUR_LONG":
                    sortLabel = "Duration – Longest First";
                    break;
                default:
                    sortLabel = "Departure - Early First";
                    break;
            }
        }

        <!-- ✅ STICKY RESULTS HEADER -->
        <div class="sticky-top-block" id="stickyTopBlock">

            <!-- 📱 Mobile Compact Route Summary Bar (<= 991px, matching official IRCTC) -->
            <div class="mobile-search-compact-bar" id="mobileSearchCompactBar" onclick="toggleMobileModifySearch()">
                <div class="mobile-summary-left">
                    <a href="/" class="mobile-back-btn" onclick="event.stopPropagation();" title="Back to Home">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div class="mobile-summary-text-group">
                        <span class="summary-stns">@cleanFrom TO @cleanTo</span>
                        <span class="summary-date">| @(((DateTime)journeyDate).ToString("ddd, dd MMM"))</span>
                    </div>
                </div>
                <button type="button" class="mobile-edit-pencil-btn" id="mobileEditPencilBtn" aria-label="Modify Search">
                    <i class="bi bi-pencil-fill"></i>
                </button>
            </div>

            <!-- 1️⃣ Route / Date selector -->
            <div class="route-search-bar" id="routeSearchBarContainer">
                <div class="search-summary uniform-modify-bar">
                    <form id="modifySearchForm" method="post" action="/Train/TrainResults" novalidate>
                        <div class="modify-search-fields">

                            <!-- FROM STATION -->
                            <div class="station-box1 uniform-input-wrapper">
                                <i class="bi bi-cursor-fill input-field-icon"></i>
                                <input type="text"
                                       id="fromStation"
                                       name="fromStation"
                                       class="uniform-search-input"
                                       value="@fromStation"
                                       autocomplete="off"
                                       placeholder="From Station"
                                       required />

                                <input type="hidden"
                                       id="fromStationId"
                                       name="fromStationId"
                                       value="@userfromid" />

                                <div id="fromStationList" class="autocomplete-list-trainresults-page" style="display:none;"></div>
                            </div>

                            <!-- SWAP BUTTON -->
                            <button type="button" class="uniform-swap-btn" id="swapStationsNew" title="Swap Stations">
                                ⇄
                            </button>

                            <!-- TO STATION -->
                            <div class="station-box2 uniform-input-wrapper">
                                <i class="bi bi-geo-alt-fill input-field-icon"></i>
                                <input type="text"
                                       id="toStation"
                                       name="toStation"
                                       class="uniform-search-input"
                                       value="@toStation"
                                       autocomplete="off"
                                       placeholder="To Station"
                                       required />

                                <input type="hidden"
                                       id="toStationId"
                                       name="toStationId"
                                       value="@usertoid" />

                                <div id="toStationList" class="autocomplete-list-trainresults-page" style="display:none;"></div>
                            </div>

                            <!-- DATE -->
                            <div class="uniform-input-wrapper uniform-date-wrapper">
                                <i class="bi bi-calendar3 input-field-icon" style="cursor: pointer; pointer-events: auto;"></i>
                                <input type="text"
                                       id="journeyDatePicker"
                                       name="journeyDate"
                                       class="uniform-search-input uniform-date-input"
                                       value="@journey"
                                       placeholder="DD-MM-YYYY"
                                       autocomplete="off"
                                       style="cursor: pointer;" />
                            </div>

                            <!-- CLASSES DROPDOWN-->
                            <div class="uniform-input-wrapper uniform-select-wrapper uniform-class-wrapper">
                                <i class="bi bi-briefcase-fill input-field-icon"></i>
                                <select id="classFilterDropdown" name="classCode" class="uniform-search-input uniform-select-input">
                                    <option value="ALL" selected="@(ViewBag.classCode == null || ViewBag.classCode == "ALL")">All Classes</option>
                                    <option value="EA" selected="@(ViewBag.classCode == "EA")">Anubhuti Class (EA)</option>
                                    <option value="1A" selected="@(ViewBag.classCode == "1A")">AC First Class (1A)</option>
                                    <option value="EV" selected="@(ViewBag.classCode == "EC")">Vistadome AC (EV)</option>
                                    <option value="EC" selected="@(ViewBag.classCode == "EC")">Exec. Chair Car (EC)</option>
                                    <option value="2A" selected="@(ViewBag.classCode == "2A")">AC 2 Tier (2A)</option>
                                    <option value="FC" selected="@(ViewBag.classCode == "FC")">First Class (FC)</option>
                                    <option value="3A" selected="@(ViewBag.classCode == "3A")">AC 3 Tier (3A)</option>
                                    <option value="3E" selected="@(ViewBag.classCode == "3E")">AC 3 Economy (3E)</option>
                                    <option value="VS" selected="@(ViewBag.classCode == "VS")">Vistadome Non AC (VS)</option>
                                    <option value="2S" selected="@(ViewBag.classCode == "2S")">Second Sitting (2S)</option>
                                </select>
                            </div>

                            <!-- QUOTA -->
                            <div class="uniform-input-wrapper uniform-select-wrapper uniform-quota-wrapper">
                                <i class="bi bi-grid-3x3-gap-fill input-field-icon"></i>
                                <select name="quota" id="modifyQuotaDropdown" class="uniform-search-input uniform-select-input">
                                    <option value="GENERAL" selected="@(ViewBag.Quota?.ToString() == "GENERAL")">GENERAL</option>
                                    <option value="LADIES" selected="@(ViewBag.Quota?.ToString() == "LADIES")">LADIES</option>
                                    <option value="SENIOR" selected="@(ViewBag.Quota?.ToString() == "SENIOR")">LOWER BERTH/SENIOR CITIZEN</option>
                                    <option value="PwD" selected="@(ViewBag.Quota?.ToString() == "PwD")">PERSON WITH DISABILITY</option>
                                    <option value="DP" selected="@(ViewBag.Quota?.ToString() == "DP")">DUTY PASS</option>
                                    <option value="TATKAL" selected="@(ViewBag.Quota?.ToString() == "TATKAL")">TATKAL</option>
                                    <option value="PT" selected="@(ViewBag.Quota?.ToString() == "PT")">PREMIUM TATKAL</option>
                                </select>
                            </div>

                            <!-- MODIFY BUTTON -->
                            <button type="submit" class="modify-btn uniform-modify-btn">
                                Modify Search
                            </button>

                        </div>

                        <!-- 3 CONCESSION CHECKBOXES ROW (BELOW INPUTS, CENTERED) -->
                        <div class="modify-search-options">
                            <label class="concession-checkbox-label">
                                <input type="checkbox" id="chkFlexibleWithDate" name="flexibleWithDate" value="true" @(ViewBag.FlexibleWithDate == true ? "checked" : "") />
                                <span>Flexible With Date</span>
                            </label>

                            <label class="concession-checkbox-label">
                                <input type="checkbox" id="chkDisabilityConcession" name="pwdConcession" value="true" @(ViewBag.PwdConcession == true ? "checked" : "") />
                                <span>Person With Disability Concession</span>
                            </label>

                            <label class="concession-checkbox-label">
                                <input type="checkbox" id="chkRailwayPassConcession" name="railwayPassConcession" value="true" @(ViewBag.RailwayPassConcession == true ? "checked" : "") />
                                <span>Railway Pass Concession</span>
                            </label>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- 📱 Mobile Action Bar: Sort By & Filter (Matching official IRCTC media_1789704347765.jpg) -->
        <div class="mobile-action-bar">
            <div class="mobile-action-left">
                <button type="button" class="mobile-sort-btn" id="mobileSortBtn" onclick="toggleMobileSortMenu()">
                    <span>Sort By</span>
                    <i class="bi bi-caret-down-fill ms-1" style="font-size: 10px;"></i>
                </button>
                <div class="mobile-day-nav">
                    <button type="button" class="mobile-day-btn" onclick="navigateDay(-1)" title="Previous Day">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="mobile-day-text">@(((DateTime)journeyDate).ToString("dd MMM"))</span>
                    <button type="button" class="mobile-day-btn" onclick="navigateDay(1)" title="Next Day">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div class="mobile-action-right">
                <button type="button" class="mobile-filter-funnel-btn" onclick="toggleMobileFilterDrawer()" aria-label="Refine Results" title="Refine Results">
                    <i class="bi bi-funnel-fill"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Sort Dropdown Menu -->
        <div id="mobileSortMenu" class="mobile-sort-dropdown" style="display:none;">
            <div class="mobile-sort-item @(ViewBag.CurrentSort == "DUR_SHORT" ? "active" : "")" onclick="applySort('DUR_SHORT')">
                <span>Duration <small class="text-muted ms-1">Shortest First</small></span>
            </div>
            <div class="mobile-sort-item @(ViewBag.CurrentSort == "DUR_LONG" ? "active" : "")" onclick="applySort('DUR_LONG')">
                <span>Duration <small class="text-muted ms-1">Longest First</small></span>
            </div>
            <div class="mobile-sort-item @(ViewBag.CurrentSort == "DEP_EARLY" ? "active" : "")" onclick="applySort('DEP_EARLY')">
                <span>Departure <small class="text-muted ms-1">Early First</small></span>
            </div>
            <div class="mobile-sort-item @(ViewBag.CurrentSort == "DEP_LATE" ? "active" : "")" onclick="applySort('DEP_LATE')">
                <span>Departure <small class="text-muted ms-1">Late First</small></span>
            </div>
            <div class="mobile-sort-item @(ViewBag.CurrentSort == "ARR_EARLY" ? "active" : "")" onclick="applySort('ARR_EARLY')">
                <span>Arrival <small class="text-muted ms-1">Early First</small></span>
            </div>
            <div class="mobile-sort-item @(ViewBag.CurrentSort == "ARR_LATE" ? "active" : "")" onclick="applySort('ARR_LATE')">
                <span>Arrival <small class="text-muted ms-1">Late First</small></span>
            </div>
        </div>

        <div class="mobile-filter-backdrop" id="mobileFilterBackdrop" onclick="toggleMobileFilterDrawer()"></div>

        <div class="results-main-layout">
            <!-- Left Column: Refine Results Sidebar -->
            <aside class="refine-sidebar" id="refineSidebar">
                <div class="sidebar-filter-card">
                    <div class="filter-header">
                        <div class="filter-header-left">
                            <i class="bi bi-funnel"></i>
                            <h3>Refine Results</h3>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <button type="button" class="clear-filter-btn" onclick="resetAllFilters()">Reset All</button>
                            <button type="button" class="mobile-filter-close-btn" onclick="toggleMobileFilterDrawer()" aria-label="Close filters">&times;</button>
                        </div>
                    </div>
                    
                    <!-- 1. JOURNEY CLASS (COLLAPSIBLE ACCORDION) -->
                    <div class="refine-accordion open" id="acc-class">
                        <div class="accordion-header" onclick="toggleAccordion('acc-class')">
                            <span class="acc-title">Journey Class</span>
                            <div class="acc-actions">
                                <a href="javascript:void(0)" onclick="event.stopPropagation(); toggleSectionSelectAll('class')" id="selAll-class" class="acc-link">Deselect All</a>
                                <i class="bi bi-chevron-down acc-chevron"></i>
                            </div>
                        </div>
                        <div class="accordion-body">
                            <div class="filter-options-grid-2col">
                                @if (availableClasses != null && availableClasses.Any())
                                {
                                    @foreach (var cls in availableClasses)
                                    {
                                        <label class="filter-checkbox-label">
                                            <input type="checkbox" class="class-filter-cb" value="@cls.ShortCode" checked />
                                            <span>@cls.FullName</span>
                                        </label>
                                    }
                                }
                                else
                                {
                                    <div style="font-size:11px; color:#64748b; padding:4px;">No classes available</div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 2. TRAIN TYPE (COLLAPSIBLE ACCORDION) -->
                    <div class="refine-accordion open" id="acc-type">
                        <div class="accordion-header" onclick="toggleAccordion('acc-type')">
                            <span class="acc-title">Train Type</span>
                            <div class="acc-actions">
                                <a href="javascript:void(0)" onclick="event.stopPropagation(); toggleSectionSelectAll('type')" id="selAll-type" class="acc-link">Deselect All</a>
                                <i class="bi bi-chevron-down acc-chevron"></i>
                            </div>
                        </div>
                        <div class="accordion-body">
                            <div class="filter-options-grid-2col">
                                @if (availableTypes != null && availableTypes.Any())
                                {
                                    @foreach (var ttype in availableTypes)
                                    {
                                        <label class="filter-checkbox-label">
                                            <input type="checkbox" class="type-filter-cb" value="@ttype.Type" checked />
                                            <span><span class="legend-color-dot @ttype.Dot"></span> @ttype.Name</span>
                                        </label>
                                    }
                                }
                                else
                                {
                                    <div style="font-size:11px; color:#64748b; padding:4px;">No train types available</div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 3. DEPARTURE TIME (COLLAPSIBLE ACCORDION) -->
                    <div class="refine-accordion open" id="acc-deptime">
                        <div class="accordion-header" onclick="toggleAccordion('acc-deptime')">
                            <span class="acc-title">Departure Time</span>
                            <div class="acc-actions">
                                <a href="javascript:void(0)" onclick="event.stopPropagation(); toggleSectionSelectAll('deptime')" id="selAll-deptime" class="acc-link">Deselect All</a>
                                <i class="bi bi-chevron-down acc-chevron"></i>
                            </div>
                        </div>
                        <div class="accordion-body">
                            <div class="time-slot-grid">
                                <label class="time-slot-card">
                                    <input type="checkbox" class="dep-time-cb" value="early_morning" checked />
                                    <div class="time-slot-content">
                                        <div class="slot-time">00:00 - 06:00</div>
                                        <div class="slot-label"><i class="bi bi-moon-stars"></i> Early Morning</div>
                                    </div>
                                </label>
                                <label class="time-slot-card">
                                    <input type="checkbox" class="dep-time-cb" value="morning" checked />
                                    <div class="time-slot-content">
                                        <div class="slot-time">06:00 - 12:00</div>
                                        <div class="slot-label"><i class="bi bi-sun"></i> Morning</div>
                                    </div>
                                </label>
                                <label class="time-slot-card">
                                    <input type="checkbox" class="dep-time-cb" value="mid_day" checked />
                                    <div class="time-slot-content">
                                        <div class="slot-time">12:00 - 18:00</div>
                                        <div class="slot-label"><i class="bi bi-brightness-high"></i> Mid Day</div>
                                    </div>
                                </label>
                                <label class="time-slot-card">
                                    <input type="checkbox" class="dep-time-cb" value="night" checked />
                                    <div class="time-slot-content">
                                        <div class="slot-time">18:00 - 24:00</div>
                                        <div class="slot-label"><i class="bi bi-cloud-moon"></i> Night</div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- 4. ARRIVAL TIME (COLLAPSIBLE ACCORDION) -->
                    <div class="refine-accordion" id="acc-arrtime">
                        <div class="accordion-header" onclick="toggleAccordion('acc-arrtime')">
                            <span class="acc-title">Arrival Time</span>
                            <div class="acc-actions">
                                <a href="javascript:void(0)" onclick="event.stopPropagation(); toggleSectionSelectAll('arrtime')" id="selAll-arrtime" class="acc-link">Deselect All</a>
                                <i class="bi bi-chevron-down acc-chevron"></i>
                            </div>
                        </div>
                        <div class="accordion-body">
                            <div class="time-slot-grid">
                                <label class="time-slot-card">
                                    <input type="checkbox" class="arr-time-cb" value="early_morning" checked />
                                    <div class="time-slot-content">
                                        <div class="slot-time">00:00 - 06:00</div>
                                        <div class="slot-label"><i class="bi bi-moon-stars"></i> Early Morning</div>
                                    </div>
                                </label>
                                <label class="time-slot-card">
                                    <input type="checkbox" class="arr-time-cb" value="morning" checked />
                                    <div class="time-slot-content">
                                        <div class="slot-time">06:00 - 12:00</div>
                                        <div class="slot-label"><i class="bi bi-sun"></i> Morning</div>
                                    </div>
                                </label>
                                <label class="time-slot-card">
                                    <input type="checkbox" class="arr-time-cb" value="mid_day" checked />
                                    <div class="time-slot-content">
                                        <div class="slot-time">12:00 - 18:00</div>
                                        <div class="slot-label"><i class="bi bi-brightness-high"></i> Mid Day</div>
                                    </div>
                                </label>
                                <label class="time-slot-card">
                                    <input type="checkbox" class="arr-time-cb" value="night" checked />
                                    <div class="time-slot-content">
                                        <div class="slot-time">18:00 - 24:00</div>
                                        <div class="slot-label"><i class="bi bi-cloud-moon"></i> Night</div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- 5. FROM STATIONS (COLLAPSIBLE ACCORDION) -->
                    <div class="refine-accordion" id="acc-fromstn">
                        <div class="accordion-header" onclick="toggleAccordion('acc-fromstn')">
                            <span class="acc-title">From Stations</span>
                            <div class="acc-actions">
                                <a href="javascript:void(0)" onclick="event.stopPropagation(); toggleSectionSelectAll('fromstn')" id="selAll-fromstn" class="acc-link">Deselect All</a>
                                <i class="bi bi-chevron-down acc-chevron"></i>
                            </div>
                        </div>
                        <div class="accordion-body">
                            <div id="fromStationFilterOptions" class="filter-options-grid-2col"></div>
                        </div>
                    </div>

                    <!-- 6. TO STATIONS (COLLAPSIBLE ACCORDION) -->
                    <div class="refine-accordion" id="acc-tostn">
                        <div class="accordion-header" onclick="toggleAccordion('acc-tostn')">
                            <span class="acc-title">To Stations</span>
                            <div class="acc-actions">
                                <a href="javascript:void(0)" onclick="event.stopPropagation(); toggleSectionSelectAll('tostn')" id="selAll-tostn" class="acc-link">Deselect All</a>
                                <i class="bi bi-chevron-down acc-chevron"></i>
                            </div>
                        </div>
                        <div class="accordion-body">
                            <div id="toStationFilterOptions" class="filter-options-grid-2col"></div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Right Column: Train list and headers -->
            <main class="train-results-column">
                <!-- IRCTC-STYLE RESULTS TOP BAR -->
                <div class="results-header-row">
                    <div class="results-meta-title">
                        <span id="trainResultCount" class="results-count-number">@trainscount</span> Results for
                        <strong>@cleanFrom ➔ @cleanTo</strong> | @(((DateTime)journeyDate).ToString("ddd, dd MMM yyyy")) For Quota | @(ViewBag.Quota ?? "General")
                    </div>
                    <div class="day-nav-group">
                        <button type="button" class="day-nav-btn prev-day" onclick="navigateDay(-1)">
                            <i class="bi bi-chevron-left"></i> Previous Day
                        </button>
                        <button type="button" class="day-nav-btn next-day" onclick="navigateDay(1)">
                            Next Day <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <!-- SORT BY BAR -->
                <div class="sort-bar">

                    <span class="sort-label">Sort By:</span>

                    <div class="sort-dropdown">

                        <!-- BUTTON -->
                        <button type="button"
                                id="sortBtn"
                                class="sort-btn"
                                onclick="toggleSortMenu()">
                                @sortLabel
                        </button>

                        <!-- DROPDOWN -->
                        <div id="sortMenu" class="sort-menu">

                            <div class="sort-item @(ViewBag.CurrentSort == "DUR_SHORT" ? "selected" : "")"
                                 onclick="applySort('DUR_SHORT')">
                                Duration <small>Shortest First</small>
                            </div>

                            <div class="sort-item @(ViewBag.CurrentSort == "DUR_LONG" ? "selected" : "")"
                                 onclick="applySort('DUR_LONG')">
                                Duration <small>Longest First</small>
                            </div>

                            <div class="sort-item @(ViewBag.CurrentSort == "DEP_EARLY" ? "selected" : "")"
                                 onclick="applySort('DEP_EARLY')">
                                Departure <small>Early First</small>
                            </div>

                            <div class="sort-item @(ViewBag.CurrentSort == "DEP_LATE" ? "selected" : "")"
                                 onclick="applySort('DEP_LATE')">
                                Departure <small>Late First</small>
                            </div>

                            <div class="sort-item @(ViewBag.CurrentSort == "ARR_EARLY" ? "selected" : "")"
                                 onclick="applySort('ARR_EARLY')">
                                Arrival <small>Early First</small>
                            </div>

                            <div class="sort-item @(ViewBag.CurrentSort == "ARR_LATE" ? "selected" : "")"
                                 onclick="applySort('ARR_LATE')">
                                Arrival <small>Late First</small>
                            </div>

                        </div>
                    </div>
                </div>

        <div class="table-wrapper">
            <!-- RIGHT: Train Results -->
            <div class="train-results">
                <div class="train-card-list">

                    <div id="noTrainMessage"
                         style="display:none; padding:48px 20px; font-weight:600; color:#d9534f; text-align: center; font-size:1.05rem;">
                        No trains are available for the filter(s) you have selected.
                    </div>

                    @if (!Model.Any())
                    {
                        <div id="noTrainMessageServer" class="no-trains-available">

                            @if (ViewBag.IsFilterApplied == true)
                            {
                                <text>
                                    No trains are available for the filter(s) you have selected.
                                </text>
                            }
                            else
                            {
                                <text>
                                    No Trains available for <strong>@cleanFrom -> @cleanTo</strong> on <strong>@journey</strong>
                                </text>
                            }

                        </div>
                    }

                    else{
                        @foreach (var t in Model)
                        {

@*                             @if (t.Score > 5)
                            {
                                <span class="ai-badge">⭐ Recommended</span>
                            }
 *@                            
                            DateTime JD = t.NextRunDate;

                            // 1️⃣ Full departure datetime
                            DateTime departureDateTime = JD.Add(t.Departure);

                            // ✅ Convert string duration to TimeSpan
                            var parts = t.Duration.Split(":");   //"39:40" -> ["39","40"]
                            int hours = int.Parse(parts[0]);
                            int minutes = int.Parse(parts[1]);

                            TimeSpan duration = new TimeSpan(hours, minutes, 0);

                            // 2️⃣ Arrival = departure + duration (CORRECT)
                            DateTime arrivalDateTime = departureDateTime.Add(duration);

                            // 3️⃣ Train type color logic
                        string trainClass;
                        string trainType;   // 🔥 NEW (for filtering)

                        var trainName = t.Name.ToUpper();

                        if (trainName.Contains("VANDE BHARAT SL"))
                        {
                            trainClass = "train-rajdhani";
                            trainType = "rajdhani";
                        }

                        else if (trainName.Contains("VANDE BHARAT") || trainName.Contains("VANDEBHARAT"))
                        {
                            trainClass = "train-vande-bharat";
                            trainType = "vande-bharat";
                        }
                        else if (trainName.Contains("AMRITBHARAT") || trainName.Contains("AMRIT BHARAT"))
                        {
                            trainClass = "train-amrit-bharat";
                            trainType = "amrit-bharat";
                        }
                        else if (trainName.Contains("RAJDHANI") || trainName.Contains("RAJ"))
                        {
                            trainClass = "train-rajdhani";
                            trainType = "rajdhani";
                        }
                        else if (trainName.Contains("SHATABDI"))
                        {
                            trainClass = "train-shatabdi";
                            trainType = "shatabdi";
                        }
                        else if (trainName.Contains("GARIBRATH") || trainName.Contains("GARIB RATH"))
                        {
                            trainClass = "train-garib-rath";
                            trainType = "garib-rath";
                        }
                        else if (trainName.Contains("DURONTO"))
                        {
                            trainClass = "train-duronto";
                            trainType = "duronto";
                        }
                        else if (trainName.Contains("SPL") || trainName.Contains("SPECIAL"))
                        {
                            trainClass = "train-special";
                            trainType = "special";
                        }
                        else
                        {
                            // ✅ THIS IS THE FIX
                            trainClass = "train-normal";
                            trainType = "normal";
                        }


                        double depHour = departureDateTime.TimeOfDay.TotalHours;
                        double arrHour = arrivalDateTime.TimeOfDay.TotalHours;
                        string fromStnCode = !string.IsNullOrEmpty(t.FSM) ? t.FSM : cleanFrom;
                        string toStnCode = !string.IsNullOrEmpty(t.TSM) ? t.TSM : cleanTo;

                        <div class="train-card @trainClass" 
                                data-train-type="@trainType"
                                data-dep-hour="@depHour.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                data-arr-hour="@arrHour.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                data-duration="@((int)duration.TotalMinutes)"
                                data-from-station="@fromStnCode"
                                data-to-station="@toStnCode"
                                data-classes="@string.Join(",", t.Classes.Select(c => GetClassShortCode(c.Code)))">

                            <!-- Header -->
                            <div class="train-card-header">

                                <div class="train-title-block">
                                    <strong class="train-name-text">@t.Number.ToString("D5") - @t.Name</strong>
                                    @if (t.NextRunDate.Date != journeyDate.Date)
                                    {
                                        <span class="next-run-badge">
                                            Next: @t.NextRunDate.ToString("ddd, dd MMM")
                                        </span>
                                    }
                                </div>

                                @{
                                    int shift = t.RouteDay - 1;

                                    bool[] runDays = new bool[]
                                    {
                                        t.RunSun,
                                        t.RunMon,
                                        t.RunTue,
                                        t.RunWed,
                                        t.RunThu,
                                        t.RunFri,
                                        t.RunSat
                                    };

                                    bool[] shifted = new bool[7];

                                    for(int i=0;i<7;i++)
                                    {
                                        shifted[(i + shift) % 7] = runDays[i];
                                    }
                                }

                                <div class="runs-on desktop-runs-on">
                                    Runs On:
                                    <span class="@(shifted[1] ? "day-active" : "day-off")">M</span>
                                    <span class="@(shifted[2] ? "day-active" : "day-off")">T</span>
                                    <span class="@(shifted[3] ? "day-active" : "day-off")">W</span>
                                    <span class="@(shifted[4] ? "day-active" : "day-off")">T</span>
                                    <span class="@(shifted[5] ? "day-active" : "day-off")">F</span>
                                    <span class="@(shifted[6] ? "day-active" : "day-off")">S</span>
                                    <span class="@(shifted[0] ? "day-active" : "day-off")">S</span>
                                </div>

                                <div class="train-actions">

                                    <!-- ⚠ ALERT ICON -->
                                    @if (t.HasAlerts)
                                    {
                                        <span class="alert-icon"
                                              onclick="loadTrainAlerts(@t.Id)"
                                              style="cursor:pointer; color:red; margin-left:8px;">
                                            ⚠️
                                        </span>
                                    }

                                    <!-- Train Schedule with 📍 Pin (Prominent on mobile, just like official IRCTC) -->
                                    <a href="#"
                                       class="train-link view-route"
                                       data-train-id="@t.Id"
                                       data-train-name="@t.Name"
                                       data-train-number="@t.Number"
                                       data-from="@t.FSM"
                                       data-to="@t.TSM"
                                       title="View Train Schedule">
                                        <span class="route-text">Train Schedule</span>
                                        <i class="bi bi-geo-alt-fill route-pin-icon"></i>
                                    </a>

                                </div>
                            </div>

                            <!-- ARR/DEP Body -->
                            <div class="train-card-body">

                                <!-- DEPARTURE -->
                                <div class="time-block departure">
                                    <div class="time-val">@departureDateTime.ToString("HH:mm")</div>
                                    <div class="station-val">
                                        @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(t.FSM, "16px")
                                        <span>@t.FSM</span>
                                    </div>
                                    <div class="date-val">@departureDateTime.ToString("ddd, dd MMM")</div>
                                </div>

                                <!-- DURATION & RUNS ON -->
                                <div class="duration-block">
                                    <div class="duration-pill">
                                        <span class="dur-dash"></span>
                                        <span class="dur-val">@t.Duration</span>
                                        <span class="dur-dash"></span>
                                    </div>
                                    <div class="runs-on-mini mobile-runs-on">
                                        <span class="@(shifted[1] ? "day-active" : "day-off")">M</span>
                                        <span class="@(shifted[2] ? "day-active" : "day-off")">T</span>
                                        <span class="@(shifted[3] ? "day-active" : "day-off")">W</span>
                                        <span class="@(shifted[4] ? "day-active" : "day-off")">T</span>
                                        <span class="@(shifted[5] ? "day-active" : "day-off")">F</span>
                                        <span class="@(shifted[6] ? "day-active" : "day-off")">S</span>
                                        <span class="@(shifted[0] ? "day-active" : "day-off")">S</span>
                                    </div>
                                </div>

                                <!-- ARRIVAL -->
                                <div class="time-block arrival">
                                    <div class="time-val">@arrivalDateTime.ToString("HH:mm")</div>
                                    <div class="station-val">
                                        @IRCTCClone.Helpers.CityLandmarkHelper.RenderBadge(t.TSM, "16px")
                                        <span>@t.TSM</span>
                                    </div>
                                    <div class="date-val">@arrivalDateTime.ToString("ddd, dd MMM")</div>
                                </div>

                            </div>                            

                            <!------------------- CLASSES --------------------->
                            <div class="class-compact">

                                @foreach (var c in t.Classes)
                                {
                                    var classDisplayName = GetClassDisplayName(c.Code);

                                    <div class="class-box"
                                         data-class="@c.Id"
                                         data-class-code="@GetClassShortCode(c.Code)"
                                         onclick="openAvailability('@c.Id','@t.Id','@t.FromStationId','@t.ToStationId','@ViewBag.Quota')">

                                        <div class="class-title">@classDisplayName</div>

                                        <div class="class-refresh">
                                            Refresh <i class="bi bi-arrow-repeat refresh-icon"></i>
                                        </div>

                                    </div>
                                }

                            </div>

                                <div class="availability-panel" id="panel-@t.Id">

                                    <!-- YOUR EXISTING CODE (UNCHANGED) -->

                                    <div class="train-card-classes">

                                        @if (t.IsDeparted)
                                        {
                                            <div class="departed-box departed-hidden">
                                                <strong>TRAIN DEPARTED</strong><br />
                                                <small>Please check availability for next dates</small>
                                            </div>

                                        }

                                        else
                                        {
                                            <!-- CLASS PANELS -->
                                            <div class="class-panels">

                                                @foreach (var c in t.Classes.Select((value, index) => new { value, index }))
                                                {
                                                    <!-- YOUR FULL ORIGINAL FORM -->
                                                    <form method="get"
                                                          action="/Booking/PrepareCheckout"
                                                          class="class-card @(c.index == 0 ? "active" : "") @(!t.IsBookingAllowed ? "booking-not-allowed-card" : "")"
                                                          data-class="@c.value.Id" 
                                                          data-train="@t.Id">

                                                        <!-- ALL YOUR HIDDEN INPUTS REMAIN SAME -->

                                                        <input type="hidden" name="trainId" value="@t.Id" />
                                                        <input type="hidden" name="trainName" value="@t.Name" />
                                                        <input type="hidden" name="classId" value="@c.value.Id" />
                                                        <input type="hidden" name="classCode" value="@c.value.Code" />
                                                        <input type="hidden" name="fare" value="@((int)c.value.TotalFare)" />

                                                        <input type="hidden" id="quota" name="quota" value="@ViewBag.Quota" />

                                                        <input type="hidden" name="journeyDate" value="@t.NextRunDate.ToString("yyyy-MM-dd")" />

                                                        <input type="hidden" name="Departure" value="@departureDateTime.ToString("HH:mm")" />
                                                        <input type="hidden" name="Arrival" value="@arrivalDateTime.ToString("HH:mm")" />
                                                        <input type="hidden" name="Duration" value="@t.Duration" />

                                                        <input type="hidden" name="FromStationId" value="@userfromid" />
                                                        <input type="hidden" name="ToStationId" value="@usertoid" />

                                                        <input type="hidden" name="FSM" value="@t.FSM" />
                                                        <input type="hidden" name="TSM" value="@t.TSM" />

                                                        <input type="hidden" name="FromStation" value="@fromStation" />
                                                        <input type="hidden" name="ToStation" value="@toStation" />

                                                        <input type="hidden" name="userfromid" value="@userfromid" />
                                                        <input type="hidden" name="usertoid" value="@usertoid" />

                                                        <input type="hidden" name="numPassengers" value="1" />

                                                        <!-- Seat -->
                                                        <!-- hidden inputs unchanged -->
                                                        @{
                                                            decimal reservationCharge = 0;
                                                            decimal trainCharge = 0;
                                                            decimal GST = 0;
                                                            decimal tatkalCharge = 0;
                                                            decimal finalFare = 0;

                                                            string quota = (ViewBag.Quota as string ?? "GENERAL").ToUpper();

                                                            string classCode = "";

                                                            if (c.value.Code.Contains("(") && c.value.Code.Contains(")"))
                                                            {
                                                                int start = c.value.Code.IndexOf("(") + 1;
                                                                int end = c.value.Code.IndexOf(")");
                                                                classCode = c.value.Code.Substring(start, end - start).Trim().ToUpper();
                                                            }

                                                            // Reservation logic
                                                            switch (classCode)
                                                            {
                                                                case "2S":
                                                                    reservationCharge = 15;
                                                                    break;

                                                                case "SL":
                                                                    reservationCharge = 20;
                                                                    break;

                                                                case "CC":
                                                                    reservationCharge = 40;
                                                                    break;

                                                                case "3A":
                                                                case "3E":
                                                                    reservationCharge = 40;
                                                                    break;

                                                                case "2A":
                                                                    reservationCharge = 50;
                                                                    break;

                                                                case "1A":
                                                                case "EC":
                                                                    reservationCharge = 60;
                                                                    break;
                                                            }

                                                            //Train type detection
                                                            string trainName = t.Name.ToUpper();

                                                            if (trainName.Contains("SF") || trainName.Contains("SF EX") || trainName.Contains("VANDEBHARAT"))
                                                            {
                                                                trainCharge = 30;
                                                            }
                                                            else if (trainName.Contains("EXP") || trainName.Contains("EX") || trainName.Contains("EXPRESS"))
                                                            {
                                                                trainCharge = 0;
                                                            }
                                                            else if (trainName.Contains("DURONTO"))
                                                            {
                                                                trainCharge = 45;
                                                            }
                                                            else if (trainName.Contains("SPL"))
                                                            {
                                                                trainCharge = 30;
                                                            }
                                                            else if (trainName.Contains("INTERCITY"))
                                                            {
                                                                trainCharge = 15;
                                                            }

                                                            // Tatkal logic
                                                            if (quota == "TATKAL")
                                                            {
                                                                switch (classCode)
                                                                {
                                                                    case "2S":
                                                                        tatkalCharge = Math.Min(Math.Max(c.value.BasicFare * 0.10m, 10), 15);
                                                                        break;

                                                                    case "SL":
                                                                        tatkalCharge = Math.Min(Math.Max(c.value.BasicFare * 0.30m, 100), 200);
                                                                        break;

                                                                    case "CC":
                                                                        tatkalCharge = Math.Min(Math.Max(c.value.BasicFare * 0.30m, 125), 225);
                                                                        break;

                                                                    case "3A":
                                                                    case "3E":
                                                                        tatkalCharge = Math.Min(Math.Max(c.value.BasicFare * 0.30m, 300), 400);
                                                                        break;

                                                                    case "2A":
                                                                    case "EC":
                                                                        tatkalCharge = Math.Min(Math.Max(c.value.BasicFare * 0.30m, 400), 500);
                                                                        break;
                                                                }
                                                            }

                                                            finalFare = c.value.TotalFare + tatkalCharge;

                                                            decimal baseFare = c.value.BaseFare - (reservationCharge + trainCharge + GST);
                                                        }

                                                        <div class="class-code">@c.value.Code</div>

                                                        @if (t.IsBookingAllowed)
                                                        {
                                                            <div class="class-fare">
                                                            ₹@(quota == "TATKAL" ? (int)finalFare : (int)c.value.TotalFare)

                                                                <span class="fare-info">
                                                                    <i class="bi bi-info-circle fare-toggle" title="View Fare Details"></i>

                                                                    <div class="fare-modal">
                                                                        <div class="fare-modal-body">
                                                                            <div class="fare-modal-header">
                                                                                <span>Fare Breakup</span>
                                                                                <button type="button" class="fare-modal-close" onclick="this.closest('.fare-modal').classList.remove('show'); event.stopPropagation();">&times;</button>
                                                                            </div>
                                                                            <div class="fare-row"><span>Base Fare</span><strong>₹@c.value.BasicFare</strong></div>
                                                                            <div class="fare-row"><span>Reservation Charge</span><span>₹@c.value.ReservationCharge</span></div>
                                                                            <div class="fare-row"><span>Superfast Charge</span><span>₹@c.value.SuperfastCharge</span></div>
                                                                            <div class="fare-row"><span>GST</span><span>₹@c.value.GSTAmount</span></div>

                                                                            @if (quota == "TATKAL")
                                                                            {
                                                                                <div class="fare-row" style="color:#d97706; font-weight:600;">
                                                                                    <span>Tatkal Charge</span><span>₹@tatkalCharge</span>
                                                                                </div>
                                                                            }

                                                                            <hr class="fare-divider" />

                                                                            <div class="fare-row fare-total-row">
                                                                                <strong>Total Fare</strong>
                                                                                <strong class="fare-total-val">₹@(quota == "TATKAL" ? finalFare : c.value.TotalFare)</strong>
                                                                            </div>
                                                                        </div>
                                                                    </div>                                                        
                                                                </span>
                                                            </div>
                                                        }

                                                        @{
                                                            bool isTatkal = quota == "TATKAL";
                                                            bool isTatkalOpen = TatkalHelper.IsTatkalOpen(classCode);

                                                            int remaining = 0;
                                                            int rac = 0;
                                                            int wl = 0;

                                                            remaining = c.value.SeatsAvailable;
                                                            rac = c.value.RACSeats;
                                                            wl = c.value.WLSeats;

                                                            string seatStatus;
                                                            string seatColor;

                                                            if (t.IsDeparted)
                                                            {
                                                                seatStatus = "TRAIN DEPARTED";
                                                                seatColor = "#dc2626";
                                                            }
                                                            else if (t.IsChartPrepared)
                                                            {
                                                                seatStatus = "CHART PREPARED";
                                                                seatColor = "#ea580c";
                                                            }
                                                            else if (t.IsFirstChartPrepared)
                                                            {
                                                                // First Chart prepared (8 hrs to 30 mins before departure)
                                                                // Current booking opens for vacant seats until final charting window
                                                                if (remaining > 0)
                                                                {
                                                                    seatStatus = "CURR_AVBL-" + remaining.ToString("D4");
                                                                    seatColor = "green";
                                                                }
                                                                else
                                                                {
                                                                    seatStatus = "CHART PREPARED";
                                                                    seatColor = "#ea580c";
                                                                }
                                                            }
                                                            else if (remaining > 0)
                                                            {
                                                                seatStatus = "AVAILABLE - " + remaining;
                                                                seatColor = "green";
                                                            }
                                                            else if (rac > 0)
                                                            {
                                                                seatStatus = "RAC - " + rac;
                                                                seatColor = "orange";
                                                            }
                                                            else if (wl > 0)
                                                            {
                                                                seatStatus = "WL - " + wl;
                                                                seatColor = "red";
                                                            }
                                                            else
                                                            {
                                                                seatStatus = "NOT AVAILABLE";
                                                                seatColor = "gray";
                                                            }

                                                            bool isFirstAc = classCode == "1A" || classCode.Contains("1A") || classCode.Contains("EA") || classCode.Contains("FIRST AC");
                                                            if (isTatkal && isFirstAc)
                                                            {
                                                                seatStatus = isTatkalOpen ? "NOT AVAILABLE" : "NOT AVAILABLE#";
                                                                seatColor = "#64748b";
                                                            }
                                                            else if (isTatkal && !isTatkalOpen && !t.IsDeparted && !t.IsChartPrepared && !t.IsFirstChartPrepared)
                                                            {
                                                                seatStatus += "#";
                                                            }

                                                            bool canBookThisClass = !t.IsDeparted && !t.IsChartPrepared && (!t.IsFirstChartPrepared || remaining > 0) && (seatStatus != "NOT AVAILABLE" && !seatStatus.StartsWith("CHART PREPARED"));
                                                        }

                                                        @if (!t.IsBookingAllowed)
                                                        {
                                                            <div class="class-status booking-not-allowed-box">
                                                                <span class="booking-not-allowed-close" onclick="closeAvailabilityPanel('panel-@t.Id', '@t.Id')">&times;</span>
                                                                <div class="booking-not-allowed-msg">
                                                                    BOOKINGs are NOT ALLOWED at this TIME
                                                                </div>
                                                                <div class="booking-not-allowed-sub">
                                                                    @if (t.ServiceStartDate.HasValue)
                                                                    {
                                                                        <span>Booking opens on @t.ServiceStartDate.Value.AddDays(-3).ToString("dd-MMM-yyyy") (3 days before service start date)</span>
                                                                    }
                                                                    else
                                                                    {
