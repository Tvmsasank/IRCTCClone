        function updateSelectAllLabels() {
            const sections = ['class', 'type', 'deptime', 'arrtime', 'fromstn', 'tostn'];
            const selectorMap = {
                'class': '.class-filter-cb',
                'type': '.type-filter-cb',
                'deptime': '.dep-time-cb',
                'arrtime': '.arr-time-cb',
                'fromstn': '.fromstn-filter-cb',
