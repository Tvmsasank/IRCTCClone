        const sortLabels = {
            'DUR_SHORT': 'Duration – Shortest First',
            'DUR_LONG':  'Duration – Longest First',
            'DEP_EARLY': 'Departure – Early First',
            'DEP_LATE':  'Departure – Late First',
            'ARR_EARLY': 'Arrival – Early First',
            'ARR_LATE':  'Arrival – Late First'
        };

        function applySort(sortType) {
            const list = document.querySelector('.train-card-list');
            if (!list) return;

            const cards = Array.from(list.querySelectorAll('.train-card'));
            if (cards.length === 0) return;

            cards.sort((a, b) => {
                const depA = parseFloat(a.dataset.depHour) || 0;
                const depB = parseFloat(b.dataset.depHour) || 0;
                const arrA = parseFloat(a.dataset.arrHour) || 0;
                const arrB = parseFloat(b.dataset.arrHour) || 0;
                const durA = parseInt(a.dataset.duration) || 0;
                const durB = parseInt(b.dataset.duration) || 0;

                switch (sortType) {
                    case 'DEP_EARLY': return depA - depB;
                    case 'DEP_LATE':  return depB - depA;
                    case 'ARR_EARLY': return arrA - arrB;
                    case 'ARR_LATE':  return arrB - arrA;
                    case 'DUR_SHORT': return durA - durB;
                    case 'DUR_LONG':  return durB - durA;
                    default: return 0;
                }
            });

            cards.forEach(card => list.appendChild(card));

            // Update desktop sort button label
            const sortBtn = document.getElementById("sortBtn");
            if (sortBtn && sortLabels[sortType]) {
                sortBtn.innerText = sortLabels[sortType];
            }

            // Update active state in desktop sort menu
            document.querySelectorAll("#sortMenu .sort-item").forEach(item => {
                const fn = item.getAttribute("onclick") || "";
                item.classList.toggle("selected", fn.includes("'" + sortType + "'"));
            });

            // Update active state in mobile sort menu
            document.querySelectorAll("#mobileSortMenu .mobile-sort-item").forEach(item => {
                const fn = item.getAttribute("onclick") || "";
                item.classList.toggle("active", fn.includes("'" + sortType + "'"));
            });

            // Close desktop sort menu
            const desktopMenu = document.getElementById("sortMenu");
            if (desktopMenu) desktopMenu.style.display = "none";

            // Close mobile sort menu
            const mobileMenu = document.getElementById("mobileSortMenu");
            if (mobileMenu) mobileMenu.style.display = "none";

            // Save sort preference to session in background
            try {
                fetch('/Train/SetSort?value=' + sortType);
            } catch (e) {}
        }

        function toggleSortMenu() {
            const menu = document.getElementById("sortMenu");
            menu.style.display = menu.style.display === "block" ? "none" : "block";
        }

        // Close dropdown when clicking outside
        document.addEventListener("click", function (e) {
            const btn = document.getElementById("sortBtn");
            const menu = document.getElementById("sortMenu");

            if (!btn.contains(e.target) && !menu.contains(e.target)) {
                menu.style.display = "none";
            }
        });

        function toggleFareModal(el){
            // close other modals first
            document.querySelectorAll(".fare-modal")
                .forEach(m => m.classList.remove("show"));

            const modal = el.querySelector(".fare-modal");
            if (!modal) return;

            modal.classList.add("show");

            // click outside closes it
            setTimeout(() => {
                document.addEventListener("click", function handler(e){
                    if(!el.contains(e.target)){
                        modal.classList.remove("show");
                        document.removeEventListener("click", handler);
                    }
                });
            }, 0);
        }

        function handleLiveStatus(event, trainNo) {

            event.preventDefault();
            event.stopPropagation();

            navigator.clipboard.writeText(trainNo)
                .then(() => {
                    alert("Train number " + trainNo + " copied!");

                    // Open after successful copy
                    window.open("https://enquiry.indianrail.gov.in/mntes/", "_blank");
                })
                .catch(() => {
                    alert("Copy failed. Please copy manually: " + trainNo);

                    // Still open site
                    window.open("https://enquiry.indianrail.gov.in/mntes/", "_blank");
                });
        }

        document.addEventListener("click", function (e) {
            if (e.target && (e.target.id === "closeRouteMismatch" || e.target.closest("#closeRouteMismatch") || e.target.id === "closeRouteMismatchHeader" || e.target.closest("#closeRouteMismatchHeader"))) {
                e.preventDefault();

                fetch('/Train/ClearRouteMismatch', {
                    method: 'POST'
                })
                .then(res => {
                    if (res.ok) {
                        const overlay = document.getElementById("routeMismatchOverlay");
                        if (overlay) overlay.style.display = "none";
                    }
                })
                .catch(err => console.error(err));
            }
        });

        function openSmartSearch() {
            document.getElementById("smartOverlay").style.display = "flex";

            // hide main results
            document.querySelector(".train-results-container")?.classList.add("blur-bg");
        }

            function closeSmartSearch() {
                document.getElementById("smartOverlay").style.display = "none";

                document.querySelector(".train-results-container")?.classList.remove("blur-bg");
            }

        const bubble = document.getElementById("smartBubble");

        let isDragging = false;
        let startX, startY;
        let moved = false;

        const DRAG_THRESHOLD = 5; // 🔥 adjust sensitivity

        bubble.addEventListener("mousedown", (e) => {
            isDragging = true;
            moved = false;

            startX = e.clientX;
            startY = e.clientY;

            bubble.style.transition = "none";
        });

        document.addEventListener("mousemove", (e) => {
            if (!isDragging) return;

            let dx = e.clientX - startX;
            let dy = e.clientY - startY;

            // 🔥 detect real drag
            if (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD) {
                moved = true;
            }

            let x = bubble.offsetLeft + dx;
            let y = bubble.offsetTop + dy;

            x = Math.max(0, Math.min(window.innerWidth - bubble.offsetWidth, x));
            y = Math.max(0, Math.min(window.innerHeight - bubble.offsetHeight, y));

            bubble.style.left = x + "px";
            bubble.style.top = y + "px";
            bubble.style.right = "auto";
            bubble.style.bottom = "auto";
            bubble.style.position = "fixed";

            // reset start for smooth dragging
            startX = e.clientX;
            startY = e.clientY;
        });

        document.addEventListener("mouseup", () => {
            isDragging = false;

            // 🔥 delay reset (IMPORTANT)
            setTimeout(() => {
                moved = false;
            }, 50);

            bubble.style.transition = "0.3s";
        });

        // 🔥 CLICK HANDLER
        bubble.onclick = function (e) {
            if (moved) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }

            openSmartSearch();
        };

        function openMap(url) {
            if (!url) {
                showToast("Route not available");
                return;
            }

            window.open(url, "_blank");
        }

        function loadTrainAlerts(trainId) {

            fetch('/Train/GetTrainAlerts?trainId=' + trainId)
                .then(res => res.json())
                .then(data => {

                    let html = "";

                    if (!data || data.length === 0) {
                        html = `<tr><td colspan="2" style="text-align:center; padding:18px; color:#64748b;">No updates available</td></tr>`;
                    } else {
                        data.forEach(a => {
                            let badgeHtml = "";
                            if (a.type === "Cancelled") {
                                badgeHtml = `<span style="background:#fef2f2; color:#dc2626; border:1px solid #fca5a5; padding:3px 8px; border-radius:4px; font-weight:700; font-size:11.5px; display:inline-block;">Cancelled</span>`;
                            } else if (a.type === "Skipped") {
                                badgeHtml = `<span style="background:#fff7ed; color:#ea580c; border:1px solid #fdba74; padding:3px 8px; border-radius:4px; font-weight:700; font-size:11.5px; display:inline-block;">Skipped</span>`;
                            } else if (a.type === "Diverted") {
                                badgeHtml = `<span style="background:#eff6ff; color:#2563eb; border:1px solid #93c5fd; padding:3px 8px; border-radius:4px; font-weight:700; font-size:11.5px; display:inline-block;">Diverted</span>`;
                            } else if (a.type === "Temporary Stop") {
                                badgeHtml = `<span style="background:#f0fdf4; color:#16a34a; border:1px solid #86efac; padding:3px 8px; border-radius:4px; font-weight:700; font-size:11.5px; display:inline-block;">Temporary Stop</span>`;
                            } else {
                                badgeHtml = `<span style="font-weight:600;">${a.type || 'Update'}</span>`;
                            }

                            let detailHtml = a.message || "";
                            if (a.type === "Skipped" && a.station && a.dates) {
                                detailHtml = `Skipped station: <strong style="color:#0f172a;">${a.station}</strong> (${a.dates})`;
                            }

                            html += `
                                <tr>
                                    <td style="vertical-align:middle; width:120px;">
                                        ${badgeHtml}
                                    </td>
                                    <td style="vertical-align:middle; color:#1e293b; font-size:13.5px;">${detailHtml}</td>
                                </tr>
                            `;
                        });
                    }

                    document.getElementById("alertBody").innerHTML = html;

                    // 🔥 OPEN MODAL
                    document.getElementById("alertModal").style.display = "flex";
                })
                .catch(err => {
                    console.error("Error:", err);
                });
        }

        function closeAlertModal() {
            document.getElementById("alertModal").style.display = "none";
        }

</script>

