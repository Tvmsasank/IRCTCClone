            $("#route-sidebar").removeClass("open");
            $("#sidebar-overlay").removeClass("show");

            // $("#route-sidebar").css("right", "-700px");
            // $("#sidebar-overlay").fadeOut(200);
        });

        function changeDate(offset) {
            let dateInput = document.getElementById("journeyDatePicker");
            let date = new Date(dateInput.value);
            date.setDate(date.getDate() + offset);
            dateInput.valueAsDate = date;
            submitDateChange();
        }

        function submitDateChange() {
            let date = document.getElementById("journeyDatePicker").value;

            let fromId = '@TempData.Peek("fromStationId")';
            let toId   = '@TempData.Peek("toStationId")';
            let fromNm = '@TempData.Peek("FromStation")';
            let toNm   = '@TempData.Peek("ToStation")';

            window.location.href = `/Train/ChangeJourneyDate?date=${date}`;
        }

        function cleanStationName(station) {
            if (!station) return '';

            // Remove everything from " (" onwards
            return station.split(' (')[0].trim();
        }


        function filterTrains() {
            // Get all checked classes
            const checkedClasses = [];
            document.querySelectorAll('.class-filter-cb:checked').forEach(cb => {
                checkedClasses.push(cb.value);
            });

            // Get all checked types
            const checkedTypes = [];
            document.querySelectorAll('.type-filter-cb:checked').forEach(cb => {
                checkedTypes.push(cb.value);
            });

            const trains = document.querySelectorAll('.train-card');
            let visibleCount = 0;

            trains.forEach(train => {
                const trainType = train.dataset.trainType;
                
                // Parse classes from train card (split by comma, clean whitespace)
                let trainClassesStr = train.dataset.classes || '';
                trainClassesStr = trainClassesStr.replace(/\s+/g, ''); // Remove spaces
                const trainClasses = trainClassesStr.split(',').filter(c => c.length > 0);

                // A train is shown if:
                // 1. Its trainType is checked AND
                // 2. At least one of its classes is checked
                const typeMatches = checkedTypes.includes(trainType);
                const classMatches = trainClasses.some(c => checkedClasses.includes(c));

                if (typeMatches && classMatches) {
                    train.style.display = '';
                    visibleCount++;
                } else {
                    train.style.display = 'none';
                }
            });

            // Show/Hide "no trains available" messages
            const msgBox = document.getElementById('noTrainMessage');
            const serverMsg = document.getElementById('noTrainMessageServer');

            if (visibleCount === 0) {
                if (serverMsg) {
                    serverMsg.style.display = 'none';
                }
                
                const fromStationRaw = '@TempData.Peek("FromStation")';
                const toStationRaw   = '@TempData.Peek("ToStation")';
                const journeyDate    = '@journey';

                const route =
                    cleanStationName(fromStationRaw) +
                    ' → ' +
                    cleanStationName(toStationRaw);

                msgBox.innerHTML = `No trains available matching your selected filters for <strong>${route}</strong> on <strong>${journeyDate}</strong>`;
                msgBox.style.display = 'block';
            } else {
                msgBox.style.display = 'none';
                if (serverMsg) {
                    serverMsg.style.display = 'none';
                }
            }
        }

        // Setup event listeners for checkboxes
        document.querySelectorAll('.class-filter-cb, .type-filter-cb').forEach(cb => {
            cb.addEventListener('change', filterTrains);
        });

        function resetAllFilters() {
            document.querySelectorAll('.class-filter-cb, .type-filter-cb').forEach(cb => {
                cb.checked = true;
            });
            filterTrains();
        }

        // Run once on load to ensure filters match checkbox state
        document.addEventListener('DOMContentLoaded', filterTrains);

