                    link.innerText = allChecked ? 'Deselect All' : 'Select All';
                }
            });
        }

        function getTimeSlot(hour) {
            if (hour >= 0 && hour < 6) return 'early_morning';
            if (hour >= 6 && hour < 12) return 'morning';
            if (hour >= 12 && hour < 18) return 'mid_day';
            return 'night';
        }

        function populateStationFilters() {
            const fromContainer = document.getElementById('fromStationFilterOptions');
            const toContainer = document.getElementById('toStationFilterOptions');
            if (!fromContainer || !toContainer) return;

            const fromStations = new Set();
            const toStations = new Set();

            document.querySelectorAll('.train-card').forEach(card => {
                const fromStn = card.dataset.fromStation;
                const toStn = card.dataset.toStation;
                if (fromStn) fromStations.add(fromStn);
                if (toStn) toStations.add(toStn);
            });

            let fromHtml = '';
            fromStations.forEach(stn => {
                fromHtml += `
                    <label class="filter-checkbox-label">
                        <input type="checkbox" class="fromstn-filter-cb" value="${stn}" checked />
                        <span>${stn}</span>
                    </label>`;
            });
            fromContainer.innerHTML = fromHtml || '<div style="font-size:11px; color:#64748b; padding:4px;">Default Origin</div>';

            let toHtml = '';
            toStations.forEach(stn => {
                toHtml += `
                    <label class="filter-checkbox-label">
                        <input type="checkbox" class="tostn-filter-cb" value="${stn}" checked />
                        <span>${stn}</span>
                    </label>`;
            });
            toContainer.innerHTML = toHtml || '<div style="font-size:11px; color:#64748b; padding:4px;">Default Destination</div>';

            // Wire station checkbox change events
            fromContainer.querySelectorAll('.fromstn-filter-cb').forEach(cb => cb.addEventListener('change', filterTrains));
            toContainer.querySelectorAll('.tostn-filter-cb').forEach(cb => cb.addEventListener('change', filterTrains));
        }

        function filterTrains() {
            // Get all checked values
            const checkedClasses = Array.from(document.querySelectorAll('.class-filter-cb:checked')).map(cb => cb.value);
            const checkedTypes = Array.from(document.querySelectorAll('.type-filter-cb:checked')).map(cb => cb.value);
            const checkedDepSlots = Array.from(document.querySelectorAll('.dep-time-cb:checked')).map(cb => cb.value);
            const checkedArrSlots = Array.from(document.querySelectorAll('.arr-time-cb:checked')).map(cb => cb.value);
            const checkedFromStns = Array.from(document.querySelectorAll('.fromstn-filter-cb:checked')).map(cb => cb.value);
            const checkedToStns = Array.from(document.querySelectorAll('.tostn-filter-cb:checked')).map(cb => cb.value);

            // Total available checkboxes per category in DOM
            const totalClassCbs = document.querySelectorAll('.class-filter-cb').length;
            const totalTypeCbs = document.querySelectorAll('.type-filter-cb').length;
            const totalDepCbs = document.querySelectorAll('.dep-time-cb').length;
            const totalArrCbs = document.querySelectorAll('.arr-time-cb').length;
            const totalFromCbs = document.querySelectorAll('.fromstn-filter-cb').length;
            const totalToCbs = document.querySelectorAll('.tostn-filter-cb').length;

            const trains = document.querySelectorAll('.train-card-list > .train-card');
            let visibleCount = 0;

            trains.forEach(train => {
                const trainType = train.dataset.trainType;
                const depHour = parseFloat(train.dataset.depHour || 0);
                const arrHour = parseFloat(train.dataset.arrHour || 0);
                const fromStn = train.dataset.fromStation;
                const toStn = train.dataset.toStation;

                // Parse classes from train card (split by comma, clean whitespace)
                let trainClassesStr = train.dataset.classes || '';
                trainClassesStr = trainClassesStr.replace(/\s+/g, '');
                const trainClasses = trainClassesStr.split(',').filter(c => c.length > 0);

                // 1. Class Match: In IRCTC standard, a train matches IF at least ONE of its classes is in checkedClasses.
                // If user unchecks ALL classes, checkedClasses.length === 0, so NO train matches (0 results).
                const classMatches = totalClassCbs === 0 ? true : (checkedClasses.length > 0 && trainClasses.some(c => checkedClasses.includes(c)));

                // 2. Type Match
                const typeMatches = totalTypeCbs === 0 ? true : (checkedTypes.length > 0 && checkedTypes.includes(trainType));

                // 3. Departure Time Match
                const depSlot = getTimeSlot(depHour);
                const depMatches = totalDepCbs === 0 ? true : (checkedDepSlots.length > 0 && checkedDepSlots.includes(depSlot));

                // 4. Arrival Time Match
                const arrSlot = getTimeSlot(arrHour);
                const arrMatches = totalArrCbs === 0 ? true : (checkedArrSlots.length > 0 && checkedArrSlots.includes(arrSlot));

                // 5. From Station Match
                const fromMatches = totalFromCbs === 0 ? true : (checkedFromStns.length > 0 && checkedFromStns.includes(fromStn));

                // 6. To Station Match
                const toMatches = totalToCbs === 0 ? true : (checkedToStns.length > 0 && checkedToStns.includes(toStn));

                if (classMatches && typeMatches && depMatches && arrMatches && fromMatches && toMatches) {
                    train.style.display = '';
                    visibleCount++;
                    // In official IRCTC standard, matching trains keep all their class chips visible
                    const classBoxes = train.querySelectorAll('.class-box');
                    classBoxes.forEach(box => {
                        box.style.display = '';
                    });
                } else {
                    train.style.display = 'none';
                }
            });

            // Update live result count in header
            const resultCountEl = document.getElementById('trainResultCount');
            if (resultCountEl) {
                resultCountEl.textContent = visibleCount;
            }

            // Show/Hide "no trains available" messages matching official IRCTC exactly
            const msgBox = document.getElementById('noTrainMessage');
            const serverMsg = document.getElementById('noTrainMessageServer');

            if (visibleCount === 0) {
                if (serverMsg) {
                    serverMsg.style.display = 'none';
                }
                if (msgBox) {
                    msgBox.innerHTML = '<span style="color:#d9534f; font-weight:600; font-size:1.05rem;">No trains are available for the filter(s) you have selected.</span>';
                    msgBox.style.display = 'block';
                }
            } else {
                if (msgBox) {
                    msgBox.style.display = 'none';
                }
                if (serverMsg) {
                    serverMsg.style.display = 'none';
                }
            }

            updateSelectAllLabels();
        }

        // Setup event listeners for existing checkboxes
        document.querySelectorAll('.class-filter-cb, .type-filter-cb, .dep-time-cb, .arr-time-cb').forEach(cb => {
            cb.addEventListener('change', filterTrains);
        });

        // Navigate to Previous / Next Day
        function navigateDay(offsetDays) {
            if (window.fpResults && window.fpResults.selectedDates && window.fpResults.selectedDates.length > 0) {
                const current = window.fpResults.selectedDates[0];
                const targetDate = new Date(current);
                targetDate.setDate(targetDate.getDate() + offsetDays);

                const yyyy = targetDate.getFullYear();
                const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
                const dd = String(targetDate.getDate()).padStart(2, '0');
                const newDateStr = `${yyyy}-${mm}-${dd}`;

                if ("@minDate" && newDateStr < "@minDate") {
                    alert('Date cannot be before ' + "@minDate");
                    return;
                }
                if ("@maxDate" && newDateStr > "@maxDate") {
                    alert('Date cannot be after ' + "@maxDate");
                    return;
                }

                window.fpResults.setDate(targetDate, false);
                const dateInput = document.getElementById('journeyDatePicker');
                if (dateInput) dateInput.value = newDateStr;
                submitDateChange();
                return;
            }

            const dateInput = document.getElementById('journeyDatePicker');
            if (!dateInput || !dateInput.value) return;

            const parts = dateInput.value.split('-');
            if (parts.length !== 3) return;
            const y = parseInt(parts[0], 10);
            const m = parseInt(parts[1], 10) - 1;
            const d = parseInt(parts[2], 10);

            const targetDate = new Date(y, m, d + offsetDays);

            const yyyy = targetDate.getFullYear();
            const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
            const dd = String(targetDate.getDate()).padStart(2, '0');
            const newDateStr = `${yyyy}-${mm}-${dd}`;

            if (newDateStr < "@minDate") {
                alert('Date cannot be before ' + "@minDate");
                return;
            }
            if (newDateStr > "@maxDate") {
                alert('Date cannot be after ' + "@maxDate");
                return;
            }

            dateInput.value = newDateStr;
            submitDateChange();
        }

