@{
    ViewData["Title"] = "Change Password";
}

<div class="cp-container">
    <div class="cp-card wide">

        <h2 class="cp-title">Change Password</h2>

        <form asp-controller="Account" asp-action="ChangePassword">

            <!-- NEW PASSWORD -->
            <div class="cp-group">
                <label>New Password</label>

                <div class="input-wrapper">
                    <input type="password" id="newPassword" placeholder="New Password" />
                    <i class="fa fa-eye toggle-eye" data-target="newPassword"></i>
                </div>

                <!-- RULES -->
                <ul class="password-rules" id="passwordRules">
                    <li id="rule-length">Minimum 8–15 characters</li>
                    <li id="rule-case">At least 1 uppercase & 1 lowercase</li>
                    <li id="rule-special">At least 1 number & 1 special char</li>
                    <li id="rule-seq">No sequences like 123 or aaa</li>
                </ul>
            </div>

            <!-- CONFIRM -->
            <div class="cp-group">
                <label>Confirm Password</label>

                <div class="input-wrapper">
                    <input type="password" id="confirmPassword" placeholder="Confirm Password" />
                    <i class="fa fa-eye toggle-eye" data-target="confirmPassword"></i>
                </div>
            </div>

            <!-- OTP -->
            <div id="otpSection" class="otp-section" style="display:none;">

                <label class="otp-label">Enter OTP</label>

                <div class="otp-boxes">
                    <input maxlength="1" class="otp-input" />
                    <input maxlength="1" class="otp-input" />
                    <input maxlength="1" class="otp-input" />
                    <input maxlength="1" class="otp-input" />
                    <input maxlength="1" class="otp-input" />
                    <input maxlength="1" class="otp-input" />
                </div>

                <div class="otp-row">
                    <span id="otpTimer">OTP expires in 60s</span>
                    <button type="button" id="resendOtpBtn" style="display:none;">Resend</button>
                </div>

            </div>
            <button type="button" id="changeBtn" class="cp-btn">
                Change Password
            </button>

        </form>

    </div>
</div>

@section Scripts {
<script>

    let otpStep = false;
    let timer;
    let timeLeft = 60;

    // 🔐 PASSWORD VALIDATION
    $("#newPassword").on("input", function () {

        let val = $(this).val();

        // 🚨 RESET ALL when empty
        if (val.length === 0) {
            $(".password-rules li").removeClass("valid");
            return;
        }

        // Length
        toggleRule("#rule-length", val.length >= 8 && val.length <= 15);

        // Upper + lower
        toggleRule("#rule-case", /[A-Z]/.test(val) && /[a-z]/.test(val));

        // number + special
        toggleRule("#rule-special", /\d/.test(val) && new RegExp("[@@\$!%*?&]").test(val));

        // no sequence
        toggleRule("#rule-seq", !/(123|abc|aaa|000)/i.test(val));
    });

    function toggleRule(id, isValid) {
        if (isValid) {
            $(id).addClass("valid");
        } else {
            $(id).removeClass("valid");
        }
    }

    // 👁️ TOGGLE
    $(".toggle-eye").click(function () {
        let inputId = $(this).data("target");
        let input = $("#" + inputId);

        if (input.attr("type") === "password") {
            input.attr("type", "text");
            $(this).removeClass("fa-eye").addClass("fa-eye-slash");
        } else {
            input.attr("type", "password");
            $(this).removeClass("fa-eye-slash").addClass("fa-eye");
        }
    });

    // ⏱ TIMER
    function startTimer() {
        timeLeft = 60;
        $("#resendOtpBtn").hide();

        timer = setInterval(() => {
            timeLeft--;
            $("#otpTimer").text("OTP expires in " + timeLeft + "s");

            if (timeLeft <= 0) {
                clearInterval(timer);
                $("#otpTimer").text("OTP expired");
                $("#resendOtpBtn").show();
            }
        }, 1000);
    }

    // 🔘 MAIN BUTTON
    $("#changeBtn").click(function () {

        let pass = $("#newPassword").val();
        let confirm = $("#confirmPassword").val();

        let otp = "";
        $(".otp-input").each(function () {
            otp += $(this).val();
        });

        // ✅ NEW VALIDATION
        if (otpStep && otp.length !== 6) {
            showToast("Please enter complete OTP");
            return;
        }

        if (!pass || !confirm) {
            showToast("Enter all fields");
            return;
        }

        if (pass !== confirm) {
            showToast("Passwords do not match");
            return;
        }

        showLoader();

        // STEP 1 → SEND OTP
        if (!otpStep) {

            $.post("/Account/ChangePassword", {
                newPassword: pass,
                enteredOTP: ""
            }, function (res) {

                if (res.success && res.step === "OTP_SENT") {

                    otpStep = true;

                    $("#otpSection").show();
                        $(".otp-input").first().focus();

                    $("#changeBtn").text("Verify & Update");

                    startTimer();

                    showToast("OTP sent to your email", "success");
                }

            }).always(hideLoader);
        }

        // STEP 2 → VERIFY OTP
        else {

            $.post("/Account/ChangePassword", {
                newPassword: pass,
                enteredOTP: otp
            }, function (res) {

                console.log("RESPONSE:", res); // 🔥 debug

                // FORCE CHECK
                if (res && res.success === true) {

                    showToast("Password updated successfully", "success");

                    setTimeout(() => {
                        window.location.href = "/Account/Logout";
                    }, 2000);

                } else {
                    showToast(res?.message || "Something went wrong");
                }

            }).fail(function () {
                showToast("Server error");
            }).always(hideLoader);
        }
    });

    // 🔁 RESEND
    $("#resendOtpBtn").click(function () {
        otpStep = false;
        $("#changeBtn").click();
    });

        $(document).on("input", ".otp-input", function () {
            if (this.value.length === 1) {
                $(this).next(".otp-input").focus();
            }
        });

        $(document).on("keydown", ".otp-input", function (e) {
            if (e.key === "Backspace" && this.value === "") {
                $(this).prev(".otp-input").focus();
            }
        });

</script>
}