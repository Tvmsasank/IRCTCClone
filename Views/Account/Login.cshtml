@model IRCTCClone.Models.ViewModels
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="login-page">

    <!-- Animated background -->
    <div class="login-bg-overlay"></div>
    <div class="login-bg-glow g1"></div>
    <div class="login-bg-glow g2"></div>
    <div class="login-bg-glow g3"></div>

    <!-- Login Card -->
    <div class="login-card">

        <!-- Header -->
        <div class="login-card-header">
            <div class="login-logo-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M6 20v-2a4 4 0 014-4h4a4 4 0 014 4v2"/>
                </svg>
            </div>
            <h2 class="login-card-title">Welcome Back</h2>
            <p class="login-card-subtitle">Sign in to your IRCTC account</p>
        </div>

        <form method="post" action="/Account/Login" id="loginForm" novalidate>
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <!-- EMAIL -->
            <div class="form-field">
                <label class="form-label">User Name</label>
                <div class="form-input-wrap">
                    <svg class="form-input-icon" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                        <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
                    </svg>
                    <input type="Username"
                           name="Username"
                           value="@Model.Username"
                           required
                           placeholder="Enter your Username"
                           class="form-input" />
                </div>
            </div>

            <!-- PASSWORD -->
            <div class="form-field">
                <label class="form-label">Password</label>
                <div class="form-input-wrap">
                    <svg class="form-input-icon" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                    </svg>
                    <input type="password"
                           name="Password"
                           id="passwordInput"
                           required
                           placeholder="Enter your password"
                           class="form-input" />
                    <button type="button" class="eye-toggle" id="togglePassword" onclick="togglePasswordVisibility()">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
            </div>

            <!-- CAPTCHA -->
            <div class="form-field">
                <label class="form-label">Verification Code</label>
                <div class="captcha-row">
                    <div class="captcha-img-wrap">
                        <img id="captchaImg" src="/captcha" alt="captcha" />
                    </div>
                    <button type="button" class="captcha-refresh-btn" onclick="refreshCaptcha()" title="Refresh captcha">
                        <svg viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"/>
                        </svg>
                    </button>
                    <input type="text"
                           name="CaptchaInput"
                           placeholder="Enter Captcha"
                           required
                           class="form-input captcha-input-field" />
                </div>
            </div>

            <!-- Forgot Password -->
            <div class="forgot-row">
                <a href="/Account/ForgotPassword" class="forgot-link-text">Forgot Password?</a>
            </div>

            <!-- Submit -->
            <button type="submit" class="login-submit-btn">
                <span id="btnText">Sign In</span>
                <svg viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
            </button>

        </form>

        <!-- Footer -->
        <div class="login-card-footer">
            <span>Don't have an account?</span>
            <a href="/Account/Register" class="register-link">Register</a>
        </div>

        <!-- Security note -->
        <div class="security-note">
            <svg viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Secured by 256-bit SSL encryption</span>
        </div>

    </div>

</section>
 
@section Scripts {
    <script>
        function togglePasswordVisibility() {
            const passwordField = document.getElementById('passwordInput');
            const icon = document.querySelector('#togglePassword i');
            if (!passwordField || !icon) return;
            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                passwordField.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
        function refreshCaptcha() {
            const img = document.getElementById("captchaImg");
            img.style.opacity = "0.5";
            img.src = "/captcha?ts=" + new Date().getTime();
            img.onload = () => img.style.opacity = "1";
        }
        //refreshCaptcha();

        @if (TempData["Error"] != null)
        {
                <text>
                    showToast("@TempData["Error"]");
                </text>
        }
        </script>
}
