@{
    ViewData["Title"] = "Forgot Account Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ==========================================
     RECOVERY PAGE: SAPPHIRE STEPPER CARD
     ========================================== -->
<section class="recovery-page">
    <!-- Ambient floating light glow orbs -->
    <div class="recovery-bg-glow glow-1"></div>
    <div class="recovery-bg-glow glow-2"></div>

    <div class="recovery-card-wrapper">
        <div class="recovery-card">
            
            <!-- Brand Badge & Header -->
            <div class="recovery-card-header">
                <div class="recovery-brand-badge">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h1 class="recovery-title">FORGOT ACCOUNT DETAILS</h1>
                <p class="recovery-subtitle" id="recoverySubtitle">Verify your registered credentials to reset your password</p>
            </div>

            <!-- Animated 2-Step Progress Indicator -->
            <div class="recovery-stepper">
                <div class="stepper-item active" id="stepperNode1">
                    <div class="stepper-circle" id="stepperCircle1">
                        <span class="step-num">1</span>
                        <i class="fa-solid fa-check step-check" style="display:none;"></i>
                    </div>
                    <span class="stepper-label">Verify Identity</span>
                </div>

                <div class="stepper-line" id="stepperLine">
                    <div class="stepper-line-progress" id="stepperProgress"></div>
                </div>

                <div class="stepper-item" id="stepperNode2">
                    <div class="stepper-circle" id="stepperCircle2">
                        <span class="step-num">2</span>
                    </div>
                    <span class="stepper-label">Reset Password</span>
                </div>
            </div>

            <!-- ==============================================
                 STEP 1: IDENTITY VERIFICATION & CAPTCHA
                 ============================================== -->
            <div id="step1Container" class="step-container active-step">
                <form id="step1Form" autocomplete="off" onsubmit="return handleStep1Submit(event)">
                    
                    <!-- Username Field -->
                    <div class="recovery-field">
                        <label class="recovery-label" for="irctcUsername">
                            IRCTC User Name <span class="req-star">*</span>
                        </label>
                        <div class="recovery-input-wrap">
                            <i class="fa-solid fa-user input-icon"></i>
                            <input type="text"
                                   id="irctcUsername"
                                   name="username"
                                   class="recovery-input"
                                   placeholder="Enter your IRCTC User Name"
                                   required
                                   autofocus />
                        </div>
                    </div>

                    <!-- Email Field -->
                    <div class="recovery-field">
                        <label class="recovery-label" for="emailId">
                            Registered Email Id <span class="req-star">*</span>
                        </label>
                        <div class="recovery-input-wrap">
                            <i class="fa-solid fa-envelope input-icon"></i>
                            <input type="email"
                                   id="emailId"
                                   name="email"
                                   class="recovery-input"
                                   placeholder="Enter your registered Email Id"
                                   required />
                        </div>
                    </div>

                    <!-- Captcha Field -->
                    <div class="recovery-field">
                        <label class="recovery-label" for="captchaInputStep1">
                            Security Captcha <span class="req-star">*</span>
                        </label>
                        <div class="captcha-grid">
                            <div class="recovery-input-wrap captcha-input-box">
                                <i class="fa-solid fa-shield-cat input-icon"></i>
                                <input type="text"
                                       id="captchaInputStep1"
                                       name="captcha"
                                       class="recovery-input"
                                       placeholder="Enter Captcha"
                                       maxlength="10"
                                       required />
                            </div>
                            <div class="captcha-display-badge">
                                <img src="/captcha" alt="Captcha" class="captcha-image" id="captchaImgStep1" />
                                <button type="button" class="captcha-refresh-btn" onclick="refreshCaptcha('Step1')" title="Refresh Captcha" id="refreshBtnStep1">
                                    <i class="fa-solid fa-arrows-rotate"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Alert message for Step 1 -->
                    <div id="step1ErrorBox" class="recovery-alert alert-error" style="display: none;"></div>

                    <!-- Action Buttons -->
                    <div class="recovery-actions">
                        <a href="/Account/Login" class="btn-recovery btn-outline">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>Back</span>
                        </a>
                        <button type="submit" class="btn-recovery btn-primary" id="btnStep1Next">
                            <span class="btn-text">Next Step <i class="fa-solid fa-arrow-right ms-1"></i></span>
                            <span class="btn-spinner" style="display:none;"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
                        </button>
                    </div>

                    <!-- Note Footer -->
                    <div class="recovery-note-pill">
                        <i class="fa-solid fa-circle-info note-icon"></i>
                        <span><strong>Note:</strong> Please ensure to keep your Email id and Mobile number updated in profile section.</span>
                    </div>

                </form>
            </div>

            <!-- ==============================================
                 STEP 2: OTP VERIFICATION & PASSWORD RESET
                 ============================================== -->
            <div id="step2Container" class="step-container" style="display: none;">
                
                <!-- Success Verification Notice Banner -->
                <div class="verification-notice-card" id="verificationNotice">
                    <div class="notice-icon-box">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="notice-content">
                        <div class="notice-title">Verification Code Sent!</div>
                        <div class="notice-text">
                            Code sent to registered Email <strong id="sentEmailMasked">...</strong> and Mobile <strong id="sentMobileMasked">...</strong>
                        </div>
                    </div>
                </div>

                <form id="step2Form" autocomplete="off" onsubmit="return handleStep2Submit(event)">
                    
                    <!-- Verified Username (Read-Only) -->
                    <div class="recovery-field">
                        <label class="recovery-label" for="verifiedUsername">
                            IRCTC User Name <span class="req-star">*</span>
                        </label>
                        <div class="recovery-input-wrap readonly-wrap">
                            <i class="fa-solid fa-lock input-icon"></i>
                            <input type="text" id="verifiedUsername" class="recovery-input readonly-input" readonly />
                            <span class="readonly-badge"><i class="fa-solid fa-check"></i> Verified</span>
                        </div>
                    </div>

                    <!-- OTP Input with Countdown Timer -->
                    <div class="recovery-field">
                        <div class="field-header-row">
                            <label class="recovery-label mb-0" for="otpInput">
                                Enter 6-Digit OTP <span class="req-star">*</span>
                            </label>
                            <div class="otp-timer-box">
                                <span id="otpTimerText" class="otp-countdown">Resend in <strong id="countdownSec">60</strong>s</span>
                                <button type="button" id="btnResendOtp" class="btn-resend-link" style="display: none;" onclick="resendOtp()">
                                    <i class="fa-solid fa-rotate-right me-1"></i> Resend OTP
                                </button>
                            </div>
                        </div>
                        <div class="recovery-input-wrap">
                            <i class="fa-solid fa-key input-icon"></i>
                            <input type="text"
                                   id="otpInput"
                                   name="otp"
                                   class="recovery-input otp-input-field"
                                   placeholder="Enter 6-digit OTP received"
                                   maxlength="6"
                                   required />
                        </div>
                    </div>

                    <!-- New Password Field -->
                    <div class="recovery-field">
                        <label class="recovery-label" for="newPasswordInput">
                            New Password <span class="req-star">*</span>
                        </label>
                        <div class="recovery-input-wrap">
                            <i class="fa-solid fa-lock input-icon"></i>
                            <input type="password"
                                   id="newPasswordInput"
                                   name="newPassword"
                                   class="recovery-input"
                                   placeholder="Enter new strong password"
                                   required
                                   oninput="validatePasswordStrength()" />
                            <button type="button" class="eye-toggle-btn" onclick="togglePasswordVisibility('newPasswordInput', this)" tabindex="-1" title="Show/Hide Password">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>

                        <!-- Live Strength Indicator Bar -->
                        <div class="strength-meter-wrap">
                            <div class="strength-bar-segments">
                                <div class="strength-segment" id="seg1"></div>
                                <div class="strength-segment" id="seg2"></div>
                                <div class="strength-segment" id="seg3"></div>
                                <div class="strength-segment" id="seg4"></div>
                            </div>
                            <span class="strength-text" id="strengthText">Enter password</span>
                        </div>

                        <!-- Password Rule Checklist Pills -->
                        <div class="password-rules-card">
                            <div class="rule-chip" id="ruleLength">
                                <i class="fa-solid fa-circle-xmark rule-icon"></i>
                                <span>8 to 15 characters</span>
                            </div>
                            <div class="rule-chip" id="ruleCase">
                                <i class="fa-solid fa-circle-xmark rule-icon"></i>
                                <span>Uppercase & Lowercase</span>
                            </div>
                            <div class="rule-chip" id="ruleSpecial">
                                <i class="fa-solid fa-circle-xmark rule-icon"></i>
                                <span>Number & Special symbol</span>
                            </div>
                            <div class="rule-chip" id="ruleSequence">
                                <i class="fa-solid fa-circle-xmark rule-icon"></i>
                                <span>No repeated sequence (123, aaa)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="recovery-field">
                        <label class="recovery-label" for="confirmPasswordInput">
                            Confirm Password <span class="req-star">*</span>
                        </label>
                        <div class="recovery-input-wrap">
                            <i class="fa-solid fa-shield-halved input-icon"></i>
                            <input type="password"
                                   id="confirmPasswordInput"
                                   name="confirmPassword"
                                   class="recovery-input"
                                   placeholder="Re-enter your new password"
                                   required
                                   oninput="validatePasswordMatch()" />
                            <button type="button" class="eye-toggle-btn" onclick="togglePasswordVisibility('confirmPasswordInput', this)" tabindex="-1" title="Show/Hide Password">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <div id="passwordMismatchMsg" class="field-error-msg" style="display: none;">
                            <i class="fa-solid fa-triangle-exclamation"></i> Passwords do not match.
                        </div>
                    </div>

                    <!-- Captcha for Step 2 -->
                    <div class="recovery-field">
                        <label class="recovery-label" for="captchaInputStep2">
                            Security Captcha <span class="req-star">*</span>
                        </label>
                        <div class="captcha-grid">
                            <div class="recovery-input-wrap captcha-input-box">
                                <i class="fa-solid fa-shield-cat input-icon"></i>
                                <input type="text"
                                       id="captchaInputStep2"
                                       name="captcha2"
                                       class="recovery-input"
                                       placeholder="Enter Captcha"
                                       maxlength="10"
                                       required />
                            </div>
                            <div class="captcha-display-badge">
                                <img src="/captcha" alt="Captcha" class="captcha-image" id="captchaImgStep2" />
                                <button type="button" class="captcha-refresh-btn" onclick="refreshCaptcha('Step2')" title="Refresh Captcha" id="refreshBtnStep2">
                                    <i class="fa-solid fa-arrows-rotate"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2 Alerts -->
                    <div id="step2ErrorBox" class="recovery-alert alert-error" style="display: none;"></div>
                    <div id="step2SuccessBox" class="recovery-alert alert-success" style="display: none;"></div>

                    <!-- Action Buttons -->
                    <div class="recovery-actions">
                        <button type="button" class="btn-recovery btn-outline" onclick="goToStep1()">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>Back</span>
                        </button>
                        <button type="submit" class="btn-recovery btn-primary" id="btnUpdatePassword">
                            <span class="btn-text">Update Password <i class="fa-solid fa-check ms-1"></i></span>
                            <span class="btn-spinner" style="display:none;"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
                        </button>
                    </div>

                    <!-- Note Footer -->
                    <div class="recovery-note-pill">
                        <i class="fa-solid fa-circle-info note-icon"></i>
                        <span><strong>Note:</strong> Please ensure to keep your Email id and Mobile number updated in profile section.</span>
                    </div>

                </form>
            </div>

        </div>
    </div>
</section>

<!-- ==============================================
     PREMIUM STYLING & ANIMATIONS
     ============================================== -->
<style>
    /* PAGE CONTAINER & BACKGROUND */
    .recovery-page {
        position: relative;
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 16px;
        background: linear-gradient(135deg, #f0f6ff 0%, #f8fafc 50%, #eef4ff 100%);
        overflow: hidden;
    }

    /* Ambient Floating Glow Orbs */
    .recovery-bg-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        z-index: 0;
    }

    .recovery-bg-glow.glow-1 {
        width: 380px;
        height: 380px;
        top: -80px;
        left: -80px;
        background: rgba(37, 99, 235, 0.12);
        animation: floatOrb 10s ease-in-out infinite alternate;
    }

    .recovery-bg-glow.glow-2 {
        width: 420px;
        height: 420px;
        bottom: -100px;
        right: -100px;
        background: rgba(26, 79, 163, 0.10);
        animation: floatOrb 12s ease-in-out infinite alternate-reverse;
    }

    @@keyframes floatOrb {
        0% { transform: translate(0, 0) scale(1); }
        100% { transform: translate(30px, 30px) scale(1.1); }
    }

    /* CARD WRAPPER */
    .recovery-card-wrapper {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 580px;
    }

    /* CARD CONTAINER */
    .recovery-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 38px 40px;
        box-shadow: 0 20px 48px rgba(13, 34, 64, 0.08), 0 4px 12px rgba(13, 34, 64, 0.03);
        border: 1px solid #e2e8f0;
        transition: box-shadow 0.3s ease;
    }

    /* HEADER & BADGE */
    .recovery-card-header {
        text-align: center;
        margin-bottom: 26px;
    }

    .recovery-brand-badge {
        width: 54px;
        height: 54px;
        margin: 0 auto 14px;
        background: linear-gradient(135deg, #1a4fa3 0%, #2563eb 100%);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 22px;
        box-shadow: 0 8px 22px rgba(37, 99, 235, 0.32);
        animation: badgePop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes badgePop {
        0% { transform: scale(0.6); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }

    .recovery-title {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 22px;
        font-weight: 800;
        color: #0d2240;
        margin: 0 0 6px;
        letter-spacing: 0.3px;
    }

    .recovery-subtitle {
        font-size: 13.5px;
        color: #64748b;
        margin: 0;
        line-height: 1.4;
    }

    /* ==============================================
       ANIMATED 2-STEP PROGRESS STEPPER
       ============================================== */
    .recovery-stepper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 auto 30px;
        max-width: 420px;
        position: relative;
    }

    .stepper-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        z-index: 2;
        min-width: 90px;
    }

    .stepper-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #f1f5f9;
        border: 2px solid #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 700;
        color: #64748b;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .stepper-label {
        font-size: 12.5px;
        font-weight: 600;
        color: #64748b;
        transition: color 0.3s ease;
    }

    /* Active Stepper State */
    .stepper-item.active .stepper-circle {
        background: #2563eb;
        border-color: #2563eb;
        color: #ffffff;
        box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.18);
        animation: pulseStepper 2s infinite;
    }

    .stepper-item.active .stepper-label {
        color: #1a4fa3;
        font-weight: 700;
    }

    /* Completed Stepper State */
    .stepper-item.completed .stepper-circle {
        background: #10b981;
        border-color: #10b981;
        color: #ffffff;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
    }

    .stepper-item.completed .step-num {
        display: none;
    }

    .stepper-item.completed .step-check {
        display: inline-block !important;
    }

    .stepper-item.completed .stepper-label {
        color: #059669;
        font-weight: 600;
    }

    /* Connecting Stepper Line */
    .stepper-line {
        position: absolute;
        top: 19px;
        left: 55px;
        right: 55px;
        height: 3px;
        background: #e2e8f0;
        z-index: 1;
        border-radius: 3px;
        overflow: hidden;
    }

    .stepper-line-progress {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #10b981, #2563eb);
        transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .stepper-line.filled .stepper-line-progress {
        width: 100%;
    }

    @@keyframes pulseStepper {
        0%, 100% { box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.20); }
        50% { box-shadow: 0 0 0 8px rgba(37, 99, 235, 0); }
    }

    /* ==============================================
       FORM FIELDS & INPUTS
       ============================================== */
    .step-container {
        animation: fadeInStep 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @@keyframes fadeInStep {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .recovery-field {
        margin-bottom: 20px;
    }

    .field-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 7px;
    }

    .recovery-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 7px;
    }

    .req-star {
        color: #ef4444;
        font-weight: 700;
    }

    /* Input Wrappers */
    .recovery-input-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .recovery-input-wrap .input-icon {
        position: absolute;
        left: 15px;
        color: #94a3b8;
        font-size: 15px;
        pointer-events: none;
        transition: color 0.2s ease;
    }

    .recovery-input {
        width: 100%;
        height: 46px;
        padding: 0 16px 0 42px;
        border: 1.5px solid #e2e8f0;
        border-radius: 11px;
        background: #ffffff;
        font-size: 14px;
        color: #0f172a;
        outline: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        box-sizing: border-box;
    }

    .recovery-input:focus {
        border-color: #2563eb;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .recovery-input:focus + .input-icon,
    .recovery-input:focus ~ .input-icon,
    .recovery-input-wrap:focus-within .input-icon {
        color: #2563eb;
    }

    .recovery-input::placeholder {
        color: #94a3b8;
        font-size: 13.5px;
    }

    /* Readonly username badge in Step 2 */
    .readonly-wrap .readonly-input {
        background: #f8fafc;
        border-color: #e2e8f0;
        color: #0f172a;
        font-weight: 600;
        cursor: not-allowed;
        padding-right: 95px;
    }

    .readonly-badge {
        position: absolute;
        right: 12px;
        background: #dcfce7;
        color: #166534;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        pointer-events: none;
    }

    /* Password Eye Toggle */
    .eye-toggle-btn {
        position: absolute;
        right: 12px;
        background: transparent;
        border: none;
        color: #64748b;
        font-size: 15px;
        cursor: pointer;
        padding: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: color 0.15s ease, background 0.15s ease;
    }

    .eye-toggle-btn:hover {
        color: #1a4fa3;
        background: #f1f5f9;
    }

    /* OTP Countdown Toolbar */
    .otp-timer-box {
        font-size: 12.5px;
    }

    .otp-countdown {
        color: #64748b;
        font-weight: 500;
    }

    .otp-countdown strong {
        color: #1a4fa3;
    }

    .btn-resend-link {
        background: none;
        border: none;
        color: #2563eb;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        padding: 0;
        text-decoration: underline;
        transition: color 0.15s ease;
    }

    .btn-resend-link:hover {
        color: #1d4ed8;
    }

    /* ==============================================
       CAPTCHA SECTION
       ============================================== */
    .captcha-grid {
        display: grid;
        grid-template-columns: 1fr 160px;
        gap: 12px;
        align-items: center;
    }

    .captcha-display-badge {
        display: flex;
        align-items: center;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 11px;
        padding: 4px 6px;
        height: 46px;
        box-sizing: border-box;
        gap: 6px;
        justify-content: space-between;
    }

    .captcha-image {
        height: 34px;
        width: 100px;
        border-radius: 6px;
        object-fit: cover;
        background: #ffffff;
    }

    .captcha-refresh-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #2563eb;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: all 0.25s ease;
        flex-shrink: 0;
    }

    .captcha-refresh-btn:hover {
        background: #eff6ff;
        border-color: #93c5fd;
        color: #1d4ed8;
        transform: rotate(45deg);
    }

    .captcha-refresh-btn.spinning i {
        animation: spinRefresh 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes spinRefresh {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* ==============================================
       DYNAMIC PASSWORD STRENGTH METER & RULES
       ============================================== */
    .strength-meter-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 8px;
        gap: 12px;
    }

    .strength-bar-segments {
        display: flex;
        gap: 4px;
        flex: 1;
    }

    .strength-segment {
        height: 4px;
        flex: 1;
        background: #e2e8f0;
        border-radius: 2px;
        transition: background-color 0.3s ease;
    }

    .strength-segment.active-weak { background: #ef4444; }
    .strength-segment.active-medium { background: #f59e0b; }
    .strength-segment.active-strong { background: #10b981; }

    .strength-text {
        font-size: 11.5px;
        font-weight: 700;
        color: #94a3b8;
        white-space: nowrap;
        text-transform: capitalize;
    }

    .password-rules-card {
        margin-top: 10px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 12px;
    }

    .rule-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: #64748b;
        transition: color 0.2s ease;
    }

    .rule-chip .rule-icon {
        font-size: 11px;
        color: #94a3b8;
        transition: all 0.2s ease;
    }

    .rule-chip.valid {
        color: #059669;
        font-weight: 600;
    }

    .rule-chip.valid .rule-icon {
        color: #10b981;
    }

    .field-error-msg {
        font-size: 12px;
        color: #dc2626;
        margin-top: 5px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* Verification Notice Card (Step 2) */
    .verification-notice-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #ecfdf5;
        border: 1.5px solid #a7f3d0;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 22px;
        animation: bannerDrop 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes bannerDrop {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .notice-icon-box {
        color: #10b981;
        font-size: 18px;
        margin-top: 1px;
    }

    .notice-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #065f46;
        margin-bottom: 2px;
    }

    .notice-text {
        font-size: 12.5px;
        color: #047857;
        line-height: 1.4;
    }

    .notice-text strong {
        color: #064e3b;
        font-weight: 700;
    }

    /* ==============================================
       ALERT BOXES
       ============================================== */
    .recovery-alert {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13px;
        margin-bottom: 18px;
        line-height: 1.4;
        animation: fadeInStep 0.25s ease;
    }

    .alert-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }

    .alert-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
    }

    /* ==============================================
       BUTTONS & ACTION BAR
       ============================================== */
    .recovery-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 26px;
    }

    .btn-recovery {
        height: 46px;
        border-radius: 11px;
        font-size: 14px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-sizing: border-box;
    }

    .btn-outline {
        padding: 0 20px;
        background: #ffffff;
        border: 1.5px solid #cbd5e1;
        color: #475569;
    }

    .btn-outline:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
        transform: translateY(-1px);
    }

    .btn-primary {
        flex: 1;
        background: linear-gradient(135deg, #1a4fa3 0%, #2563eb 100%);
        border: none;
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.32);
    }

    .btn-primary:hover:not(:disabled) {
        background: linear-gradient(135deg, #16438c 0%, #1d4ed8 100%);
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.42);
        transform: translateY(-2px);
    }

    .btn-primary:disabled {
        opacity: 0.65;
        cursor: not-allowed;
    }

    /* PROFILE NOTE FOOTER */
    .recovery-note-pill {
        margin-top: 22px;
        padding: 10px 14px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 10px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 12px;
        color: #1e40af;
        line-height: 1.4;
    }

    .recovery-note-pill .note-icon {
        margin-top: 2px;
        color: #2563eb;
        flex-shrink: 0;
    }

    /* ==============================================
       DARK MODE SUPPORT
       ============================================== */
    body.dark-mode .recovery-page {
        background: linear-gradient(135deg, #091322 0%, #0d1e38 50%, #0a172c 100%);
    }

    body.dark-mode .recovery-card {
        background: #111e33;
        border-color: #1e3355;
        box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45);
    }

    body.dark-mode .recovery-title {
        color: #f1f5f9;
    }

    body.dark-mode .recovery-subtitle {
        color: #94a3b8;
    }

    body.dark-mode .recovery-label {
        color: #cbd5e1;
    }

    body.dark-mode .recovery-input {
        background: #0d1b30;
        border-color: #1e3355;
        color: #f8fafc;
    }

    body.dark-mode .recovery-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
    }

    body.dark-mode .readonly-wrap .readonly-input {
        background: #0a1628;
        border-color: #1e3355;
        color: #e2e8f0;
    }

    body.dark-mode .captcha-display-badge {
        background: #0d1b30;
        border-color: #1e3355;
    }

    body.dark-mode .captcha-refresh-btn {
        background: #111e33;
        border-color: #1e3355;
        color: #60a5fa;
    }

    body.dark-mode .btn-outline {
        background: #111e33;
        border-color: #1e3355;
        color: #cbd5e1;
    }

    body.dark-mode .password-rules-card {
        background: #0d1b30;
        border-color: #1e3355;
    }

    body.dark-mode .recovery-note-pill {
        background: #0d2240;
        border-color: #1e3a68;
        color: #93c5fd;
    }

    /* RESPONSIVE DESIGN */
    @@media (max-width: 600px) {
        .recovery-card {
            padding: 26px 20px;
            border-radius: 16px;
        }

        .recovery-title {
            font-size: 19px;
        }

        .recovery-stepper {
            max-width: 100%;
        }

        .captcha-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .captcha-display-badge {
            width: 100%;
        }

        .password-rules-card {
            grid-template-columns: 1fr;
        }

        .recovery-actions {
            flex-direction: row;
        }
    }
</style>

<!-- ==============================================
     INTERACTIVE JAVASCRIPT & AJAX LOGIC
     ============================================== -->
<script>
    let countdownInterval;
    let countdownSeconds = 60;
    let currentVerifiedUsername = "";

    // 360-degree animated Captcha refresh
    function refreshCaptcha(step) {
        const btn = document.getElementById("refreshBtn" + step);
        if (btn) {
            btn.classList.add("spinning");
            setTimeout(() => btn.classList.remove("spinning"), 600);
        }

        const timestamp = new Date().getTime();
        const img = document.getElementById("captchaImg" + step);
        if (img) {
            img.style.opacity = "0.5";
            img.src = "/captcha?t=" + timestamp;
            img.onload = () => img.style.opacity = "1";
        }
        const input = document.getElementById("captchaInput" + step);
        if (input) {
            input.value = "";
            input.focus();
        }
    }

    // Toggle password eye visibility
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector("i");
        if (!input) return;

        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }

    // Real-time password strength & criteria validation
    function validatePasswordStrength() {
        const val = document.getElementById("newPasswordInput").value;

        // Criteria 1: Length 8-15
        const isLen = val.length >= 8 && val.length <= 15;
        updateRuleChip("ruleLength", isLen);

        // Criteria 2: Case (Upper and Lower)
        const isCase = /[a-z]/.test(val) && /[A-Z]/.test(val);
        updateRuleChip("ruleCase", isCase);

        // Criteria 3: Digit & Special Character
        const isSpecial = /[0-9]/.test(val) && /[\W_]/.test(val);
        updateRuleChip("ruleSpecial", isSpecial);

        // Criteria 4: No Sequence / Repetition
        const isSequence = /(.)\1{2,}/.test(val) || /123|234|345|456|567|678|789|abc|bcd|cde/i.test(val);
        const noSeq = !isSequence && val.length > 0;
        updateRuleChip("ruleSequence", noSeq);

        // Dynamic 4-Segment Strength Bar
        let score = 0;
        if (isLen) score++;
        if (isCase) score++;
        if (isSpecial) score++;
        if (noSeq) score++;

        const seg1 = document.getElementById("seg1");
        const seg2 = document.getElementById("seg2");
        const seg3 = document.getElementById("seg3");
        const seg4 = document.getElementById("seg4");
        const strengthLabel = document.getElementById("strengthText");

        [seg1, seg2, seg3, seg4].forEach(s => {
            s.className = "strength-segment";
        });

        if (val.length === 0) {
            strengthLabel.innerText = "Enter password";
            strengthLabel.style.color = "#94a3b8";
        } else if (score <= 1) {
            seg1.classList.add("active-weak");
            strengthLabel.innerText = "Weak";
            strengthLabel.style.color = "#ef4444";
        } else if (score === 2 || score === 3) {
            seg1.classList.add("active-medium");
            seg2.classList.add("active-medium");
            if (score === 3) seg3.classList.add("active-medium");
            strengthLabel.innerText = "Moderate";
            strengthLabel.style.color = "#f59e0b";
        } else {
            seg1.classList.add("active-strong");
            seg2.classList.add("active-strong");
            seg3.classList.add("active-strong");
            seg4.classList.add("active-strong");
            strengthLabel.innerText = "Strong";
            strengthLabel.style.color = "#10b981";
        }

        validatePasswordMatch();
    }

    function updateRuleChip(ruleId, isValid) {
        const el = document.getElementById(ruleId);
        if (!el) return;
        const icon = el.querySelector(".rule-icon");
        if (isValid) {
            el.classList.add("valid");
            if (icon) {
                icon.classList.remove("fa-circle-xmark");
                icon.classList.add("fa-circle-check");
            }
        } else {
            el.classList.remove("valid");
            if (icon) {
                icon.classList.remove("fa-circle-check");
                icon.classList.add("fa-circle-xmark");
            }
        }
    }

    function validatePasswordMatch() {
        const p1 = document.getElementById("newPasswordInput").value;
        const p2 = document.getElementById("confirmPasswordInput").value;
        const msg = document.getElementById("passwordMismatchMsg");
        if (!msg) return;

        if (p2.length > 0 && p1 !== p2) {
            msg.style.display = "flex";
        } else {
            msg.style.display = "none";
        }
    }

    // OTP Countdown Timer
    function startOtpCountdown() {
        clearInterval(countdownInterval);
        countdownSeconds = 60;
        document.getElementById("countdownSec").innerText = countdownSeconds;
        document.getElementById("otpTimerText").style.display = "inline";
        document.getElementById("btnResendOtp").style.display = "none";

        countdownInterval = setInterval(() => {
            countdownSeconds--;
            document.getElementById("countdownSec").innerText = countdownSeconds;
            if (countdownSeconds <= 0) {
                clearInterval(countdownInterval);
                document.getElementById("otpTimerText").style.display = "none";
                document.getElementById("btnResendOtp").style.display = "inline-flex";
            }
        }, 1000);
    }

    // Step 1: Submit Identity Verification & Send OTP
    async function handleStep1Submit(e) {
        e.preventDefault();
        const errBox = document.getElementById("step1ErrorBox");
        errBox.style.display = "none";

        const username = document.getElementById("irctcUsername").value.trim();
        const email = document.getElementById("emailId").value.trim();
        const captcha = document.getElementById("captchaInputStep1").value.trim();

        if (!username || !email || !captcha) {
            errBox.innerText = "Please fill in all required fields.";
            errBox.style.display = "block";
            return false;
        }

        const btnNext = document.getElementById("btnStep1Next");
        const btnText = btnNext.querySelector(".btn-text");
        const btnSpinner = btnNext.querySelector(".btn-spinner");

        btnNext.disabled = true;
        btnText.style.display = "none";
        btnSpinner.style.display = "inline-block";

        try {
            const resp = await fetch("/Account/ForgotPasswordVerify", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ username, email, captcha })
            });

            const result = await resp.json();

            if (result.success) {
                currentVerifiedUsername = result.username || username;
                document.getElementById("verifiedUsername").value = currentVerifiedUsername;
                document.getElementById("sentEmailMasked").innerText = result.maskedEmail || email;
                document.getElementById("sentMobileMasked").innerText = result.maskedMobile || "";

                // Animate Stepper to Step 2
                document.getElementById("stepperNode1").classList.remove("active");
                document.getElementById("stepperNode1").classList.add("completed");
                document.getElementById("stepperLine").classList.add("filled");
                document.getElementById("stepperNode2").classList.add("active");
                document.getElementById("recoverySubtitle").innerText = "Enter the verification code and set your new password";

                // Switch Containers with smooth fade
                document.getElementById("step1Container").style.display = "none";
                document.getElementById("step2Container").style.display = "block";

                refreshCaptcha("Step2");
                startOtpCountdown();

                document.getElementById("otpInput").value = "";
                document.getElementById("otpInput").focus();
            } else {
                errBox.innerText = result.message || "Account verification failed. Please check your credentials.";
                errBox.style.display = "block";
                refreshCaptcha("Step1");
            }
        } catch (err) {
            errBox.innerText = "An error occurred while connecting to the server. Please try again.";
            errBox.style.display = "block";
            refreshCaptcha("Step1");
        } finally {
            btnNext.disabled = false;
            btnText.style.display = "inline-block";
            btnSpinner.style.display = "none";
        }

        return false;
    }

    // Go Back to Step 1
    function goToStep1() {
        clearInterval(countdownInterval);

        // Reset Stepper
        document.getElementById("stepperNode2").classList.remove("active");
        document.getElementById("stepperLine").classList.remove("filled");
        document.getElementById("stepperNode1").classList.remove("completed");
        document.getElementById("stepperNode1").classList.add("active");
        document.getElementById("recoverySubtitle").innerText = "Verify your registered credentials to reset your password";

        document.getElementById("step2Container").style.display = "none";
        document.getElementById("step1Container").style.display = "block";
        refreshCaptcha("Step1");
    }

    // Resend OTP via AJAX
    async function resendOtp() {
        const btnResend = document.getElementById("btnResendOtp");
        btnResend.disabled = true;
        btnResend.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Sending...';

        try {
            const resp = await fetch("/Account/ForgotPasswordResendOtp", {
                method: "POST",
                headers: { "Content-Type": "application/json" }
            });

            const result = await resp.json();

            if (result.success) {
                startOtpCountdown();
                if (window.showToast) {
                    showToast("A new verification code has been dispatched to your email", "success");
                }
            } else {
                alert(result.message || "Failed to resend OTP.");
                document.getElementById("btnResendOtp").style.display = "inline-flex";
            }
        } catch (err) {
            alert("Error resending OTP. Please try again.");
            document.getElementById("btnResendOtp").style.display = "inline-flex";
        } finally {
            btnResend.disabled = false;
            btnResend.innerHTML = '<i class="fa-solid fa-rotate-right me-1"></i> Resend OTP';
        }
    }

    // Step 2: Submit OTP & Reset Password
    async function handleStep2Submit(e) {
        e.preventDefault();
        const errBox = document.getElementById("step2ErrorBox");
        const succBox = document.getElementById("step2SuccessBox");
        errBox.style.display = "none";
        succBox.style.display = "none";

        const otp = document.getElementById("otpInput").value.trim();
        const newPassword = document.getElementById("newPasswordInput").value;
        const confirmPassword = document.getElementById("confirmPasswordInput").value;
        const captcha = document.getElementById("captchaInputStep2").value.trim();

        if (!otp || !newPassword || !confirmPassword || !captcha) {
            errBox.innerText = "Please fill in all required fields.";
            errBox.style.display = "block";
            return false;
        }

        if (newPassword !== confirmPassword) {
            errBox.innerText = "New Password and Confirm Password do not match.";
            errBox.style.display = "block";
            return false;
        }

        if (newPassword.length < 8 || newPassword.length > 15) {
            errBox.innerText = "Password must be between 8 and 15 characters.";
            errBox.style.display = "block";
            return false;
        }

        const btnSubmit = document.getElementById("btnUpdatePassword");
        const btnText = btnSubmit.querySelector(".btn-text");
        const btnSpinner = btnSubmit.querySelector(".btn-spinner");

        btnSubmit.disabled = true;
        btnText.style.display = "none";
        btnSpinner.style.display = "inline-block";

        try {
            const resp = await fetch("/Account/ForgotPasswordReset", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    username: currentVerifiedUsername,
                    otp,
                    newPassword,
                    confirmPassword,
                    captcha
                })
            });

            const result = await resp.json();

            if (result.success) {
                succBox.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i> ' + (result.message || "Password updated successfully! Redirecting to login...");
                succBox.style.display = "block";

                setTimeout(() => {
                    window.location.href = result.redirectUrl || "/Account/Login";
                }, 2000);
            } else {
                errBox.innerText = result.message || "Failed to update password.";
                errBox.style.display = "block";
                refreshCaptcha("Step2");
            }
        } catch (err) {
            errBox.innerText = "An error occurred while connecting to the server. Please try again.";
            errBox.style.display = "block";
            refreshCaptcha("Step2");
        } finally {
            btnSubmit.disabled = false;
            btnText.style.display = "inline-block";
            btnSpinner.style.display = "none";
        }

        return false;
    }
</script>
