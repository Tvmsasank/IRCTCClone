@using IRCTCClone.E_D

@{
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>
@*     <div class="container card-body align-content-center">
 *@  
<section class="page-centered-password">


 <div class="forgot-card">
        <h2>Forgot Password</h2>

            <form id="forgotForm">

                <div class="form-group-body">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control" placeholder="Enter your registered email" required />
                </div>

                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" name="newPassword"
                           class="form-control"
                           placeholder="Enter your new password" />
                </div>

                    <!-- Hidden initially -->
                    <input type="text" name="enteredOTP" id="otpField"
                           class="form-control mb-2"
                           placeholder="Enter OTP"
                           style="display:none;" />

                    <div id="otpSection" style="display:none;">

                        <input type="text" name="enteredOTP" id="otpField"
                               class="form-control mb-2"
                               placeholder="Enter OTP" />

                        <div class="d-flex justify-content-between align-items-center">

                            <span id="otpTimer" style="font-size:13px; color:#555;">
                                OTP expires in 60s
                            </span>

                            <button type="button" id="resendOtpBtn"
                                    class="btn btn-link p-0"
                                    style="display:none;">
                                Resend OTP
                            </button>

                        </div>
                    </div>

                    <button type="button" id="submitBtn"
                            class="btn btn-primary w-100">
                        Submit
                    </button>
    
            </form>

        @if (ViewBag.Error != null)
        {
            <p class="message text-danger">@ViewBag.Error</p>
        }

        @if (ViewBag.Message != null)
        {
            <p class="message text-success">@ViewBag.Message</p>
        }

        <a href="/Account/Login" class="back-link fgbl">← Back to Login</a>
    </div>
    </section>

</body>
</html>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    let otpStep = false;
    let timerInterval;
    let timeLeft = 60;

    function startOtpTimer() {

        timeLeft = 60;
        $("#otpTimer").text("OTP expires in 60s");
        $("#resendOtpBtn").hide();

        timerInterval = setInterval(function () {

            timeLeft--;

            $("#otpTimer").text("OTP expires in " + timeLeft + "s");

            if (timeLeft <= 0) {
                clearInterval(timerInterval);

                $("#otpTimer").text("OTP expired");
                $("#resendOtpBtn").show();
            }

        }, 1000);
    }

    function sendOtp(email) {

        showLoader();

        $.post('/Account/ForgotPassword', {
            email: email,
            enteredOTP: "",
            newPassword: ""
        })

        .done(function (res) {

            if (res.success && res.step === "OTP_SENT") {

                $("#otpSection").show();
                $("#otpField").focus(); // 🎯 AUTO FOCUS

                otpStep = true;

                $("#submitBtn")
                    .text("Verify & Update Password")
                    .prop("disabled", false);

                startOtpTimer();

                showToast("OTP sent to your email");
            }
            else {
                showToast(res.message);
                $("#submitBtn").prop("disabled", false);
            }

        })

        .fail(function () {
            showToast("Something went wrong");
            $("#submitBtn").prop("disabled", false);
        })

        .always(function () {
            hideLoader();
        });
    }

    // 🔁 RESEND OTP
    $("#resendOtpBtn").click(function () {

        var email = $("input[name='email']").val();

        sendOtp(email);
    });

    // 🔘 MAIN BUTTON
    $("#submitBtn").click(function () {

        var email = $("input[name='email']").val();
        var password = $("input[name='newPassword']").val();
        var otp = $("#otpField").val().trim();

        $("#submitBtn").prop("disabled", true);

        // STEP 1 → SEND OTP
        if (!otpStep) {

            sendOtp(email);
        }

        // STEP 2 → VERIFY + RESET
        else {

            showLoader();

            $.post('/Account/ForgotPassword', {
                email: email,
                enteredOTP: otp,
                newPassword: password
            })

            .done(function (res) {

                if (res.success) {
                    showToast("Password updated successfully!");
                    window.location.href = "/Account/Login";
                }
                else {
                    showToast(res.message);
                    $("#submitBtn").prop("disabled", false);
                }

            })

            .fail(function () {
                showToast("Something went wrong");
                $("#submitBtn").prop("disabled", false);
            })

            .always(function () {
                hideLoader();
            });
        }
    });

</script>
