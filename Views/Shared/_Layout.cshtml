@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - IRCTC Clone</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/irctc_Logo.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    @if (User.Identity.IsAuthenticated)
    {
        var logoutUrl = User.IsInRole("Admin") ? "/Admin/Logout" : "/Account/Logout";
        <script>
            function safeReload() {
                sessionStorage.setItem("backButtonReload", "true");
                window.location.reload();
            }

            if (performance.getEntriesByType("navigation")[0]?.type === "reload") {
                if (sessionStorage.getItem("backButtonReload") === "true") {
                    sessionStorage.removeItem("backButtonReload");
                } else {
                    window.location.href = "@logoutUrl";
                }
            }
        </script>
    }
    else
    {
        <script>
            function safeReload() {
                window.location.reload();
            }
        </script>
    }
</head>
<body>
    @using Microsoft.AspNetCore.Http
    @inject IHttpContextAccessor HttpContextAccessor

    <div id="toastContainer"></div>

    <!-- UPPER UTILITY BAR -->
    <div class="header-utility-bar">
        <div class="utility-container">
            <div class="utility-left">
                <span class="live-datetime" id="currentDateTime"><i class="fa-regular fa-clock"></i> --/--/---- [--:--:--]</span>
            </div>
            <div class="utility-right">
                <!-- Font Controls -->
                <div class="font-controls">
                    <button class="font-btn" onclick="changeFontSize(-1)" title="Decrease Font Size">A-</button>
                    <button class="font-btn" onclick="resetFontSize()" title="Reset Font Size">A</button>
                    <button class="font-btn" onclick="changeFontSize(1)" title="Increase Font Size">A+</button>
                </div>
                
                <!-- Language Selector -->
                <div class="lang-selector">
                    <span class="lang-option active">English</span>
                    <span class="lang-divider">|</span>
                    <span class="lang-option">हिंदी</span>
                </div>

                <!-- Theme Toggle -->
                <button id="themeToggle" class="utility-theme-toggle" title="Toggle Theme">
                    <span class="light-icon">☀️</span>
                    <span class="dark-icon">🌙</span>
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN HEADER -->
    <header class="site-header">
        <div class="header-container">

            <!-- LEFT LOGO -->
            <div class="logo-section">
                <img src="~/images/irctc_logo.png" alt="IRCTC Logo" class="logo" />
                <div class="brand-text">
                    <span class="brand-name">IRCTC Clone</span>
                    <span class="brand-subname">NexusRail Portal</span>
                </div>
            </div>

            <!-- HAMBURGER BUTTON (mobile only) -->
            <div class="hamburger" id="hamburgerBtn">
                <span></span>
                <span></span>
                <span></span>
            </div>

            @if (controller != "Error")
            {
                <!-- CENTER NAVIGATION -->
                <nav id="navMenu" class="nav-links">
                    
                    <!-- HOME -->
                    <a href="/" class="nav-item-link"><i class="fa-solid fa-house"></i> Home</a>

                    <!-- DYNAMIC USER SECTION / LOGIN -->
                    @{
                        var adminUser = HttpContextAccessor.HttpContext.Session.GetString("AdminUser");
                    }

                    @if (!string.IsNullOrEmpty(adminUser))
                    {
                        <!-- Admin Dropdown -->
                        <div class="nav-dropdown">
                            <a href="#" class="nav-item-link dropdown-toggle"><i class="fa-solid fa-user-shield"></i> Admin Panel <i class="fa-solid fa-chevron-down"></i></a>
                            <div class="nav-dropdown-menu">
                                <a asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                                <a href="#" onclick="confirmLogout()"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                            </div>
                        </div>
                    }
                    else if (User?.Identity?.IsAuthenticated == true)
                    {
                        <!-- Logged In User Dropdown Matching IRCTC Beta Design -->
                        <div class="nav-dropdown user-profile-dropdown">
                            <a href="#" class="nav-user-pill dropdown-toggle">
                                <i class="fa-regular fa-user user-pill-icon"></i>
                                <span class="user-pill-name">@(User.Identity.Name?.Split('@')[0] ?? User.Identity.Name)</span>
                                <i class="fa-solid fa-circle-check user-pill-verified"></i>
                            </a>
                            <div class="nav-dropdown-menu user-menu-dropdown">
                                <a href="/Profile"><i class="fa-regular fa-user"></i> My Profile</a>
                                
                                <div class="dropdown-divider-line"></div>
                                <div class="dropdown-submenu-heading"><i class="fa-solid fa-globe"></i> My Transactions</div>
                                <a href="/Booking/History" class="submenu-item"><i class="fa-solid fa-clock-rotate-left"></i> Booked Ticket History</a>
                                <a href="/Home/Meals" class="submenu-item"><i class="fa-solid fa-utensils"></i> Booked Food History - E-Pantry</a>
                                <a href="/Booking/History" class="submenu-item"><i class="fa-solid fa-receipt"></i> Transaction History</a>
                                <a href="/Booking/History" class="submenu-item"><i class="fa-regular fa-folder-open"></i> File TDR</a>
                                <a href="/Booking/History" class="submenu-item"><i class="fa-solid fa-file-invoice"></i> TAX Invoice</a>
                                
                                <div class="dropdown-divider-line"></div>
                                <a href="/Home/Contact"><i class="fa-regular fa-star"></i> Feedback</a>
                                
                                <form method="get" action="/Account/Logout" style="display:block; margin:0;">
                                    <button type="submit" class="dropdown-btn-logout">
                                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Login / Register combined button -->
                        <div class="nav-auth-buttons">
                            @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") != "Production")
                            {
                                <a asp-controller="Admin" asp-action="AdminLogin" class="admin-login-btn"><i class="fa-solid fa-user-tie"></i> Admin</a>
                            }
                            <a asp-controller="Account" asp-action="Login" class="nav-btn-login-register"><i class="fa-solid fa-right-from-bracket"></i> LOGIN / REGISTER</a>
                        </div>
                    }

                    <!-- TRAINS DROPDOWN -->
                    <div class="nav-dropdown">
                        <a href="#" class="nav-item-link dropdown-toggle" data-translate="trains">TRAINS <i class="fa-solid fa-chevron-down"></i></a>
                        <div class="nav-dropdown-menu">
                            <a href="/"><i class="fa-solid fa-ticket-simple"></i> Book Ticket</a>
                            <a href="/?quota=FOREIGN_TOURIST"><i class="fa-solid fa-passport"></i> Foreign Tourist Booking</a>
                            <a href="javascript:void(0)" onclick="openNavModal('connectingJourney')"><i class="fa-solid fa-circle-nodes"></i> Connecting Journey Booking</a>
                            <a href="/Booking/History"><i class="fa-solid fa-circle-xmark"></i> Cancel E-Ticket</a>
                            <a asp-controller="Booking" asp-action="CheckPNR"><i class="fa-solid fa-magnifying-glass"></i> PNR Enquiry</a>
                            <a href="javascript:void(0)" onclick="openNavModal('trainSchedule')"><i class="fa-solid fa-calendar-days"></i> Train Schedule</a>
                            <a href="javascript:void(0)" onclick="openNavModal('trackTrain')"><i class="fa-solid fa-location-crosshairs"></i> Track Your Train</a>
                            <a href="javascript:void(0)" onclick="openNavModal('ftrBooking')"><i class="fa-solid fa-train-subway"></i> FTR Coach/Train Booking</a>
                            <a href="javascript:void(0)" onclick="openNavModal('petBooking')"><i class="fa-solid fa-paw"></i> Dogs/Cats Booking</a>
                            <a href="javascript:void(0)" onclick="openNavModal('linkAadhaar')"><i class="fa-solid fa-id-card"></i> Link Your Aadhaar</a>
                            <a href="javascript:void(0)" onclick="openNavModal('counterCancel')"><i class="fa-solid fa-trash-can"></i> Counter Ticket Cancellation</a>
                            <a href="javascript:void(0)" onclick="openNavModal('counterBoarding')"><i class="fa-solid fa-arrows-spin"></i> Counter Boarding Point Change</a>
                        </div>
                    </div>

                    <!-- MEALS DROPDOWN -->
                    <div class="nav-dropdown">
                        <a href="#" class="nav-item-link dropdown-toggle" data-translate="meals">MEALS <i class="fa-solid fa-chevron-down"></i></a>
                        <div class="nav-dropdown-menu">
                            <a href="javascript:void(0)" onclick="openNavModal('ePantry')"><i class="fa-solid fa-utensils"></i> Book Food - E-Pantry</a>
                            <a href="javascript:void(0)" onclick="openNavModal('eCatering')"><i class="fa-solid fa-bowl-food"></i> Order Food - E-Catering</a>
                            <a href="javascript:void(0)" onclick="openNavModal('foodMenu')"><i class="fa-solid fa-square-poll-horizontal"></i> Cooked Food Menu</a>
                        </div>
                    </div>

                    <!-- LOYALTY DROPDOWN -->
                    <div class="nav-dropdown">
                        <a href="#" class="nav-item-link dropdown-toggle" data-translate="loyalty">LOYALTY <i class="fa-solid fa-chevron-down"></i></a>
                        <div class="nav-dropdown-menu">
                            <a href="javascript:void(0)" onclick="openNavModal('cashbackInfo')"><i class="fa-solid fa-percent"></i> Upto 10% Cashback</a>
                            <a href="javascript:void(0)" onclick="openNavModal('loyaltyInfo')"><i class="fa-solid fa-award"></i> Loyalty Program Info</a>
                            <a href="javascript:void(0)" onclick="openNavModal('cardRegistration')"><i class="fa-solid fa-credit-card"></i> Co-branded Card Registration</a>
                        </div>
                    </div>

                    <!-- E-WALLET DROPDOWN -->
                    <div class="nav-dropdown">
                        <a href="#" class="nav-item-link dropdown-toggle" data-translate="ewallet">E-WALLET <i class="fa-solid fa-chevron-down"></i></a>
                        <div class="nav-dropdown-menu">
                            <a href="javascript:void(0)" onclick="openNavModal('ewalletAbout')"><i class="fa-solid fa-wallet"></i> About IRCTC eWallet</a>
                            <a href="javascript:void(0)" onclick="openNavModal('ewalletGuide')"><i class="fa-solid fa-circle-info"></i> IRCTC eWallet User Guide</a>
                        </div>
                    </div>

                    <!-- ALERTS -->
                    <a href="javascript:void(0)" onclick="openNavModal('alerts')" class="nav-item-link" data-translate="alerts">ALERTS</a>

                    <!-- OTHER SERVICES DROPDOWN -->
                    <div class="nav-dropdown">
                        <a href="#" class="nav-item-link dropdown-toggle" data-translate="otherservices">OTHER SERVICES <i class="fa-solid fa-chevron-down"></i></a>
                        <div class="nav-dropdown-menu">
                            <a href="javascript:void(0)" onclick="openNavModal('ipay')"><i class="fa-solid fa-money-bill-transfer"></i> IRCTC-IPAY</a>
                            <a href="javascript:void(0)" onclick="openNavModal('buses')"><i class="fa-solid fa-bus"></i> Buses</a>
                            <a href="javascript:void(0)" onclick="openNavModal('flights')"><i class="fa-solid fa-plane"></i> Flights</a>
                            <a href="javascript:void(0)" onclick="openNavModal('hotels')"><i class="fa-solid fa-hotel"></i> Hotels</a>
                            <a href="javascript:void(0)" onclick="openNavModal('holidays')"><i class="fa-solid fa-umbrella-beach"></i> Holidays</a>
                            <a href="javascript:void(0)" onclick="openNavModal('wheelchair')"><i class="fa-solid fa-wheelchair"></i> e-Wheelchair</a>
                            <a href="javascript:void(0)" onclick="openNavModal('promotions')"><i class="fa-solid fa-bullhorn"></i> Promotions</a>
                        </div>
                    </div>

                    <!-- CONTACT US -->
                    <a href="javascript:void(0)" onclick="openNavModal('contactUs')" class="nav-item-link" data-translate="contactus">CONTACT US</a>

                </nav>
            }

            <!-- RIGHT LOGO -->
            <div class="nostalgiclogo">
                <img src="~/images/nostalgicirctclogo2.png" alt="IRCTC Logo" class="nostlogo" />
            </div>
        </div>
    </header>

    <main role="main" class="main-content flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        © 2026 IRCTC Clone — All Rights Reserved
    </footer>

    <script>
        // Prevent going back to secured pages
        window.history.pushState(null, "", window.location.href);
        window.onpopstate = function () {
            window.history.pushState(null, "", window.location.href);
        };
    </script>

