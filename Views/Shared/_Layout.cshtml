                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card p-3 h-100 text-center bg-light border-0 shadow-sm">
                                        <i class="fa-solid fa-envelope text-success fs-1 mb-2"></i>
                                        <h5 class="fw-bold">Email Support</h5>
                                        <h6 class="fw-bold">care@irctc.co.in</h6>
                                        <p class="text-muted small">Send ticket booking, refund, or technical assistance emails.</p>
                                    </div>
                                </div>
                            </div>
                        </div>`;
                    break;
            }

            titleEl.innerHTML = title;
            bodyEl.innerHTML = content;
            modal.style.display = "flex";
        }

        function closeNavModal() {
            if (typeof hideLoader === 'function') hideLoader();
            const modal = document.getElementById("irctcNavModal");
            if (modal) modal.style.display = "none";
        }

        function searchNavSchedule() {
            const val = document.getElementById("scheduleTrainInput")?.value?.trim();
            if (!val) {
                Swal.fire('Input Required', 'Please enter a valid Train Number or Name', 'warning');
                return;
            }
            Swal.fire('Schedule Found', 'Displaying active schedule for train: ' + val, 'success');
        }
    </script>

</body>
</html>


