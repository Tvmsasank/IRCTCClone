    <script>
        let currentSize = 1;

        window.changeFontSize = function (step) {
            currentSize += step * 0.1;
            document.documentElement.style.setProperty('--base-scale', currentSize);
        };

        window.resetFontSize = function () {
            currentSize = 1;
            document.documentElement.style.setProperty('--base-scale', 1);
        };

        function updateDateTime() {
            const now = new Date();
            const day = String(now.getDate()).padStart(2, '0');
            const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            const month = months[now.getMonth()];
            const year = now.getFullYear();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            
            const formatted = `${day} ${month} ${year} [${hours}:${minutes}:${seconds}]`;

            const el = document.getElementById("currentDateTime");
            if (el) el.innerText = formatted;
        }

        setInterval(updateDateTime, 1000);
        updateDateTime();

        // Dynamic Language Translation Logic
        const translations = {
            "en": {
                "home": "Home",
                "trains": "TRAINS",
                "meals": "MEALS",
                "loyalty": "LOYALTY",
                "ewallet": "E-WALLET",
                "alerts": "ALERTS",
                "otherservices": "OTHER SERVICES",
                "contactus": "CONTACT US",
                "bookticket": "BOOK TICKET",
                "from": "From*",
                "from_placeholder": "Enter source station",
                "to": "To*",
                "to_placeholder": "Enter destination station",
                "date": "DD/MM/YYYY *",
                "date_placeholder": "Select Journey Date",
                "classes": "Classes",
                "quota": "Quota",
                "searchtrains": "Search Trains",
                "searchmemu": "🔍 Search MEMU/DEMU/MMTS Trains",
                "checkpnr": "🔍 Check PNR Status",
                "chartvacancy": "Chart Vacancy"
            },
            "hi": {
                "home": "होम",
                "trains": "ट्रेनें",
                "meals": "भोजन",
                "loyalty": "वफादारी",
                "ewallet": "ई-वॉलेट",
                "alerts": "अलर्ट",
                "otherservices": "अन्य सेवाएं",
                "contactus": "संपर्क करें",
                "bookticket": "टिकट बुक करें",
                "from": "से*",
                "from_placeholder": "स्रोत स्टेशन दर्ज करें",
                "to": "तक*",
                "to_placeholder": "गंतव्य स्टेशन दर्ज करें",
                "date": "दिनांक *",
                "date_placeholder": "यात्रा की तारीख चुनें",
                "classes": "श्रेणी",
                "quota": "कोटा",
                "searchtrains": "ट्रेनें खोजें",
                "searchmemu": "🔍 मेमू/डेमू/एमएमटीएस ट्रेनें खोजें",
                "checkpnr": "🔍 पीएनआर स्थिति जांचें",
                "chartvacancy": "चार्ट रिक्ति"
            }
        };

        function applyTranslation(lang) {
            document.querySelectorAll('.lang-option').forEach(o => {
                const optText = o.innerText.trim();
                if ((optText === 'English' && lang === 'en') || (optText === 'हिंदी' && lang === 'hi')) {
                    o.classList.add('active');
                } else {
                    o.classList.remove('active');
                }
            });

            document.querySelectorAll('[data-translate]').forEach(el => {
                const key = el.getAttribute('data-translate');
                if (translations[lang] && translations[lang][key]) {
                    const icon = el.querySelector('i');
                    if (icon) {
                        el.innerHTML = '';
                        el.appendChild(icon);
                        el.appendChild(document.createTextNode(' ' + translations[lang][key]));
                        if (el.classList.contains('dropdown-toggle') && key !== 'home') {
                            const chevron = document.createElement('i');
                            chevron.className = 'fa-solid fa-chevron-down';
                            chevron.style.marginLeft = '4px';
                            el.appendChild(chevron);
                        }
                    } else {
                        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                            el.setAttribute('placeholder', translations[lang][key]);
                        } else {
                            el.innerText = translations[lang][key];
                            if (el.classList.contains('dropdown-toggle')) {
                                const chevron = document.createElement('i');
                                chevron.className = 'fa-solid fa-chevron-down';
                                chevron.style.marginLeft = '4px';
                                el.appendChild(chevron);
                            }
                        }
                    }
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            const savedLang = localStorage.getItem("lang") || "en";
            applyTranslation(savedLang);

            document.querySelectorAll('.lang-option').forEach(option => {
                option.addEventListener('click', function() {
                    const lang = this.innerText.trim() === 'English' ? 'en' : 'hi';
                    localStorage.setItem("lang", lang);
                    applyTranslation(lang);
                });
            });
        });
    </script>

    <div id="globalLoader" class="loading-modal">
        <div class="loading-box">
            <div class="loader"></div>
            <div class="loading-text">Please wait...</div>
        </div>
    </div>

    <script>
        function confirmLogout() {
            if (confirm("Are you sure you want to log out from Admin Panel?")) {
                window.location.href = "/Admin/Logout";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {

            const btn = document.getElementById("hamburgerBtn");
            const menu = document.getElementById("navMenu");

            if (btn && menu) {
                btn.addEventListener("click", function () {
                    menu.classList.toggle("show");
                    btn.classList.toggle("active");
                });
            }

            // Accordion toggle for dropdown menus on mobile viewports
            document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
                toggle.addEventListener('click', function(e) {
                    if (window.innerWidth < 992) {
                        e.preventDefault();
                        const parent = this.parentElement;
                        parent.classList.toggle('active');
                    }
                });
            });

        });
    </script>

    <script>
        const themeToggle = document.getElementById("themeToggle");

        // LOAD SAVED THEME
        if (localStorage.getItem("theme") === "dark") {
            document.body.classList.add("dark-mode");
        }

        // TOGGLE THEME
        themeToggle?.addEventListener("click", () => {
            document.body.classList.toggle("dark-mode");
            if (document.body.classList.contains("dark-mode")) {
                localStorage.setItem("theme", "dark");
            } else {
                localStorage.setItem("theme", "light");
            }
        });
    </script>

