            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h4 id="irctcNavModalTitle" class="m-0 text-primary fw-bold" style="color:#1d3ca5 !important;">Modal Title</h4>
                <span onclick="closeNavModal()" style="cursor:pointer; font-size: 24px; font-weight: bold; color: #888;">&times;</span>
            </div>
            <div id="irctcNavModalBody"></div>
        </div>
    </div>

    <script>
        function openNavModal(key) {
            if (typeof hideLoader === 'function') hideLoader();
            const modal = document.getElementById("irctcNavModal");
            const titleEl = document.getElementById("irctcNavModalTitle");
            const bodyEl = document.getElementById("irctcNavModalBody");
            if (!modal || !titleEl || !bodyEl) return;

            let title = "";
            let content = "";

            switch(key) {
                case 'connectingJourney':
                    title = "🚆 Connecting Journey Booking";
                    content = `
                        <div class="p-2">
                            <p class="lead text-muted" style="font-size:14px;">Book multi-leg connecting train journeys seamlessly across stations with automatic connection window validation.</p>
                            <form onsubmit="event.preventDefault(); Swal.fire('Connecting Search', 'Searching available connecting trains between selected stations...', 'info');">
                                <div class="row g-3">
                                    <div class="col-md-5">
                                        <label class="form-label fw-bold">Origin Station</label>
                                        <input type="text" class="form-control" placeholder="e.g. NDLS - New Delhi" required>
                                    </div>
                                    <div class="col-md-2 text-center align-self-end pb-1">
                                        <span class="badge bg-primary fs-5" style="padding: 8px 12px;">⇄</span>
                                    </div>
